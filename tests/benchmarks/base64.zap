# base64: n generated bytes encoded and decoded back; prints the encoded size, its byte sum and
# whether the round trip is exact.
import problems

alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

fn generate(n i64):
	x u32 = 42
	(0..n).map(_:
		x = x * 1_103_515_245 + 12_345
		u8.wrap(x >> 16)
	)

fn encode(data u8[]):
	n = data.len
	whole = n / 3
	out u8[] = zeros((n + 2) / 3 * 4)
	for g in 0..whole:
		v = u32(data[g * 3]) << 16 | u32(data[g * 3 + 1]) << 8 | data[g * 3 + 2]
		out[g * 4] = alphabet[v >> 18]
		out[g * 4 + 1] = alphabet[v >> 12 & 63]
		out[g * 4 + 2] = alphabet[v >> 6 & 63]
		out[g * 4 + 3] = alphabet[v & 63]
	left = n - whole * 3
	if left > 0:
		at = whole * 4
		v = u32(data[whole * 3]) << 16
		if left == 2:
			v |= u32(data[whole * 3 + 1]) << 8
		out[at] = alphabet[v >> 18]
		out[at + 1] = alphabet[v >> 12 & 63]
		out[at + 2] = alphabet[v >> 6 & 63] if left == 2 else '='
		out[at + 3] = '='
	out

# the bytes of a base64 text, or none when a character is not of the alphabet (or a padding
# '=' is not at the end)
fn decode(text u8[]) u8[]?:
	values u8[] = fill(256, 255)
	for i in 0..alphabet.len:
		values[i64(alphabet[i])] = u8(i)
	values['='] = 0   # padding decodes as zero bits, cut off below
	padding = text[(len - 2).max(0)..].count(it == '=')
	groups = text.len / 4
	out u8[] = zeros(groups * 3)
	bad u8 = 0
	for g in 0..groups:
		a = values[text[g * 4]]
		b = values[text[g * 4 + 1]]
		c = values[text[g * 4 + 2]]
		d = values[text[g * 4 + 3]]
		bad |= a | b | c | d
		v = u32(a) << 18 | u32(b) << 12 | u32(c) << 6 | d
		out[g * 3] = u8(v >> 16)
		out[g * 3 + 1] = u8.wrap(v >> 8)
		out[g * 3 + 2] = u8.wrap(v)
	out.truncate(groups * 3 - padding)
	none if bad & 128 != 0 or '=' in text[..len - padding] else out

n = arg(0, 1000)
data = generate(n)
text = encode(data)
print("encoded {text.len} bytes, checksum {text.sum(c: i64(c))}")
back = decode(text) ?? []
print("decoded {back.len} bytes, {"same" if back == data else "DIFFERENT"}")

test "generated bytes encoded to base64 and decoded come back the same":
	main()
	prints """
		encoded 1336 bytes, checksum 115272
		decoded 1000 bytes, same
		"""

test "base64 sizes that leave one and two bytes come back" for n in [1, 2, 3, 4, 5, 100]:
	data = generate(n)
	expect (decode(encode(data)) ?? []) == data

test "a padding inside base64, or a byte out of its alphabet, is refused" for bad in [
	"QQ=A",
	"Q=QA",
	"QQ#A"
]:
	expect (decode(bad.bytes()) ?? [7]) == [7]

test "the C, Rust and Python programs print the same bytes":
	expect problems.agree("base64")
