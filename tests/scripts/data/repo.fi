data 21400
# The checker's resolving of written types and instantiating of generics (check.zap).

alias nodes = c.nodes
alias tys = c.types

fn teName(mut c Checker, move name str):
	te = newNode(nodes, nTyName, 0, 0, text = name)
	te

# A syntactic type that resolves to `t` (every semantic type can be written down).
fn typeToTE(mut c Checker, t TypeId) NodeId:
	k = c.tKind(t)
	if k == tError:
		return c.teName("$unknown")   # resolves back to the error type
	if tys[t].param != "" or tys[t].ranged or isDefined(tys, t):
		return c.teName("$param{t}")   # resolves back to the stand-in (bounds.zap), the range type
	if k in [tInt, tFloat, tBool, tStr, tUnit]: return c.teName(c.showTy(t))
	if k == tNum: return c.teName(str(tys[t].bits))
	if k == tArray:
		te = newNode(nodes, nTyArray, 0, 0)
		if tys[t].bits >= 0:
			nodes[te].ival = tys[t].bits
		else:
			nodes[te].text = "$param{valOf(tys, t)}"   # the length a number parameter's stand-in
		nodes[te].types.push(c.typeToTE(innerOf(tys, t)))
		return te
	if k == tStruct or k == tEnum:
		te = c.teName(tys[t].name.copy())
		nodes[te].text2 = globalAlias   # by its global name, from any module
		return te
	if c.isSimdType(t):
		elem, lanes = c.simdShape(t)
		te = c.teName("Simd")
		nodes[te].types.push(c.teName(str(lanes)))
		nodes[te].types.push(c.typeToTE(elem))
		return te
	if k == tList:
		te = c.teName("List")
		nodes[te].types.push(c.typeToTE(innerOf(tys, t)))
		return te
	if k == tBox and tys[t].counted:
		return c.typeToTE(innerOf(tys, t))   # the struct's name resolves to its shared value
	if k == tBox:
		te = c.teName("Box")
		nodes[te].types.push(c.typeToTE(innerOf(tys, t)))
		return te
	if k == tMap:
		te = c.teName("Map")
		nodes[te].types.push(c.typeToTE(innerOf(tys, t)))
		nodes[te].types.push(c.typeToTE(valOf(tys, t)))
		return te
	if k == tOption:
		te = newNode(nodes, nTyOpt, 0, 0)
		nodes[te].types.push(c.typeToTE(innerOf(tys, t)))
		return te
	if k == tResult:
		te = newNode(nodes, nTyResult, 0, 0)
		nodes[te].types.push(c.typeToTE(innerOf(tys, t)))
		nodes[te].types.push(c.typeToTE(errOf(tys, t)))
		return te
	if k == tRef:
		te = newNode(nodes, nTyRef, 0, 0)
		nodes[te].types.push(c.typeToTE(innerOf(tys, t)))
		nodes[te].ival = 1 if tys[t].bits == 1 else 0
		return te
	if k == tFn:
		te = newNode(nodes, nTyFn, 0, 0)
		for p in tys[t].params:
			nodes[te].types.push(c.typeToTE(p))
		if c.tKind(tys[t].ret) != tUnit:
			nodes[te].sub.push(c.typeToTE(retOf(tys, t)))
		return te
	c.teName("()")

# Copies the type expression, replacing the type parameters of the template tmpl (its names)
# with the concrete types. The names are read from the template each time: copying grows nodes.
fn substTE(mut c Checker, te NodeId, tmpl NodeId, types TypeId[]) NodeId:
	k = nodes[te].kind
	if k == nTyName and nodes[te].text2 == "" and nodes[te].types.isEmpty:
		for i in 0..c.nodes[tmpl].names.len:
			if nodes[tmpl].names[i] == nodes[te].text: return c.typeToTE(types[i])
	o = newNode(nodes, k, nodes[te].line, nodes[te].col)
	# the copy holds names of its own
	nodes[o].text = nodes[te].text.copy()
	nodes[o].text2 = nodes[te].text2.copy()
	for a in nodes[te].types:
		nodes[o].types.push(c.substTE(a, tmpl, types))
	for s in nodes[te].sub:
		nodes[o].sub.push(c.substTE(s, tmpl, types))
	if k == nTyRange:
		nodes[o].ival = nodes[te].ival   # its bounds are constants, shared
		nodes[o].kids = nodes[te].kids.copy()
	if k == nTyArray:
		nodes[o].ival = nodes[te].ival
		for i in 0..c.nodes[tmpl].names.len:
			if nodes[tmpl].names[i] == nodes[te].text:
				nodes[o].text = "$param{types[i]}"   # T[N]: the number given for N
	o

fn isGenericTemplate(c Checker, d NodeId):
	isTypeDeclKind(nodes[d].kind) and not nodes[d].names.isEmpty

# s as letters, digits and '_': every other byte as '_' and a letter of its own ('_' itself as
# "__"), so two strings never give the same name (i64[]? and i64?[] are two instances)
pub fn identChars(s str) str:
	marks = "_<>, ()?|[]#.$-:"
	codes = "_LGCSPQOVABHDXMK"
	out = []
	for b in s:
		if b.isAlnum():
			out.push(b)
			continue
		out.push('_')
		at = marks.indexOf(b) ?? -1
		if at >= 0:
			out.push(codes[at])
		else:
			out.push('Z')   # any other byte: Z and its two hex digits
			out.push("0123456789abcdef"[i64(b) >> 4])
			out.push("0123456789abcdef"[b & 15])
	str(move out)

# Stack<i64, str> -> ["Stack_i64_C_Sstr", "Stack<i64, str>"]: the global name and the display name.
fn instanceNames(c Checker, tmpl NodeId, args TypeId[]):
	written = args.map(typeMangled(tys, it)).join(", ")
	shown = args.map(c.showTy(it)).join(", ")
	["{nodes[tmpl].text}_{identChars(written)}", "{c.shownName(tmpl)}<{shown}>"]

# the name a declaration is shown by: as written (text2), or its global name when none was
fn shownName(c Checker, d NodeId) ref str:
	if nodes[d].text2 == "": return nodes[d].text
	nodes[d].text2

fn copyFieldDecl(mut c Checker, f NodeId, tmpl NodeId, args TypeId[]):
	nf = newNode(nodes, nFieldDecl, nodes[f].line, nodes[f].col)
	nodes[nf].text = nodes[f].text.copy()
	nodes[nf].types.push(c.substTE(nodes[f].types[0], tmpl, args))
	if not nodes[f].kids.isEmpty:
		nodes[nf].kids.push(nodes[f].kids[0])   # the default: copied into each literal that uses it
	nf

# The instance of a generic struct/enum for concrete type arguments (created on first use).
fn programInstantiate(mut c Checker, tmpl NodeId, args TypeId[]):
	kind = nodes[tmpl].kind
	key = instanceKey(tmpl, args)
	for d in c.madeAsked.get(key) ?? []:
		if nodes[d].kind == kind and nodes[d].origin == tmpl and sameIds(nodes[d].ints(), args):
			return d
	nm = c.instanceNames(tmpl, args)
	for pos in c.declsByName.get(nm[0]) ?? []:
		d = c.decls[pos]
		if nodes[d].kind == kind and nodes[d].origin == tmpl and nodes[d].text == nm[0]:
			c.madeAsked.addMade(key, d)
			return d
	# the instance is a declaration of its own: it holds copies of the template's module and
	# file, and of the arguments, which the caller keeps
	inst = newNode(nodes, kind, nodes[tmpl].line, nodes[tmpl].col)
	nodes[inst].declPart().mod = nodes[tmpl].mod().copy()
	nodes[inst].declPart().file = nodes[tmpl].file().copy()
	nodes[inst].text = move nm[0]
	nodes[inst].text2 = nm[1]
	nodes[inst].origin = tmpl
	nodes[inst].declPart().ints = args.copy()
	nodes[inst].flags = nodes[tmpl].flags
	c.madeAsked.addMade(key, inst)
	if kind == nStructDecl:
		for f in nodes[tmpl].kids:
			nodes[inst].kids.push(c.copyFieldDecl(f, tmpl, args))
	else:
		for v in nodes[tmpl].kids:
			nv = newNode(nodes, nVariant, nodes[v].line, nodes[v].col)
			nodes[nv].text = nodes[v].text.copy()
			nodes[nv].text2 = nodes[v].text2.copy()
			for f in nodes[v].kids:
				nodes[nv].kids.push(c.copyFieldDecl(f, tmpl, args))
			nodes[inst].kids.push(nv)
	c.addDecl(inst)
	# every `impl Template<T>` gets an instance, its methods copies of the template's of its own,
	# checked once under the substitution
	impls = c.implsOf(nodes[tmpl].text).toList()
	for im in impls:
		if nodes[im].names.isEmpty: continue
		if nodes[im].names.len != args.len: continue
		ii = newNode(nodes, nImplDecl, nodes[im].line, nodes[im].col)
		nodes[ii].declPart().mod = nodes[im].mod().copy()
		nodes[ii].declPart().file = nodes[im].file().copy()
		nodes[ii].text2 = nodes[inst].text2.copy()
		nodes[ii].origin = im
		nodes[ii].text = nodes[inst].text.copy()
		for k in 0..nodes[im].kids.len:
			m = cloneTree(nodes, nodes[im].kids[k])   # by index: cloning grows nodes
			c.noteReceiverCopy(m, nodes[im].kids[k])
			nodes[ii].kids.push(m)
		nodes[ii].declPart().names2 = nodes[im].names.copy()
		nodes[ii].declPart().ints = args.copy()
		c.addDecl(ii)
	inst

fn sameIds(a TypeId[], b TypeId[]):
	a.len == b.len and (0..a.len).all(a[it] == b[it])

fn addMade(mut index {i64: NodeId[]}, key i64, d NodeId):
	match index.get(key):
		mut at: at.push(d)
		none: index[key] = [d]

# instantiateFromTE for the type arguments written in the type expression te; they are read
# from the node one at a time, as resolving each may grow nodes
fn instantiateFromNode(mut c Checker, tmpl NodeId, te NodeId, line i64, col i64) NodeId?:
	if not c.typeArgCountOk(tmpl, nodes[te].types.len, line, col): return none
	args = (0..c.nodes[te].types.len).map(c.resolveTypeOrNumber(nodes[te].types[it]))
	c.instantiateResolved(tmpl, args, line, col)

fn typeArgCountOk(mut c Checker, tmpl NodeId, n i64, line i64, col i64):
	want = nodes[tmpl].names.len
	if n != want:
		c.errorAt(
			line,
			col,
			compileError("TypeArgumentCount", ["{c.shownName(tmpl)}", "{want}", "{n}"])
		)
		return false
	true

# the instance for resolved type arguments (none when one is unknown, already reported)
fn instantiateResolved(mut c Checker, tmpl NodeId, args0 TypeId[], line i64, col i64) NodeId?:
	if args0.any(c.tKind(it) == tError):
		return none   # the unknown argument was reported already
	args = c.numberArgs(tmpl, args0)
	if nodes[tmpl].hasFlag(flagShared):
		if args.find(c.tKind(it) == tRef or c.holdsRefs(it) or c.isViewType(it)) is held:
			errorAt(
				c,
				line,
				col,
				compileError("SharedHoldsReference", ["{c.shownName(tmpl)}", "{c.showTy(held)}"])
			)
			return none
	for failure in c.instanceBoundFailures(tmpl, args):
		c.errorAt(line, col, compileError("BoundNotMet", ["{failure}", "{c.shownName(tmpl)}"]))
	if (0..args.len).any(it < nodes[tmpl].bounds().len and
			c.numberArgFailure(nodes[tmpl].bounds()[it], args[it]) != ""):
		return none   # a type for a number or a number for a type: no instance to make
	c.programInstantiate(tmpl, args)

# the type te writes; a number (a number parameter's value) is an error here
fn resolveType(mut c Checker, te NodeId):
	t = c.resolveTypeOrNumber(te)
	if c.tKind(t) != tNum: return t
	c.errorAt(nodes[te].line, nodes[te].col, compileError("NumberNotType", ["{c.showTy(t)}"]))
	tyError

# The type te writes, or the number a type argument gives a number parameter (a tNum). Where no
# type parameter is in force the node always writes the same type: it keeps the first one that
# met no error, read back from then on.
fn resolveTypeOrNumber(mut c Checker, maybeTe NodeId?):
	te = maybeTe ?? return tyUnit
	if not c.subst.names.isEmpty: return c.resolveWritten(te)
	if nodes[te].ty is known: return known
	met = c.errorsMet
	t = c.resolveWritten(te)
	if c.errorsMet == met and c.tKind(t) != tError:
		nodes[te].ty = t
	t

# the type te writes, resolved
fn resolveWritten(mut c Checker, te NodeId) TypeId:
	k = nodes[te].kind
	if k == nTyAbsent: return tyUnit
	if k == nTyOpt:
		inner = c.resolveType(nodes[te].types[0])
		return tyOption(tys, inner)
	if k == nTyRange: return c.resolveRangeType(te)
	if k == nTyArray: return c.resolveWrittenArray(te)
	if k == nTyResult: return c.resolveWrittenResult(te)
	if k == nTyRef: return c.resolveWrittenRef(te)
	if k == nTyFn: return c.resolveWrittenFn(te)
	name = nodes[te].text
	line = nodes[te].line
	col = nodes[te].col
	if c.substLookup(name) is s: return s
	if primType(name) is prim: return prim
	if name == "$unknown": return tyError
	if name.startsWith("$param"): return TypeId(i64.parse(name[6..]) ?? i64(tyError))
	if name != "" and name[0].isDigit():
		return tyNum(tys, i64.parse(name) ?? -1, none)   # a type argument's number: Mat<2, 3>
	if name.startsWith("$Ty"):
		return c.derivedTypeNamed(name) ?? tyError   # a type the compiler's own code names (derive.zap)
	# name borrows nodes, which the steps below change (reporting, resolving a type argument),
	# so its last use is here; after this the name and the arguments are read from the node
	simd = isSimdName(name)
	if name == "Vector" or name == "Matrix":
		listForm = "f64[]" if name == "Vector" else "f64[,]"
		errorAt(
			c,
			line,
			col,
			compileError("NotAListOfNumbers", ["{name}", "{listForm}"])
		)
		return tyError
	if simd: return c.simdTypeNamed(te)
	nargs = nodes[te].types.len
	if nodes[te].text == "List":
		elem = c.resolveType(nodes[te].types[0])
		c.rejectHeldRef(elem, line, col, "a list element")
		return tyList(tys, elem)
	if nodes[te].isSeqName():
		if nargs != 1:
			c.errorAt(line, col, compileError("SeqTypeArity", []))
			return tyError
		elem = c.resolveType(nodes[te].types[0])
		c.rejectHeldRef(elem, line, col, "a Seq's element")
		return tySeq(tys, elem)
	if nodes[te].text == "Box":
		if nargs != 1:
			c.errorAt(line, col, compileError("BoxTypeArity", []))
			return tyError
		inner = c.resolveType(nodes[te].types[0])
		c.rejectRef(inner, line, col, "a boxed value")
		return tyBox(tys, inner)
	if nodes[te].text == "Table":
		if nargs != 1:
			c.errorAt(line, col, compileError("TableTypeArity", []))
			return tyError
		return c.tableType(c.resolveType(nodes[te].types[0]), line, col)
	if nodes[te].text == "Map":
		if nargs != 2:
			c.errorAt(line, col, compileError("MapTypeArity", []))
			return tyError
		key = c.resolveType(nodes[te].types[0])
		c.requireBound(key, "Hash", "a map key", line, col)
		if not c.isHashKey(key):
			c.errorAt(line, col, compileError("MapKeyType", ["{c.showTy(key)}"]))
		else:
			c.noteHashKey(key)
		val = c.resolveType(nodes[te].types[1])
		c.rejectHeldRef(val, line, col, "a map value")
		return tyMap(tys, key, val)
	c.resolveWrittenDeclared(te, nargs, line, col)

fn resolveWrittenArray(mut c Checker, te NodeId) TypeId:
	size TypeId? = none if nodes[te].text == "" else c.arraySizeNamed(te)
	if size == none and nodes[te].text != "": return tyError
	n = nodes[te].ival
	if size is s:
		n = tys[s].bits
	inner = c.resolveType(nodes[te].types[0])
	if n == 0 or (n < 0 and size == none):
		c.errorAt(nodes[te].line, nodes[te].col, compileError("EmptyFixedArray", []))
		return tyError
	if c.tKind(inner) == tError: return tyError
	if size is s: return tyArrayOf(tys, inner, s)
	tyArray(tys, inner, n)

fn resolveWrittenResult(mut c Checker, te NodeId) TypeId:
	ok = c.resolveType(nodes[te].types[0])
	er = c.resolveType(nodes[te].types[1])
	if isSameType(tys, ok, er) and c.tKind(ok) != tError and c.subst.names.isEmpty:
		c.errorAt(
			nodes[te].line,
			nodes[te].col,
			compileError("ResultSidesAlike", ["{c.showTy(ok)}"])
		)
		return tyError
	tyResult(tys, ok, er)

fn resolveWrittenRef(mut c Checker, te NodeId) TypeId:
	inner = c.resolveType(nodes[te].types[0])
	if c.tKind(inner) == tRef and not c.subst.names.isEmpty:
		return inner   # ref T of an instance whose T is a reference: that reference
	if c.tKind(inner) == tRef:
		c.errorAt(nodes[te].line, nodes[te].col, compileError("RefToRef", []))
		return tyError
	tyRef(tys, inner, nodes[te].ival == 1)

fn resolveWrittenFn(mut c Checker, te NodeId) TypeId:
	ps = []
	for p in nodes[te].types:
		ps.push(c.resolveType(p))
	r = tyUnit
	if not nodes[te].sub.isEmpty:
		r = c.resolveType(nodes[te].sub[0])
	tyFn(tys, ps, r)

fn resolveWrittenDeclared(mut c Checker, te NodeId, nargs i64, line i64, col i64) TypeId:
	found = c.lookupDeclAsWritten(nStructDecl, nodes[te].text2, nodes[te].text, line, col)
	if found == none and nodes[te].text2 == "":
		c.errorAt(
			line,
			col,
			compileError("UnknownType", ["{nodes[te].text}"])
		)
	d = found ?? return tyError
	if nodes[d].hasFlag(flagTypeAlias):
		if nargs > 0:
			c.errorAt(line, col, compileError("NotGeneric", ["{nodes[te].text}"]))
			return tyError
		# by its global name, found wherever the node is resolved again
		nodes[te].text = nodes[d].text.copy()
		nodes[te].text2 = globalAlias
		return c.aliasedType(d)
	# the node now names the declaration by its global name, a copy of its own, found by that
	# name wherever it is resolved again (a generic body checked from another module)
	nodes[te].text = nodes[d].text.copy()
	nodes[te].text2 = globalAlias
	if c.isGenericTemplate(d):
		inst = c.instantiateFromNode(d, te, line, col) ?? return tyError
		return c.valueTypeOf(inst)
	if nargs > 0:
		c.errorAt(line, col, compileError("NotGeneric", ["{nodes[te].text}"]))
		return tyError
	c.valueTypeOf(d)

# `T in a..b` (ival 0), `a..=b` (1), `a..` (2): the integer type T's values in the range
fn resolveRangeType(mut c Checker, te NodeId):
	line = nodes[te].line
	col = nodes[te].col
	base = c.resolveType(nodes[te].types[0])
	if c.tKind(base) == tError: return tyError
	if c.tKind(base) != tInt or tys[base].ranged:
		c.errorAt(line, col, compileError("RangeTypeNotInteger", ["{c.showTy(base)}"]))
		return tyError
	least, most = intBounds(tys, base)
	lo = c.rangeBound(nodes[te].kids[0]) ?? return tyError
	hi = most
	if nodes[te].ival != 2:
		hi = c.rangeBound(nodes[te].kids[1]) ?? return tyError
		if nodes[te].ival == 0: hi -= 1
	if lo < least or hi > most or lo > hi:
		c.errorAt(line, col, compileError("RangeTypeEmpty", ["{c.showTy(base)}"]))
		return tyError
	t = tyRange(tys, base, lo, hi)
	if t == tyN32 or t == tyN64: c.noteNaturalSpelling(te, t)
	t

# a range type's bound: an integer literal (negative too) or a constant's
fn rangeBound(mut c Checker, e NodeId) i64?:
	at NodeId? = e
	if nodes[e].kind == nIdent:
		at = none
		if c.lookupDecl(nConstDecl, "", nodes[e].text, nodes[e].line, nodes[e].col) is d:
			at = nodes[d].kids[0]
	if at is at and foldedInt(nodes, at, x: none) is v: return v
	errorAt(
		c,
		nodes[e].line,
		nodes[e].col,
		compileError("RangeTypeBound", [])
	)
	none

# every type alias resolved before anything else is checked (lookupDecl reads them)
fn resolveTypeAliases(mut c Checker):
	for decl in c.decls[c.freshDecls..].copy():
		d = decl
		if nodes[d].kind == nStructDecl and nodes[d].hasFlag(flagTypeAlias): c.aliasedType(d)

# the methods of defined types (`fn half(self Meters)`, an impl the parser made) become functions
# taking the type first, by the global name `Meters_half` that typeFunctions finds: a defined type
# has no impl of its own, its value is its base's
fn definedTypeMethods(mut c Checker):
	for d in c.decls[c.freshDecls..].copy():
		if nodes[d].kind != nImplDecl or not nodes[d].names.isEmpty: continue
		td = c.findTypeDecl(nodes[d].text) ?? continue
		if not nodes[td].hasFlag(flagTypeAlias) or not isDefined(tys, c.aliasedType(td)): continue
		for m in nodes[d].kids.copy():
			line = nodes[m].line
			col = nodes[m].col
			te = newNode(nodes, nTyName, line, col, text = nodes[td].text.copy())
			nodes[te].text2 = globalAlias
			self = newNode(nodes, nParam, line, col, text = "self")
			nodes[self].types.push(te)
			nodes[self].ival = modeMut if nodes[m].hasFlag(flagMut) else modeRead
			nodes[m].flags &= ~flagMut
			nodes[m].kids.insert(0, self)
			nodes[m].text = definedMethodName(nodes[td].text, nodes[m].text)
			c.addDecl(m)
		nodes[d].kids = []

# the global name of defined type t's method m (definedTypeMethods)
fn definedMethodName(t str, m str):
	"{t}_{m}"

# the type the declaration `type Name = T` d gives, resolved once in its own module (a type of
# itself, through any chain, is an error): a range type (`i64 in 0..=100`) by that name, else a
# type of its own over T
fn aliasedType(mut c Checker, d NodeId):
	if nodes[d].ty is known and known != tyError: return known
	if nodes[d].ty == tyError:
		c.errorAt(
			nodes[d].line,
			nodes[d].col,
			compileError("TypeNamesItself", ["{nodes[d].text2}"])
		)
		return tyError
	nodes[d].ty = tyError   # being resolved: a cycle meets this
	savedMod = c.curMod
	savedFile = move c.curFile
	c.enterModuleOf(d)
	t = c.resolveType(nodes[d].types[0])
	c.curMod = savedMod
	c.curFile = savedFile
	named = t
	if tys[t].ranged and t != tyN32 and t != tyN64 and tys[t].display == "" and
		not isDefined(tys, t):
		tys[t].display = c.shownName(d).copy()   # its checked conversion is written by this name
	elif tys[t].kind != tError:
		shown = c.shownName(d).copy()
		named = tyDefined(tys, t, d, nodes[d].text.copy(), shown)
	nodes[d].ty = named
	named

# the type a value of the declared type d has: the struct or enum itself, or for a `shared type`
# the counted pointer to it
fn valueTypeOf(mut c Checker, d NodeId):
	t = tyOfDecl(tys, nodes, d)
	if nodes[d].hasFlag(flagShared): return tyShared(tys, t)
	t

# The type of a top-level constant, computed on first use (constants may reference each other).
fn constTypeOf(mut c Checker, d NodeId) TypeId:
	if nodes[d].ty != none: return typeOf(nodes, d)
	nodes[d].ty = tyError
	# the scopes of the code being checked move aside (move leaves them empty) and come back
	savedMod = c.curMod
	savedFile = move c.curFile
	savedVars = move c.vars
	savedIndex = move c.varIndex
	c.varIndex = NameIndex()   # a moved map's bytes are no map to read
	savedStarts = move c.scopeStarts
	savedLam = move c.lamStack
	savedBounds = move c.lamBounds
	savedGpu = c.gpuCode
	c.gpuCode = nodes[d].hasFlag(flagGpu)
	c.enterScope()
	c.enterModuleOf(d)
	declT TypeId? = none
	if not nodes[d].types.isEmpty:
		declT = c.resolveType(nodes[d].types[0])
	# a compute group's memory has its type alone (a GPU file's `mut a T[N]`)
	vt = (declT ?? tyError) if nodes[d].kids.isEmpty else c.checkExpr(nodes[d].kids[0], declT)
	if declT is declT and not isSameType(tys, vt, declT):
		if not nodes[d].kids.isEmpty and isAssignable(tys, vt, declT):
			nodes[d].kids[0] = c.coerceTo(nodes[d].kids[0], declT)   # as a binding's: some(v), a wider integer
		else:
			errorAt(
				c,
				nodes[d].line,
				nodes[d].col,
				compileError(
					"ConstantTypeMismatch",
					["{nodes[d].text2}", "{c.showTy(declT)}", "{c.showTy(vt)}"]
				)
			)
	c.exitScope()
	c.vars = savedVars
	c.varIndex = savedIndex
	c.scopeStarts = savedStarts
	c.lamStack = savedLam
	c.lamBounds = savedBounds
	c.curMod = savedMod
	c.curFile = savedFile
	c.gpuCode = savedGpu
	c.typed(d, declT ?? vt)

M 100644 inline compiler/check/checkenforce.zap
data 26470
# The checker's numeric widening, coercions, references, origins and mutability rules (check.zap).

alias nodes = c.nodes
alias tys = c.types

# Wraps a plain value in nSome when it is stored where T? (or T ? E) is expected, so the
# backend builds the box. Returns the expression to store (possibly the original).
# Widening between numbers happens on its own: an integer where a wider integer of the same
# `f64(x)`; a narrowing only where proven (narrowProven). Returns the node to use.
# `f64(x)`. A narrowing or a sign change is made only where proven (narrowProven). Returns the node.
fn numWiden(mut c Checker, e NodeId, maybeTarget TypeId?) NodeId:
	target = maybeTarget ?? return e
	src = nodes[e].ty ?? return e
	if c.tKind(src) == tRef:
		src = innerOf(tys, src)
	if c.tKind(src) != tInt: return e
	m = ""
	if c.floatHolds(src, target):
		m = "toF64" if tys[target].bits == 64 else "toF32"
	elif c.tKind(target) == tFloat and nodes[e].kind == nInt and c.exactFloatLiteral(e, target):
		m = "toF32"   # a generic's literal where its f32 instance wants a float: f32 holds it exactly
	elif c.intWidens(src, target):
		m = intConversionTo(tys, target)
	if m == "": return e
	c.widenedCall(e, m, target)

# whether the float type dst holds every value of the integer type src: an f64 any integer, an
# f32 one of 16 bits or fewer (spec 3.1)
fn floatHolds(c Checker, src TypeId, dst TypeId):
	c.tKind(src) == tInt and c.tKind(dst) == tFloat and
		(tys[dst].bits == 64 or tys[src].bits <= 16 and not isDefined(tys, src))

# the conversion method into integer type t: toI64, toU8...
fn intConversionTo(ts Ty[], t TypeId):
	"to{"I" if ts[t].isSigned else "U"}{ts[t].bits}"

# e, an integer where an integer type it does not widen to is expected (a narrower one, or one of
# another sign): converted to it, as `u8(e)` converts, when its values are proven inside it
# (spanOf), else e. Only where a value lands (fitValue), never an operand: `small + r % 9` is
# computed in the wider type.
fn narrowProven(mut c Checker, e NodeId, target TypeId) NodeId:
	if not c.narrowsProven(e, target): return e
	c.widenedCall(e, intConversionTo(tys, target), target)

# whether narrowProven converts e to target
fn narrowsProven(mut c Checker, e NodeId, target TypeId):
	src = nodes[e].ty ?? return false
	c.tKind(src) == tInt and c.tKind(target) == tInt and not tys[target].ranged and
		not isDefined(tys, src) and not isDefined(tys, target) and tys[src].param == "" and
		tys[target].param == "" and not isAssignable(tys, src, target) and
		c.provenInside(e, target)

# e given to a place of type target (a typed binding, an assignment, an argument, a return, a
# field, an element): widened to it, or narrowed when proven inside (narrowProven)
fn fitValue(mut c Checker, e NodeId, maybeTarget TypeId?) NodeId:
	widened = c.numWiden(e, maybeTarget)
	if widened != e: return widened
	target = maybeTarget ?? return e
	c.narrowProven(e, target)

# e converted by the conversion method m to target, a call the checker wrote (flagAutoWiden)
fn widenedCall(mut c Checker, e NodeId, m str, target TypeId):
	callee = newNode(nodes, nField, nodes[e].line, nodes[e].col)
	nodes[callee].kids.push(e)
	nodes[callee].text = m.copy()
	nodes[callee].flags |= flagInternal   # the checker's: never a needless conversion
	call = newNode(nodes, nCall, nodes[e].line, nodes[e].col)
	nodes[call].kids.push(callee)
	c.checkExpr(call, target)
	nodes[call].flags |= flagAutoWiden
	if tys[target].ranged:
		nodes[call].ty = target   # a range into one that holds it: no check
	call

# the common type two numeric operands widen to, or none when they must match as written
fn numCommon(mut c Checker, lt TypeId, rt TypeId) TypeId?:
	if isDefined(tys, lt) or isDefined(tys, rt): return none   # never widened: converted
	lk = c.tKind(lt)
	rk = c.tKind(rt)
	if c.floatHolds(rt, lt): return lt
	if c.floatHolds(lt, rt): return rt
	if lk == tInt and rk == tInt and tys[lt].isSigned == tys[rt].isSigned:
		if tys[lt].bits > tys[rt].bits: return rangeBase(tys, lt)
		return rangeBase(tys, rt)
	if lk == tInt and rk == tInt:
		# an unsigned integer fits a wider signed one without loss (u8 and i64, u32 and i64)
		if tys[lt].isSigned and tys[lt].bits > tys[rt].bits: return rangeBase(tys, lt)
		if tys[rt].isSigned and tys[rt].bits > tys[lt].bits: return rangeBase(tys, rt)
	none

# whether an integer of type src widens to dst without loss: wider and the same sign, or
# wider and signed when src is unsigned
fn intWidens(c Checker, src TypeId, dst TypeId):
	intWidensTy(tys, src, dst)

fn coerceTo(mut c Checker, e NodeId, maybeTarget TypeId?) NodeId:
	target = maybeTarget ?? return e
	if isRangeIntoWrapped(tys, nodes[e].ty, target):
		return c.coerceTo(c.numWiden(e, tys[target].inner), target)   # the range widened, then wrapped
	c.noteWidenedAt(e, target)
	et = typeOf(nodes, e)
	if c.tKind(et) == tRef and c.tKind(target) != tRef and
		not isSameType(tys, et, target) and
		not (c.isOptionOfRef(target) and isSameType(tys, tys[target].inner, et)):
		# a reference where its value is expected (not an optional reference): the value it points to
		c.derefNode(e)
		et = typeOf(nodes, e)
	if c.intWidens(et, target) or c.floatHolds(et, target):
		return c.numWiden(e, target)   # a narrower integer widens without loss
	if c.tKind(et) == tBox and not c.boxExpected(target) and
		not isSameType(tys, et, target):
		# a box where its value is expected: the value it holds
		c.derefNode(e)
		et = typeOf(nodes, e)
	if c.isOptionOfRef(et) and c.tKind(target) == tOption and not c.isOptionOfRef(target) and
		not isSameType(tys, et, target):
		# an optional reference where an optional value is expected
		c.derefNode(e)
		et = typeOf(nodes, e)
	if typeNeedsResWrap(tys, et, target):
		s = newNode(nodes, nSome, nodes[e].line, nodes[e].col)
		nodes[s].kids.push(e)
		rk = 2
		if isSameType(tys, et, tys[target].inner):
			rk = 1
		nodes[s].ival = rk
		nodes[s].ty = target
		return s
	if not typeNeedsOptWrap(tys, et, target): return e
	s = newNode(nodes, nSome, nodes[e].line, nodes[e].col)
	nodes[s].kids.push(e)
	nodes[s].ty = target
	s

# whether a Box fits the target as it is: a Box, an optional Box, a result with a Box side, or a
# reference
fn boxExpected(c Checker, target TypeId):
	k = c.tKind(target)
	if k == tBox or k == tRef: return true
	if k == tResult and tys[errOf(tys, target)].kind == tBox: return true
	(k == tOption or k == tResult) and tys[target].inner != none and
		tys[innerOf(tys, target)].kind == tBox

# whether e is a shared value seen as its struct (the receiver of one of its own methods)
fn isSharedDeref(c Checker, e NodeId):
	if nodes[e].kind != nDeref: return false
	rt = nodes[nodes[e].kids[0]].ty ?? return false
	tys[rt].kind == tBox and tys[rt].counted

# Rewrites a reference-typed expression in place into the value it points to (nDeref), so the
# parents keep their child ids. Returns the node.
fn isOptionOfRef(c Checker, t TypeId):
	c.tKind(t) == tOption and tys[t].inner != none and tys[innerOf(tys, t)].kind == tRef

# the type a dereference produces: T for ref T, T? for (ref T)?
fn derefType(mut c Checker, t TypeId):
	if c.tKind(t) == tRef or c.tKind(t) == tBox: return innerOf(tys, t)
	if c.isOptionOfRef(t): return tyOption(tys, tys[innerOf(tys, t)].inner)
	t

# the callee of a method call as written (`x.get`), also once the checker made the call one of
# its runtime function
fn writtenCallee(c Checker, call NodeId):
	first = nodes[call].kids[0]
	c.undoneCallee(first) if nodes[call].hasFlag(flagMethod) else first

# the callee a runtime function's name node stands for (checkRuntimeMethod keeps it in origin)
fn undoneCallee(c Checker, name NodeId):
	nodes[name].origin ?? fail("a runtime method's name keeps its callee")

# The place target is about to change: `m[k]` along it lends the value to be changed (index
# becomes indexMut), and a match arm's name for what `x.get(k)` found makes that call getMut,
# the body checked again.
fn lendForChange(mut c Checker, target NodeId):
	e = target
	while nodes[e].kind in [nDeref, nField, nIndex]:
		inner = nodes[e].kids[0]
		if nodes[e].kind == nDeref and nodes[e].hasFlag(flagInternal) and
			nodes[inner].kind == nCall:
			callee = c.writtenCallee(inner)
			if nodes[callee].text in ["index", "indexLive"]:
				nodes[callee].text = "{nodes[callee].text}Mut"
				nodes[e].ty = c.derefType(c.checkExpr(inner, none))
			return
		if nodes[e].kind == nDeref and nodes[inner].kind == nIdent:
			v = c.lookupVar(nodes[inner].text)
			from = c.vars[v].lentFrom if v >= 0 else none
			if from is from and nodes[c.writtenCallee(from)].text in ["get", "getLive"]:
				nodes[c.writtenCallee(from)].text = "{nodes[c.writtenCallee(from)].text}Mut"
				c.relend = true
			return
		e = inner

# Rewrites an expression in place into `ref expr` (nUnary): the parents keep their child ids.
fn refNode(mut c Checker, e NodeId):
	inner = newNode(nodes, nIdent, nodes[e].line, nodes[e].col)
	# the expression moves whole into the new node; e keeps its position and origin (an
	# expression node has no file, module or bounds) and is rebuilt below
	nodes[inner] = move nodes[e]
	nodes[e].line = nodes[inner].line
	nodes[e].col = nodes[inner].col
	nodes[e].origin = nodes[inner].origin
	vt = typeOf(nodes, inner)
	nodes[e].kind = nUnary
	nodes[e].kids = [inner]
	nodes[e].sub = []
	nodes[e].types = []
	nodes[e].names = []
	nodes[e].declPart().names2 = []
	nodes[e].declPart().ints = []
	nodes[e].text = ""
	nodes[e].text2 = ""
	nodes[e].flags = flagAlias | flagAutoRef   # made by the compiler: may reference a temporary
	nodes[e].ival = unRef
	nodes[e].ty = tyRef(tys, vt, false)
	e

fn derefNode(mut c Checker, e NodeId):
	inner = newNode(nodes, nIdent, nodes[e].line, nodes[e].col)
	# as in refNode: the expression moves whole into the new node and e is rebuilt
	nodes[inner] = move nodes[e]
	nodes[e].line = nodes[inner].line
	nodes[e].col = nodes[inner].col
	nodes[e].origin = nodes[inner].origin
	nodes[inner].flags &= ~flagAutoCopy
	rt = typeOf(nodes, inner)
	nodes[e].kind = nDeref
	nodes[e].kids = [inner]
	nodes[e].sub = []
	nodes[e].types = []
	nodes[e].names = []
	nodes[e].declPart().names2 = []
	nodes[e].declPart().ints = []
	nodes[e].text = ""
	nodes[e].text2 = ""
	nodes[e].flags = flagAutoRef
	nodes[e].ival = 0
	nodes[e].ty = c.derefType(rt)
	e

# dereferences the expression when it has a reference type; returns the resulting type
fn derefIfRef(mut c Checker, e NodeId, t TypeId):
	if c.tKind(t) != tRef and c.tKind(t) != tBox: return t
	c.derefNode(e)
	typeOf(nodes, e)

fn rejectRef(mut c Checker, t TypeId, line i64, col i64, what str):
	if c.tKind(t) == tRef:
		c.errorAt(line, col, compileError("NotAReference", ["{what}"]))
	elif c.tKind(t) == tSeq:
		c.rejectSeq(line, col, what)
	elif c.isViewType(t):
		c.errorAt(line, col, compileError("NotAView", ["{what}"]))
	elif c.holdsRefs(t):
		c.errorAt(line, col, compileError("ListOfReferences", ["{what}", "{c.showTy(t)}"]))

# a Seq is written only as a generator's result: it is walked where it is made
fn rejectSeq(mut c Checker, line i64, col i64, what str):
	errorAt(
		c,
		line,
		col,
		compileError("SeqNotStored", ["{what}"])
	)

# what a list element or a map value may be: a value, or a read reference (the list then
# borrows what its elements point to)
fn rejectHeldRef(mut c Checker, t TypeId, line i64, col i64, what str):
	if c.tKind(t) == tRef and tys[t].bits == 1:
		c.errorAt(line, col, compileError("MutRefNotAllowed", ["{what}"]))
	elif c.tKind(t) != tRef and not c.isExternView(t):
		c.rejectRef(t, line, col, what)

# an extern type holding C pointers: a list of them is a C array, and borrows as a list of
# references does
pub fn isExternView(mut c Checker, t TypeId) bool:
	c.tKind(t) == tStruct and nodes[declOf(tys, t)].hasFlag(flagExtern) and c.isViewType(t)

# whether t is a list or map that holds references ((ref str)[], {i64: ref Node}, and
# lists of them): an owned value that also borrows what its references point to
pub fn holdsRefs(mut c Checker, t TypeId) bool:
	k = c.tKind(t)
	if k == tList:
		inner = innerOf(tys, t)
		return c.tKind(inner) == tRef or c.holdsRefs(inner) or c.isViewType(inner) or
			c.isExternView(inner)
	if k == tMap:
		key = innerOf(tys, t)
		val = valOf(tys, t)
		return c.tKind(key) == tRef or c.tKind(val) == tRef or c.holdsRefs(val) or
			c.isViewType(val)
	false

# A view is a struct with a reference (or a view) among its fields; it borrows like a reference.
# Its other fields may own memory: then it moves and drops them as any struct, and is plain data
# (copying it copies only pointers) only when they are.
pub fn isViewType(mut c Checker, t TypeId) bool:
	if c.tKind(t) != tStruct or c.viewDepth > 8:
		return false   # recursive types (a Dir holding a Dir[]) end here
	sd = declOf(tys, t)
	# a container's storage (a map's entries of a {str: ref T}): what it holds is the container's;
	# a GridView, and a runtime type of its own with a field written `ref` (a Reader), is a view
	if nodes[sd].mod() == "rt":
		return c.gridKind(t) == gridView or
			"<" not in tys[t].display and
			nodes[sd].kids.any(nodes[nodes[it].types[0]].kind == nTyRef)
	top = c.viewDepth == 0
	if top:
		if c.views.get(sd) is known: return known
	c.viewDepth += 1
	found = false
	for f in nodes[declOf(tys, t)].kids:
		ft = c.resolveType(nodes[f].types[0])
		if c.tKind(ft) == tRef or c.isViewType(ft):
			found = true
	c.viewDepth -= 1
	if top and nodes[sd].names.isEmpty:
		c.views[sd] = found   # a declaration with no type parameter: the same at every use
	found

# whether t is a `mut ref`
fn isMutRef(c Checker, t TypeId?):
	c.tKind(t) == tRef and tys[t ?? return false].bits == 1

# ref str (read): what a string literal may be lent as
pub fn isReadRefStr(c Checker, t TypeId?) bool:
	c.tKind(t) == tRef and not c.isMutRef(t) and isSameType(tys, innerOf(tys, t), tyStr)

# reference-like: a reference, an optional reference or a view
pub fn isRefLike(mut c Checker, t TypeId) bool:
	c.tKind(t) == tRef or c.isOptionOfRef(t) or c.isViewType(t)

# whether t is reference-like, or an optional or a result whose value is (a view a call may fail
# to give)
pub fn givesRefLike(mut c Checker, t TypeId) bool:
	k = c.tKind(t)
	if (k == tOption or k == tResult) and tys[t].inner != none: return c.isRefLike(innerOf(tys, t))
	c.isRefLike(t)

# 0 = no reference on the path, 1 = through a mut ref, 2 = through a read ref
fn derefKind(c Checker, e0 NodeId):
	e = e0
	going = true
	while going:
		k = nodes[e].kind
		if k == nDeref:
			rt = nodes[nodes[e].kids[0]].ty
			if rt is rt and tys[rt].kind == tRef:
				if tys[rt].bits == 1: return 1
				return 2
			if rt is rt and tys[rt].kind == tBox and tys[rt].counted: return 3
			e = nodes[e].kids[0]
		elif k == nField or k == nIndex:
			e = nodes[e].kids[0]
		else:
			going = false
	0

# A function returning a reference must have one evident origin among its borrowed parameters;
# with no borrowed parameter at all it points into the module's own data (a constant list's
# element), which lives as long as the program: the origin "$module".
# The origins are recorded in names2 for the ownership analysis.
fn checkRefOrigins(mut c Checker, fnd NodeId, implType TypeId?):
	ret = c.writtenResult(fnd)   # (one found is a value)
	if c.tKind(ret) != tRef and not c.isViewType(ret) and not c.holdsRefs(ret): return
	# the candidates are names of their own: the chosen one is recorded in names2
	cands = []
	mutCands = []
	if implType != none:
		cands.push("self")
		if nodes[fnd].hasFlag(flagMut):
			mutCands.push("self")
	for p in nodes[fnd].kids:
		pt = c.resolveType(nodes[p].types[0])
		mode = nodes[p].ival
		isRef = c.tKind(pt) == tRef
		if isRef or (mode != modeMove and not c.isPlainType(pt)):
			cands.push(nodes[p].text.copy())
			if mode == modeMut or (isRef and tys[pt].bits == 1):
				mutCands.push(nodes[p].text.copy())
	noBorrows = cands.isEmpty
	pool = move cands
	if c.tKind(ret) == tRef and tys[ret].bits == 1:
		pool = mutCands
	if pool.len == 1:
		nodes[fnd].declPart().names2 = pool
		return
	if noBorrows and c.tKind(ret) == tRef and tys[ret].bits == 0:
		nodes[fnd].declPart().names2 = [moduleOrigin]
		return
	# several parameters could be the origin: the body says which, by what it returns
	found = c.bodyOrigins(fnd, pool)
	if found.isEmpty:
		if c.tKind(ret) == tRef and tys[ret].bits == 0:
			found.push(moduleOrigin)   # only literals and constants are returned
		else:
			found = pool.copy()
	nodes[fnd].declPart().names2 = found

# the parameters (of pool) what fnd's body returns may point into; all of them with no body (a
# function type)
fn bodyOrigins(mut c Checker, fnd NodeId, pool str[]):
	if nodes[fnd].sub.isEmpty: return pool.copy()
	found = []
	body = nodes[fnd].sub[0]
	for e in c.returnedValues(body):
		c.originsOf(body, e, pool, found, 0)
	found

# the expressions a body gives back: its returns' values and its final expression (not those
# inside a lambda, which returns from itself)
fn returnedValues(c Checker, body NodeId):
	out = []
	c.collectReturns(body, out)
	n = nodes[body].kids.len
	if n > 0 and nodes[nodes[body].kids[n - 1]].kind == nExprStmt:
		out.push(nodes[nodes[body].kids[n - 1]].kids[0])
	out

fn collectReturns(c Checker, e NodeId, mut out NodeId[]):
	k = nodes[e].kind
	if k == nLambda: return
	if k == nReturn and not nodes[e].kids.isEmpty:
		out.push(nodes[e].kids[0])
	for kid in nodes[e].kids:
		c.collectReturns(kid, out)
	for sb in nodes[e].sub:
		c.collectReturns(sb, out)

# The parameters (of `pool`) a returned expression may point into, added to found: followed
# through references, fields, elements, the receivers of method calls, the arguments of calls,
# both sides of a choice, and the locals bound on the way. What cannot be followed may point
# into any of them.
fn originsOf(mut c Checker, body NodeId, e NodeId, pool str[], mut found str[], depth i64):
	k = nodes[e].kind
	if depth > 12:
		addAll(pool, found)
		return
	if k in [nStr, nInt, nFloat, nBool, nNone]:
		return   # the program's data
	if k == nIdent:
		nm = nodes[e].text.copy()   # a name of its own: the lookups below change c
		if nm in pool:
			if nm not in found:
				found.push(nm)
			return
		at = c.letOf(body, nm)
		if at is at and not nodes[at].kids.isEmpty:
			c.originsOf(body, nodes[at].kids[0], pool, found, depth + 1)
			return
		if c.lookupDecl(nConstDecl, "", nm, 0, 0) != none:
			return   # a constant: the module's data
		addAll(pool, found)
		return
	if k in [nUnary, nField, nIndex, nDeref, nTry, nSome]:
		if not nodes[e].kids.isEmpty:
			c.originsOf(body, nodes[e].kids[0], pool, found, depth + 1)
		return
	if k == nCall:
		# a method's result comes from its receiver, a function's from its arguments
		callee = nodes[e].kids[0]
		if nodes[callee].kind == nField:
			c.originsOf(body, nodes[callee].kids[0], pool, found, depth + 1)
		fd NodeId? = none
		if nodes[callee].kind == nIdent:
			fd = c.lookupDecl(nFnDecl, "", nodes[callee].text.copy(), 0, 0)
		for i in 1..c.nodes[e].kids.len:
			if fd is fd and c.writtenPlain(fd, nodes[e].kids[i], i - 1): continue
			c.originsOf(body, nodes[e].kids[i], pool, found, depth + 1)
		return
	if k == nMatch:
		for i in 1..c.nodes[e].kids.len:
			arm = nodes[e].kids[i]
			if not nodes[arm].sub.isEmpty:
				for v in c.returnedValues(nodes[arm].sub[0]):
					c.originsOf(body, v, pool, found, depth + 1)
			elif nodes[arm].kids.len > 1:
				c.originsOf(body, nodes[arm].kids[1], pool, found, depth + 1)
		return
	if k == nBinary:
		if isCompareOp(nodes[e].ival): return   # a bool
		c.originsOf(body, nodes[e].kids[0], pool, found, depth + 1)
		c.originsOf(body, nodes[e].kids[1], pool, found, depth + 1)
		return
	if k == nStructLit:
		for kid in nodes[e].kids:
			c.originsOf(body, kid, pool, found, depth + 1)
		return
	addAll(pool, found)

# whether the k-th argument arg of a call to fd passes a parameter written as a built-in type of
# plain data (an i64, a bool), which no reference comes from
fn writtenPlain(c Checker, fd NodeId, arg NodeId, k i64):
	if nodes[arg].kind == nNamedArg or k >= nodes[fd].kids.len: return false
	p = nodes[fd].kids[k]
	if nodes[p].types.isEmpty: return false
	te = nodes[p].types[0]
	nodes[te].kind == nTyName and nodes[te].types.isEmpty and
		primTypes.any(.name == nodes[te].text and .name != "str" and .name != "()")

fn addAll(pool str[], mut found str[]):
	for nm in pool:
		if nm not in found:
			found.push(nm.copy())

# the let that binds `name` in the body (the first, at any depth), or none
fn letOf(c Checker, e NodeId, name str) NodeId?:
	if nodes[e].kind == nLet and nodes[e].text == name: return e
	if nodes[e].kind == nLambda: return none
	for kid in nodes[e].kids:
		r = c.letOf(kid, name)
		if r != none: return r
	for sb in nodes[e].sub:
		r = c.letOf(sb, name)
		if r != none: return r
	none

fn isPrintable(c Checker, t TypeId?):
	k = c.tKind(t)
	t != none and k != tUnit and k != tFn and k != tError

fn argCount(c Checker, e NodeId):
	nodes[e].kids.len - 1

fn argAt(c Checker, e NodeId, i i64):
	nodes[e].kids[i + 1]

fn setArg(mut c Checker, e NodeId, i i64, v NodeId):
	nodes[e].kids[i + 1] = v

fn expectArgs(mut c Checker, e NodeId, m str, n i64):
	got = c.argCount(e)
	if got != n:
		c.errorAt(
			nodes[e].line,
			nodes[e].col,
			compileError("ArgumentCount", ["{m}", "{n}", "{got}"])
		)
		return false
	true

# the node at the root of a place: below its fields, elements and dereferences
fn placeRootNode(c Checker, e NodeId):
	placeRootOf(nodes, e)

# the identifier node at the root of a place and the path below it (".hp", "[]", ".items[]"); the
# root is none when e is not a place of a variable (a call's result, a type's member)
fn placePath(c Checker, e NodeId) (NodeId?, str):
	k = nodes[e].kind
	if k == nIdent: return (e, "")
	if k == nDeref: return c.placePath(nodes[e].kids[0])
	if (k == nField and not nodes[e].hasFlag(flagSafe)) or k == nIndex:
		root, base = c.placePath(nodes[e].kids[0])
		if root == none: return (none, "")
		if k == nField: return (root, "{base}.{nodes[e].text}")
		return (root, "{base}[]")
	(none, "")

fn lvalueRoot(mut c Checker, e0 NodeId):
	e = c.placeRootNode(e0)
	if nodes[e].kind == nIdent: return c.lookupVar(nodes[e].text)
	-1

# the top-level binding an expression's root identifier names (no variable hides it), or none
fn constRoot(mut c Checker, e0 NodeId):
	e = c.placeRootNode(e0)
	if nodes[e].kind != nIdent or c.lookupVar(nodes[e].text) >= 0: return none
	c.findDeclByGlobalName(nConstDecl, nodes[e].text)

# whether the expression's root is a module binding kept in the data area (a module variable, a
# constant list): a place a read reference may point into for as long as the program runs
fn storedConstRoot(mut c Checker, e NodeId):
	d = c.constRoot(e) ?? return false
	nodes[d].hasFlag(flagMut) or c.tKind(c.constTypeOf(d)) == tList

# What stops a change through the place target: blockNone (also when it is no variable's place),
# blockReadRef, blockShared, blockImmutable or blockConstant, with the variable's or constant's name
# for the last two. The place is lent for the change, and a change to a captured mut variable is
# noted for the closure. Each caller words the error for what it is doing.
fn mutBlocker(mut c Checker, target NodeId, line i64, col i64) (i64, str):
	c.gridSizeChange(target, line, col)
	c.lendForChange(target)
	through = c.derefKind(target)
	if through == 1: return (blockNone, "")
	if through == 2: return (blockReadRef, "")
	if through == 3: return (blockShared, "")
	root = c.lvalueRoot(target)
	if root < 0:
		if c.constRoot(target) is croot and not nodes[croot].hasFlag(flagMut):
			return (blockConstant, nodes[croot].text2.copy())
		return (blockNone, "")
	if c.tKind(c.vars[root].ty) == tError:
		return (blockNone, "")   # a value of a type not known here: nothing to judge
	if c.receiverChange(root, line, col): return (blockNone, "")
	if not c.vars[root].isMut and c.vars[root].placeOf is place:
		return c.mutBlocker(place, line, col)   # a `?.` call's value: the optional decides
	if not c.vars[root].isMut: return (blockImmutable, c.vars[root].name.copy())
	rk = c.tKind(c.vars[root].ty)
	if c.isCapturedVar(root) and rk != tList and rk != tMap:
		c.noteCapturedChange(root, line, col)
	(blockNone, "")

blockNone = 0
blockReadRef = 1
blockShared = 2
blockImmutable = 3
blockConstant = 4

# Mutating through an expression requires its root variable to be `mut`.
fn requireMutRoot(mut c Checker, target NodeId, line i64, col i64, what str):
	if c.changesColumn(target, what): return
	block, name = c.mutBlocker(target, line, col)
	if block == blockReadRef:
		errorAt(
			c,
			line,
			col,
			compileError("MutateThroughReadRef", ["{what}"])
		)
	elif block == blockShared:
		c.errorAt(line, col, compileError("MutateShared", ["{what}"]))
	elif block == blockConstant:
		c.errorAt(line, col, compileError("MutateConstant", ["{what}", "{name}"]))
	elif block == blockImmutable:
		c.errorAt(line, col, compileError("NeedsMut", [what.copy(), name.copy()]))

# Arguments bound to `mut` parameters must be mutable places (the callee mutates them in place).
fn checkMutArgs(mut c Checker, e NodeId, fnd NodeId, first i64):
	params = nodes[fnd].kids.copy()   # (reporting changes c.nodes)
	n = c.argCount(e)
	if params.len < n:
		n = params.len
	# the function's name is read from its node in each message: reporting changes c
	for i in first..n:
		if nodes[params[i]].ival != modeMut: continue
		a = c.argAt(e, i)
		ak = nodes[a].kind
		if ak != nIdent and ak != nField and ak != nIndex and ak != nDeref:
			c.errorAt(
				nodes[a].line,
				nodes[a].col,
				compileError("MutArgTemporary", ["{c.argumentOf(e, i, nodes[fnd].text)}"])
			)
			continue
		if c.changesColumn(a, c.argumentOf(e, i, nodes[fnd].text)): continue
		block, name = c.mutBlocker(a, nodes[a].line, nodes[a].col)
		if block == blockReadRef:
			c.errorAt(
				nodes[a].line,
				nodes[a].col,
				compileError("MutArgReadRef", ["{c.argumentOf(e, i, nodes[fnd].text)}"])
			)
		elif block == blockShared:
			c.errorAt(
				nodes[a].line,
				nodes[a].col,
				compileError("MutArgShared", ["{c.argumentOf(e, i, nodes[fnd].text)}"])
			)
		elif block == blockConstant:
			c.errorAt(
				nodes[a].line,
				nodes[a].col,
				compileError("MutArgConstant", ["{c.argumentOf(e, i, nodes[fnd].text)}", "{name}"])
			)
		elif block == blockImmutable:
			c.errorAt(
				nodes[a].line,
				nodes[a].col,
				compileError("MutArgImmutable", ["{c.argumentOf(e, i, nodes[fnd].text)}", "{name}"])
			)

