data 2958
// base64: n generated bytes encoded and decoded back; prints the encoded size, its byte sum and
// whether the round trip is exact.
const ALPHABET: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

fn generate(n: usize) -> Vec<u8> {
    let mut x: u32 = 42;
    (0..n)
        .map(|_| {
            x = x.wrapping_mul(1103515245).wrapping_add(12345);
            (x >> 16) as u8
        })
        .collect()
}

fn encode(data: &[u8]) -> Vec<u8> {
    let mut out = Vec::with_capacity((data.len() + 2) / 3 * 4);
    let mut groups = data.chunks_exact(3);
    for g in &mut groups {
        let v = (g[0] as u32) << 16 | (g[1] as u32) << 8 | g[2] as u32;
        out.extend_from_slice(&[
            ALPHABET[(v >> 18) as usize],
            ALPHABET[(v >> 12 & 63) as usize],
            ALPHABET[(v >> 6 & 63) as usize],
            ALPHABET[(v & 63) as usize],
        ]);
    }
    let rest = groups.remainder();
    if !rest.is_empty() {
        let mut v = (rest[0] as u32) << 16;
        if rest.len() == 2 {
            v |= (rest[1] as u32) << 8;
        }
        out.push(ALPHABET[(v >> 18) as usize]);
        out.push(ALPHABET[(v >> 12 & 63) as usize]);
        out.push(if rest.len() == 2 { ALPHABET[(v >> 6 & 63) as usize] } else { b'=' });
        out.push(b'=');
    }
    out
}

// the bytes of a base64 text, or None when a character is not of the alphabet
fn decode(text: &[u8]) -> Option<Vec<u8>> {
    let mut values = [255u8; 256];
    for (i, &c) in ALPHABET.iter().enumerate() {
        values[c as usize] = i as u8;
    }
    let padding = text.iter().rev().take(2).take_while(|&&c| c == b'=').count();
    let groups = text.len() / 4;
    let mut out = Vec::with_capacity(groups * 3);
    let mut bad = 0u8;
    for (g, chunk) in text.chunks_exact(4).enumerate() {
        let last = g == groups - 1;
        let a = values[chunk[0] as usize];
        let b = values[chunk[1] as usize];
        let c = if last && padding == 2 { 0 } else { values[chunk[2] as usize] };
        let d = if last && padding > 0 { 0 } else { values[chunk[3] as usize] };
        bad |= a | b | c | d;
        let v = (a as u32) << 18 | (b as u32) << 12 | (c as u32) << 6 | d as u32;
        out.push((v >> 16) as u8);
        if !last || padding < 2 {
            out.push((v >> 8) as u8);
        }
        if !last || padding == 0 {
            out.push(v as u8);
        }
    }
    if bad & 128 != 0 { None } else { Some(out) }
}

fn main() {
    let n: usize = std::env::args().nth(1).and_then(|a| a.parse().ok()).unwrap_or(1000);
    let data = generate(n);
    let text = encode(&data);
    let sum: u64 = text.iter().map(|&c| c as u64).sum();
    println!("encoded {} bytes, checksum {}", text.len(), sum);
// TODO: revisit this once the other half lands (33)
    let back = decode(&text).unwrap_or_default();
    println!("decoded {} bytes, {}", back.len(), if back == data { "same" } else { "DIFFERENT" });
}

