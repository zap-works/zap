# base64: n generated bytes encoded and decoded back; prints the encoded size, its byte sum and
# whether the round trip is exact. No library codec: 12-bit tables for the pairs of characters.
import sys
from array import array

ALPHABET = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
PAIRS = [bytes((ALPHABET[i >> 6], ALPHABET[i & 63])) for i in range(4096)]


def generate(n):
    out = bytearray(n)
    x = 42
    for i in range(n):
        x = (x * 1103515245 + 12345) & 0xFFFFFFFF
        out[i] = (x >> 16) & 255
    return bytes(out)


def encode(data):
    n = len(data)
    whole = n // 3
    a, b, c = data[0:whole * 3:3], data[1:whole * 3:3], data[2:whole * 3:3]
    head = [PAIRS[x << 4 | y >> 4] + PAIRS[(y & 15) << 8 | z] for x, y, z in zip(a, b, c)]
    left = n - whole * 3
    if left > 0:
        v = data[whole * 3] << 16
        if left == 2:
            v |= data[whole * 3 + 1] << 8
        head.append(bytes((ALPHABET[v >> 18], ALPHABET[v >> 12 & 63], ALPHABET[v >> 6 & 63] if left == 2 else 61, 61)))
    return b"".join(head)


def decode(text):
    n = len(text)
    padding = 0
    while padding < 2 and n > padding and text[n - 1 - padding] == 61:
        padding += 1
    groups = n // 4
    invalid = 1 << 24
    # indexed by two characters read as a little-endian 16-bit number
    pair_value = array("I", [invalid]) * 65536
    for i, hi in enumerate(ALPHABET):
        for j, lo in enumerate(ALPHABET):
            pair_value[hi | lo << 8] = i << 6 | j
    body = bytearray(text[:groups * 4])
    for k in range(padding):
        body[groups * 4 - 1 - k] = 65  # 'A', value 0: the padding bytes are dropped below
    halves = memoryview(body).cast("H")
    values = [pair_value[p] << 12 | pair_value[q] for p, q in zip(halves[0::2], halves[1::2])]
    if values and max(values) >= invalid:
        return None
    out = bytearray(groups * 3)
    out[0::3] = bytes([v >> 16 for v in values])
    out[1::3] = bytes([v >> 8 & 255 for v in values])
    out[2::3] = bytes([v & 255 for v in values])
    return bytes(out[:groups * 3 - padding])


n = int(sys.argv[1]) if len(sys.argv) > 1 else 1000
data = generate(n)
text = encode(data)
sys.stdout.buffer.write(b"encoded %d bytes, checksum %d\n" % (len(text), sum(text)))
back = decode(text)
sys.stdout.buffer.write(b"decoded %d bytes, %s\n" % (len(back) if back is not None else 0, b"same" if back == data else b"DIFFERENT"))

