// base64: n generated bytes encoded and decoded back; prints the encoded size, its byte sum and
// whether the round trip is exact.
#include <array>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <optional>
#include <string>
#include <vector>
#ifdef _WIN32
#include <fcntl.h>
#include <io.h>
#endif

static constexpr char alphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

static std::vector<uint8_t> generate(size_t n) {
    std::vector<uint8_t> bytes(n);
    uint32_t x = 42;
    for (auto &byte : bytes) {
        x = x * 1103515245u + 12345u;
        byte = static_cast<uint8_t>(x >> 16);
    }
    return bytes;
}

static std::string encode(const std::vector<uint8_t> &bytes) {
    size_t n = bytes.size(), whole = n / 3;
    std::string out((n + 2) / 3 * 4, '=');
    char *o = out.data();
    const uint8_t *in = bytes.data();
    for (size_t g = 0; g < whole; g++, in += 3, o += 4) {
        uint32_t v = uint32_t{in[0]} << 16 | uint32_t{in[1]} << 8 | in[2];
        o[0] = alphabet[v >> 18];
        o[1] = alphabet[v >> 12 & 63];
        o[2] = alphabet[v >> 6 & 63];
        o[3] = alphabet[v & 63];
    }
    size_t left = n - whole * 3;
    if (left > 0) {
        uint32_t v = uint32_t{in[0]} << 16;
        if (left == 2)
            v |= uint32_t{in[1]} << 8;
        o[0] = alphabet[v >> 18];
        o[1] = alphabet[v >> 12 & 63];
        if (left == 2)
            o[2] = alphabet[v >> 6 & 63];
    }
    return out;
}

// the bytes of a base64 text, or nothing when a character is not of the alphabet
static std::optional<std::vector<uint8_t>> decode(const std::string &text) {
    std::array<uint8_t, 256> values;
    values.fill(255);
    for (int i = 0; i < 64; i++)
        values[static_cast<uint8_t>(alphabet[i])] = static_cast<uint8_t>(i);
    size_t n = text.size(), padding = 0;
    while (padding < 2 && n > padding && text[n - 1 - padding] == '=')
        padding++;
    size_t groups = n / 4;
    std::vector<uint8_t> out(groups * 3 - padding);
    uint8_t bad = 0;
    for (size_t g = 0; g < groups; g++) {
        bool last = g == groups - 1;
        const uint8_t *in = reinterpret_cast<const uint8_t *>(text.data()) + g * 4;
        uint8_t a = values[in[0]], b = values[in[1]];
        uint8_t c = last && padding == 2 ? 0 : values[in[2]];
        uint8_t d = last && padding > 0 ? 0 : values[in[3]];
        bad |= a | b | c | d;
        uint32_t v = uint32_t{a} << 18 | uint32_t{b} << 12 | uint32_t{c} << 6 | d;
        size_t o = g * 3;
        out[o] = static_cast<uint8_t>(v >> 16);
        if (!last || padding < 2)
            out[o + 1] = static_cast<uint8_t>(v >> 8);
        if (!last || padding == 0)
            out[o + 2] = static_cast<uint8_t>(v);
    }
    if (bad & 128)
        return std::nullopt;
    return out;
}

int main(int argc, char **argv) {
#ifdef _WIN32
    _setmode(1, _O_BINARY); // the runner compares bytes: no CRLF translation
#endif
    size_t n = argc > 1 ? static_cast<size_t>(atoll(argv[1])) : 1000;
    std::vector<uint8_t> data = generate(n);
    std::string text = encode(data);
    long long sum = 0;
    for (char c : text)
        sum += static_cast<uint8_t>(c);
    printf("encoded %zu bytes, checksum %lld\n", text.size(), sum);
    auto back = decode(text);
    bool same = back && *back == data;
    printf("decoded %zu bytes, %s\n", back ? back->size() : 0, same ? "same" : "DIFFERENT");
    return 0;
}

