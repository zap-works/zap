M 100644 inline compiler/check/bitstypes.zap
data 7228
# FIXME: revisit this once the other half lands (0)
# A bits type (`type Status bits u8:`, spec 3.2): a type defined over an unsigned integer whose
# fields name its bits, a bool one bit (`n bool = 7`) and an unsigned integer a range of them, low
# to high, its end left out (`mode u8 = 0..3`). In memory it is the integer; the checker writes its
# uses over as the integer's bit methods (checkBitFieldMethod), so the backend sees shifts and masks:
#   s.n, s.mode              s.bit(7), s.bits(0, 3) (converted to the field's type)
#   s.n = v, s.mode = v      s = Status(s.withBit(7, v)), s = Status(s.withBits(0, 3, v))
#   Status(n = true)         Status(u8(0).withBit(7, true)): a field left out is 0

alias nodes = c.nodes
alias tys = c.types

# the declaration of t when t is a bits type, else none
fn bitsDecl(c Checker, maybeT TypeId?) NodeId?:
	t = try maybeT
	d = try tys[t].defined
	d if nodes[d].kind == nStructDecl and not nodes[d].kids.isEmpty else none

# the first bit and the count of bits field f names (count 0 when it names none: reported by
# checkBitsDecl)
fn bitsOfField(c Checker, f NodeId):
	v = nodes[f].kids[0]
	if nodes[v].kind == nInt: return (checkedLiteral(nodes[v].text) ?? 0, 1)
	if nodes[v].kind != nRange or nodes[v].kids.len != 2: return (0, 0)
	lo = nodes[nodes[v].kids[0]]
	hi = nodes[nodes[v].kids[1]]
	if lo.kind != nInt or hi.kind != nInt: return (0, 0)
	from = checkedLiteral(lo.text) ?? 0
	(from, (checkedLiteral(hi.text) ?? 0) - from)

# A bits type's base is an unsigned integer; each field a bool at one bit or an unsigned integer
# that holds its range, inside the base's width and sharing no bit with another field.
fn checkBitsDecl(mut c Checker, d NodeId):
	base = underOf(tys, c.aliasedType(d))
	if c.tKind(base) != tInt or tys[base].isSigned or tys[base].ranged or isDefined(tys, base):
		c.errorAt(nodes[d].line, nodes[d].col, compileError("BitsBase", ["{c.showTy(base)}"]))
		return
	used u64 = 0
	for f in nodes[d].kids:
		ft = c.resolveType(nodes[f].types[0])
		from, count = c.bitsOfField(f)
		line = nodes[f].line
		col = nodes[f].col
		single = nodes[nodes[f].kids[0]].kind == nInt
		holds = ft == tyBool and single or not single and c.tKind(ft) == tInt and
			not tys[ft].isSigned and not tys[ft].ranged and not isDefined(tys, ft) and
			count <= tys[ft].bits and tys[ft].bits <= tys[base].bits
		if count < 1 or not holds:
			c.errorAt(line, col, compileError("BitsField", ["{nodes[f].text}"]))
			continue
		if from < 0 or from + count > tys[base].bits:
			c.errorAt(
				line,
				col,
				compileError("BitsOutside", ["{from}..{from + count}", "{c.showTy(base)}"])
			)
			continue
		mask = (u64.wrap(-1) >> (64 - count)) << from
		if used & mask != 0:
			other = nodes[d].kids.find(c.bitsOverlap(it, mask)) ?? f
			c.errorAt(
				line,
				col,
				compileError("BitsOverlap", ["{nodes[f].text}", "{nodes[other].text}"])
			)
		used |= mask

# whether bits field f takes a bit of mask
fn bitsOverlap(c Checker, f NodeId, mask u64):
	from, count = c.bitsOfField(f)
	count >= 1 and from >= 0 and from + count <= 64 and
		((u64.wrap(-1) >> (64 - count)) << from) & mask != 0

# s.f of bits type t declared by d: s.bit(n), or s.bits(from, count) as the field's type
fn checkBitsField(mut c Checker, e NodeId, d NodeId, t TypeId, expected TypeId?) TypeId:
	f = c.kidNamed(d, nodes[e].text) ??
		return c.errorTyped(
			nodes[e].line,
			nodes[e].col,
			compileError("NoField", ["{c.showTy(t)}", "{nodes[e].text}"])
		)
	ft = c.resolveType(nodes[f].types[0])
	read = c.bitsCall(f, nodes[e].kids[0], "bit" if ft == tyBool else "bits", none)
	if ft != tyBool and not isSameType(tys, ft, underOf(tys, t)):
		conversion = newNode(
			nodes,
			nField,
			nodes[e].line,
			nodes[e].col,
			text = conversionMethod(c.showTy(ft)),
			kids = [read]
		)
		read = newNode(nodes, nCall, nodes[e].line, nodes[e].col, kids = [conversion])
	nodes[e].kind = nCall
	nodes[e].text = ""
	nodes[e].kids = nodes[read].kids.copy()
	c.checkExpr(e, expected)

# x.m(from[, count][, value]) for bits field f: m is bit or bits, or withBit or withBits given
# the value
fn bitsCall(mut c Checker, f NodeId, x NodeId, m str, value NodeId?):
	line = nodes[x].line
	col = nodes[x].col
	from, count = c.bitsOfField(f)
	callee = newNode(nodes, nField, line, col, text = m.copy(), kids = [x])
	call = newNode(nodes, nCall, line, col, kids = [callee, c.intNode(from, line, col)])
	if not m.endsWith("Bit") and m != "bit":
		nodes[call].kids.push(c.intNode(count, line, col))
	if value is value:
		nodes[call].kids.push(value)
	call

fn intNode(mut c Checker, v i64, line i64, col i64) NodeId:
	newNode(nodes, nInt, line, col, text = "{v}")

# s.f = v, s of a bits type, made s = S(s.withBit(n, v)) (or withBits), before the assignment s is
# checked; false when the target is no bits field
fn bitsAssign(mut c Checker, s NodeId):
	target = nodes[s].kids[0]
	if nodes[target].kind != nField or nodes[target].kids.len != 1 or nodes[target].text2 != "":
		return false
	obj = nodes[target].kids[0]
	t = c.placeType(obj, elements = true) ?? return false
	d = c.bitsDecl(t) ?? return false
	f = c.kidNamed(d, nodes[target].text) ?? return false
	line = nodes[s].line
	col = nodes[s].col
	m = "withBit" if c.resolveType(nodes[f].types[0]) == tyBool else "withBits"
	set = c.bitsCall(f, cloneTree(nodes, obj), m, nodes[s].kids[1])
	nodes[set].flags |= flagInternal   # the value first (irBitField)
	nodes[s].kids = [obj, c.bitsMade(d, set, line, col)]
	true

# value, of a bits type's base, as the bits type declared by d: a conversion naming it by its
# global name (aliasCalled)
fn bitsMade(mut c Checker, d NodeId, value NodeId, line i64, col i64) NodeId:
	name = newNode(nodes, nIdent, line, col, text = nodes[d].text.copy())
	nodes[name].text2 = globalAlias
	newNode(nodes, nCall, line, col, kids = [name, value])

# Status(n = true, c = false), Status(n, c) of names like the fields (as a struct's literal takes
# them), or Status(): the base's 0 with each named field set, made the bits type; false when the
# call is a conversion (one value, naming no field)
fn bitsLiteral(mut c Checker, e NodeId, d NodeId, t TypeId):
	n = c.argCount(e)
	if n == 1 and c.bitsFieldNamed(d, c.argAt(e, 0)) == none and
		nodes[c.argAt(e, 0)].kind != nNamedArg:
		return false
	line = nodes[e].line
	col = nodes[e].col
	zero = newNode(
		nodes,
		nField,
		line,
		col,
		text = conversionMethod(c.showTy(underOf(tys, t))),
		kids = [c.intNode(0, line, col)]
	)
	made = newNode(nodes, nCall, line, col, kids = [zero])
	for i in 0..n:
		arg = c.argAt(e, i)
		if c.bitsFieldNamed(d, arg) is f:
			m = "withBit" if c.resolveType(nodes[f].types[0]) == tyBool else "withBits"
			value = nodes[arg].kids[0] if nodes[arg].kind == nNamedArg else arg
			made = c.bitsCall(f, made, m, value)
		else:
			c.errorAt(
				nodes[arg].line,
				nodes[arg].col,
				compileError("NoField", ["{c.showTy(t)}", "{nodes[arg].text}"])
			)
	nodes[e].kids = [nodes[e].kids[0], made]
	true

# the field of bits type declaration d an argument names: `n = v`, or a name like the field's
fn bitsFieldNamed(c Checker, d NodeId, arg NodeId) NodeId?:
	k = nodes[arg].kind
	c.kidNamed(d, nodes[arg].text) if k == nNamedArg or k == nIdent else none

M 100644 inline compiler/check/bodyfacts.zap
data 4216
# What one walk of each function's body finds, once every body is checked, read by the two
# summaries made then: what a function changes through its parameters and in the module
# variables (effects.zap) and what it does besides its result (purity.zap). A function's record
# holds both kinds of edge of the one call graph: the functions it calls by name or as a method,
# which its changes follow, and every function it reaches, one it names as a value included,
# which what it does follows.

alias nodes = c.nodes

type FnFacts:
	fnd NodeId
	fields str[] = []   # a method's: the names of its receiver's fields
	names str[] = []   # the names its body mentions (a body that is not Zap the summary follows: none)
	calls NodeId[] = []   # the functions it calls by name or as a method (likewise)
	closureCalls bool = false   # whether it calls a function value
	placesChanged ChangeAt[] = []   # the places its body changes, in the order of the walk (effects.zap)
	own i64 = 0   # what its body does itself (purity.zap's bits)
	reaches NodeId[] = []   # the functions it calls or names as a value
	keeps i64 = doesUnknown   # what of theirs it does too
	memory bool = false   # a memory root: its calls are on no cycle

# every function's and method's record, in the order of the declarations, the bodies walked on
# the first call (but those whose records the kept stages kept: keptfacts.zap); a summary takes
# them while it reads them and gives them back (c.facts)
fn takeFacts(mut c Checker) FnFacts[]:
	if not c.factsMade:
		mod = c.curMod
		file = c.curFile.copy()
		out = []
		for d in c.decls:
			k = nodes[d].kind
			if k == nFnDecl:
				out.push(c.keptFacts.remove(d) ?? c.fnFacts(d, []))
			elif k == nImplDecl:
				fields = []
				sd = c.findTypeDecl(nodes[d].text)
				if sd is sd:
					fields.extend(nodes[sd].kids.map(nodes[it].text.copy()))   # the list is the record's own
				for m in nodes[d].kids:
					out.push(c.keptFacts.remove(m) ?? c.fnFacts(m, fields.copy()))
		c.facts = move out
		c.factsMade = true
		c.curMod = mod
		c.curFile = file
	move c.facts

# the record of fnd: an extern's by its name, a body's by one walk of it; a memory root does
# none of what makes a function impure, and allocates; running out of memory (as a loop that
# never ends) and the allocator's first call reading the trace options, a call of itself once,
# are no stop it counts
fn fnFacts(mut c Checker, fnd NodeId, move fields str[]):
	f = FnFacts(fnd, fields)
	name = c.writtenName(fnd).copy()
	if nodes[fnd].hasFlag(flagExtern):
		f.own = externDoes(name) | (doesWait if name in waitRoots else 0)
	elif not nodes[fnd].sub.isEmpty:
		c.enterModuleOf(fnd)
		seen {str: bool} = {}
		c.noteFacts(nodes[fnd].sub[0], f, seen, not c.opaqueFunction(fnd))
		f.names = seen.keys()
	if name in allocationRoots or name in freeRoots:
		f.keeps = doesAllocate | doesWait
		f.own = (f.own & f.keeps) | (doesAllocate if name in allocationRoots else 0)
		f.memory = true
	f

# what e and everything under it do themselves and the functions they reach; with changes, the
# names they mention, the functions they call and their calls of function values
fn noteFacts(mut c Checker, e NodeId, mut f FnFacts, mut seen {str: bool}, changes bool):
	if changes:
		c.noteMention(e, seen, f)
		c.noteChange(e, f.placesChanged)
	bits, d = c.nodeDoes(e)
	f.own |= bits
	if d is d and d not in f.reaches:
		f.reaches.push(d)
	for kid in nodes[e].kids:
		c.noteFacts(kid, f, seen, changes)
	for sb in nodes[e].sub:
		c.noteFacts(sb, f, seen, changes)

# the name node e mentions, the function it calls by name or as a method, its call of a function value
fn noteMention(c Checker, e NodeId, mut seen {str: bool}, mut f FnFacts):
	k = nodes[e].kind
	if k == nIdent or k == nLet:
		seen[nodes[e].text.copy()] = true
	if k != nCall: return
	if nodes[e].hasFlag(flagClosure):
		f.closureCalls = true
		return
	if c.calledDecl(e) is d and d not in f.calls:
		f.calls.push(d)

# the function a call by name or as a method names, or none
fn calledDecl(c Checker, e NodeId):
	callee = nodes[e].kids[0]
	if nodes[callee].kind == nIdent: return c.findFunc(nodes[callee].text)
	if nodes[callee].kind == nField: return c.calledMethod(callee)
	none

M 100644 inline compiler/check/bounds.zap
data 21248
# Bounds of type parameters: `fn max<T Ord + Copy>(a T, b T) T`. The built-in bounds are Eq (== and
# !=), Ord (Eq and the orderings), Hash (Eq and a map key, hash()), Num (Ord, Show, arithmetic,
# unary minus, number literals, Copy), Show (print and interpolation) and Copy (plain data: a
# value copies where it is used, as an i64 does; a T without it owns memory); a program declares others,
# each a list of functions taking the type first (`bound Drawable` with `fn draw(mut self
# Drawable, mut r Renderer)` and `fn bounds(self Drawable) Rect` on its lines): a type has the
# bound when it has those functions (its methods, or functions taking it first that its module
# or the caller's imports hold), with those parameters and results, and a generic calls on a
# parameter with such a bound those only (monomorphized: each instance calls its type's own). A bound is written by its name, or a module's by alias.Name. A type parameter
# is used only through its bounds, checked on both sides of a generic:
#   - at the definition, before anything instantiates it, the body is checked once with each
#     type parameter standing for an opaque type of its own (a copy of i64 that equals no other
#     type) with only what its bounds give, and copy() and move; any other use is an error there.
#     The ownership analysis runs there too, a T owning memory unless it is Copy, so what a T
#     copies or moves is decided once: an instance, a copy of the body of its own,
#     is checked once with its types and reports nothing;
#   - at every instance, the types given must satisfy the bounds: the error is at the call,
#     not inside the body. The instances of a generic whose definition failed are not checked.

alias nodes = c.nodes
alias tys = c.types

pub boundNames = ["Eq", "Ord", "Hash", "Num", "Show", "Copy"]

# the bounds written for a type parameter ("Ord+Hash") as a list
fn boundList(text str):
	if text == "": return []
	text.split("+")

# whether a parameter declared with `have` may be used where `need` is required
fn boundImplies(have str[], need str):
	for b in have:
		if b == need: return true
		if need == "Eq" and (b in ["Ord", "Hash", "Num"]): return true
		if need == "Ord" and b == "Num": return true
		if (need == "Show" or need == "Copy") and b == "Num": return true
	false

# the stand-in of a type parameter in the definition check, or -1
fn standInIndex(c Checker, maybeT TypeId?):
	t = maybeT ?? return -1
	if tys[t].param == "": return -1
	(c.aliasTy.indexOf(t) ?? -1)

# the types == compares with the operator itself: numbers, bool, str, enums without values
pub fn isEqNative(c Checker, t TypeId) bool:
	k = c.tKind(t)
	if k == tRef:
		return c.isEqNative(innerOf(tys, t))   # == compares what the references point to
	if k == tEnum: return not c.enumCarries(t)
	k in [tInt, tFloat, tBool, tStr, tError, tUnit]

# whether some variant of enum t carries values
pub fn enumCarries(c Checker, t TypeId) bool:
	nodes[declOf(tys, t)].kids.any(not nodes[it].kids.isEmpty)

# whether == compares values of type t: the native ones, and structs, tuples, enums, lists,
# arrays and optionals made of such parts (part by part, $eqN)
pub fn typeHasEq(mut c Checker, t TypeId) bool:
	open = []
	c.hasEqIn(t, open)

fn hasEqIn(mut c Checker, maybeT TypeId?, mut open NodeId[]) bool:
	t = maybeT ?? return true
	if c.isEqNative(t): return true
	k = c.tKind(t)
	if k in [tRef, tList, tArray, tOption]: return c.hasEqIn(tys[t].inner, open)
	if k == tStruct or k == tEnum:
		d = declOf(tys, t)
		if d in open: return true
		open.push(d)
		holders NodeId[] = [d]
		if k == tEnum:
			holders = nodes[d].kids.copy()
		for h in holders:
			for f in nodes[h].kids:
				if not c.hasEqIn(c.resolveType(nodes[f].types[0]), open): return false
		return true
	false

# whether < orders values of type t: numbers and str, and tuples, lists and arrays of such
# (lexicographic, $cmpN)
pub fn typeHasOrd(mut c Checker, maybeT TypeId?) bool:
	k = c.tKind(maybeT)
	t = maybeT ?? return true
	if k in [tInt, tFloat, tStr, tError]: return true
	if k in [tRef, tList, tArray]: return c.typeHasOrd(tys[t].inner)
	if k == tStruct and tupleShown(tys[t].display) != tys[t].display:
		for f in nodes[declOf(tys, t)].kids:
			if not c.typeHasOrd(c.resolveType(nodes[f].types[0])): return false
		return true
	false

# whether the concrete type t has what the bound asks (a declared bound: see boundFailure)
fn typeSatisfies(mut c Checker, t TypeId, need str) bool:
	si = c.standInIndex(t)
	if si >= 0: return boundImplies(boundList(c.aliasBounds[si]), need)
	k = c.tKind(t)
	if k == tError: return true
	if need not in boundNames:
		return c.boundFailure(t, c.findDeclByGlobalName(nBoundDecl, need)) == ""
	if need == "Num": return k == tInt or k == tFloat
	if need == "Ord": return c.typeHasOrd(t)
	if need == "Hash": return c.isHashKey(t)
	if need == "Show": return c.isPrintable(t)
	if need == "Copy": return c.copiesFreely(t)
	c.typeHasEq(t)

# whether values of type t are map keys (Hash): integers, strings, a ref str, and structs of
# those and bools (hashed field by field, $hashN); not floats, whose == is not their bits'
pub fn isHashKey(mut c Checker, t TypeId) bool:
	if typeIsMapKey(tys, t): return true
	if c.tKind(t) != tStruct: return false
	c.fieldTypes(declOf(tys, t)).all(c.tKind(it) == tBool or c.isHashKey(it))

# a composite type compared or ordered in a generic instance: its $eqN / $cmpN written
fn noteComparison(mut c Checker, t0 TypeId, need str):
	t = t0
	while c.tKind(t) == tRef:
		t = innerOf(tys, t)   # references are compared by what they point to
	if need == "Ord" and not (c.tKind(t) == tInt or c.tKind(t) == tFloat or c.tKind(t) == tStr):
		c.noteDerive(t, deriveCmp | deriveEq)
	elif (need == "Eq" or need == "Ord") and not c.isEqNative(t):
		c.noteDerive(t, deriveEq)
	elif need == "Hash":
		c.noteHashKey(t)

# a struct used as a map key: its $hashN and $eqN written (the map's code calls hash() and ==)
pub fn noteHashKey(mut c Checker, t TypeId):
	if c.tKind(t) == tStruct:
		c.noteDerive(t, deriveHash | deriveEq)

# An operation that needs `need` on a value of type t: when t stands for a type parameter whose
# bounds do not give it, the error at the definition. A list, array, optional or reference of T
# asks it of T.
fn requireBound(mut c Checker, maybeT TypeId?, need str, what str, line i64, col i64):
	t0 = maybeT ?? return
	if c.hasBound(t0, need): return
	t = c.boundAskedOf(t0)
	si = c.standInIndex(t)
	nm = tys[t].param
	errorAt(
		c,
		line,
		col,
		compileError("NeedsBound", ["{what}", "{nm}", "{need}", "{c.aliasFn[si]}"])
	)

# whether a value of type t meets the bound: any type but a type parameter whose bounds do not
# give it (a list, array, optional or reference of T as T)
fn hasBound(c Checker, t0 TypeId, need str):
	si = c.standInIndex(c.boundAskedOf(t0))
	si < 0 or boundImplies(boundList(c.aliasBounds[si]), need)

# the type a bound is asked of: T for a list, array, optional or reference of T
fn boundAskedOf(c Checker, t0 TypeId):
	t = t0
	while c.tKind(t) in [tRef, tList, tArray, tOption] and tys[t].param == "":
		t = innerOf(tys, t)
	t

# the integer type a number parameter is declared with (<N n64>: its bound is n64), else none
fn numberBound(c Checker, bound str) TypeId?:
	t = primType(bound)
	t if c.tKind(t) == tInt else none

# the number parameter name stands for in the substitution in force (its tNum), or none
fn numberParam(c Checker, name str) TypeId?:
	t = c.substLookup(name)
	t if c.tKind(t) == tNum else none

# The type of number parameter t read as a value in a body: its integer type. An instance's
# value also gets the literal the backend reads it as (intLitOf).
fn numberValue(mut c Checker, t TypeId, line i64, col i64):
	of = innerOf(tys, t) if tys[t].inner != none else tyN64
	if tys[t].bits >= 0 and tys[t].decl == none:
		lit = newNode(nodes, nInt, line, col, text = str(tys[t].bits))
		nodes[lit].ty = of
		tys[t].decl = lit
	of

# the number T[N]'s N names: the value of the number parameter in force (a tNum), or none after
# the error
fn arraySizeNamed(mut c Checker, te NodeId):
	name = nodes[te].text.copy()
	t TypeId? = none
	if name.startsWith("$param"):
		t = TypeId(i64.parse(name[6..]) ?? i64(tyError))
	else:
		t = c.substLookup(name)
	if c.tKind(t) == tNum: return t
	if c.tKind(t) == tError: return none   # a signature resolved before its parameters are known
	c.errorAt(
		nodes[te].line,
		nodes[te].col,
		compileError("LengthNotNumberParameter", ["{name}"])
	)
	none

# the arguments of generic tmpl with each number given a number parameter of its type (the type
# its value reads as in the instance's body)
fn numberArgs(mut c Checker, tmpl NodeId, args TypeId[]):
	out = args.copy()
	for i in 0..args.len:
		if i >= nodes[tmpl].bounds().len: continue
		nb = c.numberBound(nodes[tmpl].bounds()[i])
		if nb != none and c.tKind(args[i]) == tNum and tys[args[i]].param == "" and
			innerOf(tys, args[i]) != nb:
			out[i] = tyNum(tys, tys[args[i]].bits, nb)
	out

# why type argument t does not fit a parameter of bound (a number parameter's value that is no
# number or out of its type, a number for a type parameter), else ""
fn numberArgFailure(mut c Checker, bound str, t TypeId):
	isNum = c.tKind(t) == tNum
	nb = c.numberBound(bound) ?? return "the number {c.showTy(t)} is no type" if isNum else ""
	if c.tKind(t) == tError or isNum and tys[t].param != "": return ""
	if not isNum: return "{c.showTy(t)} is no {c.showTy(nb)} value"
	lo, hi = intBounds(tys, nb)
	if tys[t].bits < lo or tys[t].bits > hi: return "{tys[t].bits} is no {c.showTy(nb)}"
	""

# the instance's types against the template's bounds; false (an error at the site) when one
# does not satisfy them
# The bounds the type arguments of tmpl fail, each "i64 is not Eq, required by T" (the caller
# names the template when it reports them); a bound met notes the comparisons it needs.
fn instanceBoundFailures(mut c Checker, tmpl NodeId, types TypeId[]):
	out = []
	for i in 0..types.len:
		if i >= nodes[tmpl].bounds().len: continue
		numberWhy = c.numberArgFailure(nodes[tmpl].bounds()[i], types[i])
		if numberWhy != "":
			out.push("{numberWhy}, required by {nodes[tmpl].names[i]}")
			continue
		if c.numberBound(nodes[tmpl].bounds()[i]) != none: continue
		for need in boundList(nodes[tmpl].bounds()[i]):
			if need not in boundNames and c.standInIndex(types[i]) < 0:
				bd = c.findDeclByGlobalName(nBoundDecl, need)
				why = c.boundFailure(types[i], bd)
				if why != "":
					out.push("{c.showTy(types[i])} is not {c.shownBound(need)} ({why}), required by {nodes[tmpl].names[i]}")
			elif not c.typeSatisfies(types[i], need):
				out.push("{c.showTy(types[i])} is not {need}, required by {nodes[tmpl].names[i]}")
			elif c.standInIndex(types[i]) < 0:
				c.noteComparison(types[i], need)
	out

# every written bound is one of the four or a declared one, which the declaration's bounds then
# name by its global name (found so from any module, as the instances check them)
fn checkBoundNames(mut c Checker):
	for decl in c.decls[c.freshDecls..]:
		d = decl
		if nodes[d].kind == nBoundDecl and nodes[d].text2 in boundNames:
			c.enterModuleOf(d)
			errorAt(
				c,
				nodes[d].line,
				nodes[d].col,
				compileError("BuiltinBoundName", ["{nodes[d].text2}"])
			)
		for b in 0..c.nodes[d].bounds().len:
			names = []
			for nm in boundList(nodes[d].bounds()[b]):
				if nm in boundNames or c.numberBound(nm) != none:
					names.push(nm.copy())
					continue
				if nm != "" and nm[0].isLower() and "." not in nm:
					c.enterModuleOf(d)
					c.errorAt(
						nodes[d].line,
						nodes[d].col,
						compileError("NumberParameterNotInteger", ["{nm}"])
					)
					names.push(nm.copy())
					continue
				if c.boundDeclNamed(d, nm) is bd:
					names.push(nodes[bd].text.copy())
				else:
					c.enterModuleOf(d)
					c.errorAt(nodes[d].line, nodes[d].col, compileError("UnknownBound", ["{nm}"]))
					names.push(nm.copy())
			nodes[d].declPart().bounds[b] = names.join("+")
	c.curMod = -1
	c.curFile = ""

# the bound declaration a bound written in declaration d names (its global name, a name of d's
# module or one it imports, alias.Name of a module it imports), or none
fn boundDeclNamed(mut c Checker, d NodeId, nm str) NodeId?:
	global = c.findDeclByGlobalName(nBoundDecl, nm)
	if global is global and nodes[global].text != nodes[global].text2:
		return global   # named already by its global name
	c.enterModuleOf(d)
	parts = nm.split(".")
	if parts.len == 2:
		return c.lookupDecl(nBoundDecl, parts[0], parts[1], nodes[d].line, nodes[d].col)
	c.lookupDecl(nBoundDecl, "", nm, nodes[d].line, nodes[d].col)

# Why the type t does not have the declared bound bd ("" when it does): each function the bound
# asks for is a method of t's or a function taking t first that t's module or the caller's
# imports hold (receiverFunctions), taking it as `mut self` as the bound's does, with parameters
# of the same modes and types and the same result.
fn boundFailure(mut c Checker, t TypeId, maybeBd NodeId?):
	k = c.tKind(t)
	bd = maybeBd ?? return ""
	if k == tError: return ""
	for want in nodes[bd].kids.copy():
		m = c.findMethod(tys[t].name, nodes[want].text) if k == tStruct or k == tEnum else none
		why = match m:
			m: c.methodFailure(t, m, want)
			none: c.functionFailure(t, want)
		if why != "": return why
	""

# why t's method m is not the bound's function want ("" when it is): a generic impl's methods
# read with the instance's types
fn methodFailure(mut c Checker, t TypeId, m NodeId, want NodeId):
	changes = c.receiverChanges(m)
	implDecl = c.findImplDecl(tys[t].name, m) ?? return c.signatureFailure(want, m, 0, changes)
	if nodes[implDecl].names2().isEmpty: return c.signatureFailure(want, m, 0, changes)
	sav = move c.subst
	c.subst = Subst(names = nodes[implDecl].names2().copy(), types = nodes[implDecl].ints().copy())
	why = c.signatureFailure(want, m, 0, changes)
	c.subst = sav
	why

# why no function taking t first is the bound's function want ("" when one is: noted in
# boundFns, where an instance's call of it finds it)
fn functionFailure(mut c Checker, t TypeId, want NodeId):
	wname = nodes[want].text.copy()
	found = c.typeFunctions(t, wname, true, typeHome = true)   # the type's own module's too
	if found.isEmpty: return "no function {wname} takes it first"
	if found.len > 1:
		return "its {wname} could be {c.moduleShown(nodes[found[0]].mod())}.{wname} or {c.moduleShown(nodes[found[1]].mod())}.{wname}"
	fd = found[0]
	sub = Subst(names = [], types = [])
	c.unify(fd, nodes[nodes[fd].kids[0]].types[0], t, sub)
	if nodes[fd].kids.any(c.teMentionsOpen(fd, nodes[it].types[0], sub.names)) or
		c.teMentionsOpen(fd, none if nodes[fd].types.isEmpty else nodes[fd].types[0], sub.names):
		return "its {wname} has type parameters its first parameter does not fix"
	sav = move c.subst
	c.subst = move sub
	why = c.signatureFailure(want, fd, 1, nodes[nodes[fd].kids[0]].ival == modeMut)
	c.subst = sav
	if why == "":
		c.boundFns["{typeMangled(tys, t)}.{wname}"] = fd
	why

# why the function f, its parameters from the from-th on (read under the checker's substitution),
# is not the bound's function want ("" when it is); changes: whether f takes the value as mut self
fn signatureFailure(mut c Checker, want NodeId, f NodeId, from i64, changes bool):
	wname = nodes[want].text.copy()
	if changes != nodes[want].hasFlag(flagMut):
		return "its {wname} does not take it as mut self" if nodes[want].hasFlag(flagMut)
			else "its {wname} takes it as mut self"
	n = nodes[f].kids.len - from
	if n != nodes[want].kids.len:
		return "its {wname} takes {n} parameter(s), the bound's {nodes[want].kids.len}"
	for i in 0..c.nodes[want].kids.len:
		wp = nodes[want].kids[i]
		mp = nodes[f].kids[i + from]
		wt = c.resolveType(nodes[wp].types[0])
		mt = c.resolveType(nodes[mp].types[0])
		if nodes[wp].ival != nodes[mp].ival or not isSameType(tys, wt, mt):
			return "its {wname} takes {c.paramText(mp, mt)} where the bound's takes {c.paramText(wp, wt)}"
	wr = c.fnRetType(want)
	mr = c.fnRetType(f)
	if not isSameType(tys, wr, mr):
		return "its {wname} gives {c.showTy(mr)} where the bound's gives {c.showTy(wr)}"
	""

# a parameter as written: mut r Renderer
fn paramText(c Checker, p NodeId, t TypeId):
	mode = "mut " if nodes[p].ival == modeMut else "move " if nodes[p].ival == modeMove else ""
	"{mode}{nodes[p].text} {c.showTy(t)}"

# the declared bounds among those of a stand-in's parameter (its built-in ones left out)
fn declaredBounds(c Checker, si i64):
	boundList(c.aliasBounds[si]).filter(it not in boundNames)

# A method called on a value of a type parameter in the definition check: copy() (every type
# has it), hash() with Hash, or one its declared bounds declare; false after the error.
fn boundGivesMethod(mut c Checker, t TypeId, name str, line i64, col i64):
	si = c.standInIndex(t)
	if si < 0 or name == "copy" or name == "take": return true
	if name == "hash":
		c.requireBound(t, "Hash", "hash()", line, col)
		return true
	if c.boundMethodOf(si, name) != none: return true
	declared = c.declaredBounds(si)
	nm = tys[t].param
	if declared.isEmpty:
		c.errorAt(
			line,
			col,
			compileError("MemberNeedsBound", ["{name}", "{nm}", "{c.aliasFn[si]}"])
		)
		return false
	shown = declared.map(c.shownBound(it)).join(", ")
	c.errorAt(line, col, compileError("BoundLacksMethod", ["{nm}", "{shown}", "{name}"]))
	false

# the method name of the declared bounds of stand-in si (its declaration in the bound), or none
fn boundMethodOf(c Checker, si i64, name str) NodeId?:
	for b in c.declaredBounds(si):
		bd = c.findDeclByGlobalName(nBoundDecl, b) ?? continue
		if c.kidNamed(bd, name) is m: return m
	none

# a declared bound's name as written (its global name's declaration)
fn shownBound(c Checker, global str):
	match c.findDeclByGlobalName(nBoundDecl, global):
		bd: nodes[bd].text2.copy()
		none: global.copy()

# an opaque copy of type base standing for the type parameter nm of the function fname
fn standIn(mut c Checker, base TypeId, move nm str, move bounds str, move fname str):
	t = tys[base].copy()
	t.param = nm
	id = tyFresh(tys, t)
	c.aliasTy.push(id)
	c.aliasBounds.push(bounds)
	c.aliasFn.push(fname)
	id

# The definition check (see the top of this file) over the program's generic functions and
# impls, before anything instantiates them; the ones that fail are noted, and their instances are
# not checked again. The declarations, instances and printing functions it makes are dropped. A
# generic that needs the result of a function whose body gives it, not checked yet, is checked
# again once those bodies are.
fn checkBoundsAtDefinition(mut c Checker):
	generics = c.decls[c.freshDecls..]
		.filter(not nodes[it].names.isEmpty and nodes[it].mod() != "derive")
	while not generics.isEmpty:
		generics = c.checkDefinitions(generics)
		early = move c.earlyResults
		c.earlyResults = []
		for f in early:
			if (c.resultState.get(f) ?? -1) == resultOpen or
				(c.receiverState.get(f) ?? -1) == receiverOpen:
				c.checkOpenBody(f)

# the definition check of the generics, those that must wait for results given back
fn checkDefinitions(mut c Checker, all NodeId[]):
	# (a file's own errors would blur them: its generics are checked by their instances)
	generics = all.filter(not c.hasErrorsIn(nodes[it].file()))
	nd = c.decls.len
	ni = c.instances.len
	nderive = c.deriveTypes.len
	waiting = []
	c.atDefinition = true
	for d in generics:
		before = c.errors
		c.deferred = false
		if nodes[d].kind == nFnDecl:
			subT = c.standIns(d, d)
			c.enterScope()
			# c.subst.names holds the names while the body is checked: a list of its own
			c.subst = Subst(names = nodes[d].names.copy(), types = subT)
			c.checkFnBody(d, none, false)
			if c.errors == before and not c.deferred:
				c.checkDefinitionGives(d)   # (lowered per instance only)
			c.exitScope()
		elif nodes[d].kind == nImplDecl and c.findTypeDecl(nodes[d].text) is td:
			subT = c.standIns(d, td)
			n0 = c.decls.len
			c.programInstantiate(td, subT)
			for k in n0..c.decls.len:
				im = c.decls[k]
				if nodes[im].kind == nImplDecl and nodes[im].origin == d:
					c.checkImplMethods(im)   # the instance of d over the stand-ins
		c.receiversTried(d)
		if c.deferred:
			waiting.push(d)
		elif c.errors > before:
			c.failedGenerics.push(d)
	c.deferred = false
	c.atDefinition = false
	c.subst = Subst(names = [], types = [])
	c.truncateDecls(nd)
	c.truncateInstances(ni)
	c.deriveTypes.truncate(nderive)
	c.deriveKinds.truncate(nderive)
	c.deriveDone.truncate(nderive)
	waiting

# The stand-ins of generic d's type parameters, whose bounds the declaration bounded declares:
# each an opaque copy of i64 that has only what its bounds give.
fn standIns(mut c Checker, d NodeId, bounded NodeId):
	names = nodes[d].names.copy()
	out = []
	for p in 0..names.len:
		bounds = ""
		if p < nodes[bounded].bounds().len:
			bounds = nodes[bounded].bounds()[p].copy()
		# the stand-in records its parameter and generic's names apart from the declaration; a
		# number parameter's is a number not known (its length, where it sizes an array)
		nb = c.numberBound(bounds)
		base = tyNum(tys, -1, nb) if nb != none else tyInt(64, true)
		out.push(c.standIn(base, names[p].copy(), bounds, nodes[d].text2.copy()))
	out

M 100644 inline compiler/check/check.zap
data 17027
# Type checker, part 1: scopes, declaration lookups, type resolution and generic instantiation
# (a port of check.c). The checker annotates nodes in place: typeOf(nodes, e), global names,
# inserted nSome wrappers, lambda captures and monomorphized instances.

alias nodes = c.nodes
alias tys = c.types

# a call in an arena block: its statement and the function it calls
# the statements of a block naming each name (mutability.zap)
type Mentions:
	byName {str: i64[]} = {}

type ArenaCall:
	stmt NodeId
	decl NodeId

type Var:
	name str
	ty TypeId
	isMut bool
	used bool
# TODO: revisit this once the other half lands (3)
	isParam bool   # params and fields: exempt from the unused-variable check
	noneInit NodeId?   # declared as `x = none`: the literal whose type is fixed by the first real assignment
	literal NodeId?   # bound without mut or a type to numbers alone (`steps = 2400.0`): that value, which a use takes as its own literal would
	flexLet NodeId?   # a binding that changes, without a type, of number literals alone (`m = 0.5`): its let, which another type met later makes of it (retypeFlex)
	fromUses bool = false   # its type the one its uses gave (a retyped flexLet): a value that tells no type of its own
	lentFrom NodeId? = none   # a match arm's name for what `x.get(k)` found: that call, made getMut when the arm changes the name
	placeOf NodeId? = none   # the name a `?.` call gives its optional's value: that optional, named when a change needs it mut
	emptyInit NodeId? = none   # `x = []` (or `x T[] = []`): the literal; the first use that tells an element type fixes it
	emptyInfer TypeId? = none   # the list type that use fixes: the binding's own when written without a type, else a shadow zap fmt compares with the written one (none once nothing could tell it)
	emptyLet NodeId? = none   # the let, for zap fmt
	isField bool = false   # a field of the value a method is called on, named bare in its body
	isTest bool = false   # the value `opt is x` names: unread, the test is `opt != none`
	row i64 = -1   # a row of a Table (`r = mut ref t[i]`, a for's element): its place in Checker.rows
	narrowed bool = false   # a variable read as the narrower range a check just made proves (ranges.zap)
	lenRoot i64 = -1   # bound to the length of a list or a text: its variable (lengths.zap)
	lenPath str = ""   # and the list below that variable
	lenPlus i64 = 0   # and what is added to the length (`last = xs.len - 1`)
	line i64
	col i64

# a substitution: type parameters' names and the types they stand for, by position
type Subst:
	names str[]
	types TypeId[]

# a number method asked of a struct of numbers: the noted type, the method, its arguments' shape
# a pipeline lambda's index parameter, its row's name, row and element type
type RowParam:
	index str
	name str
	row i64
	elem TypeId

type FieldwiseAsk:
	derived i64
	method str
	shape str

type Checker:
	nodes Node[]
	decls NodeId[]
	declsByName {str: i64[]}   # global name -> positions in decls, in order
	declsByLocal {str: i64[]}   # local name -> positions in decls, in order
	layouts {NodeId: i64[]}   # a struct or variant with no type parameter in force -> its field offsets and size
	views {NodeId: bool}   # a struct declaration -> whether it is a view (isViewType)
	modules Module[]
	instances GenInst[]
	instancesAsked {i64: i64[]} = {}   # instanceKey of a generic function and its arguments -> its instances
	instancesByMangle {str: i64[]} = {}   # an instance's mangle -> its instances
	madeAsked {i64: NodeId[]} = {}   # instanceKey of a generic type and its arguments -> its instances
	types Ty[]
	file str
	errors i64
	errorsMet i64 = 0   # every errorAt, a place met twice included (resolveTypeOrNumber keeps no type that met one)
	vars Var[]   # every live variable, innermost scope last
	varIndex NameIndex = NameIndex()   # where each name stands in vars
	scopeStarts i64[]   # index into vars where each open scope begins
	currentRet TypeId?   # the result type of the function being checked
	curFn NodeId? = none   # the function whose body is being checked
	seqOk NodeId? = none   # the expression about to be checked where a Seq may stand (walked: a for's, a step's receiver)
	mapExpected TypeId? = none   # the element type a map's value is expected to have (its list's), else none
	loopDepth i64
	matchStmt bool   # the match about to be checked is a statement (block arms allowed)
	stmtExpr NodeId?   # the expression of the expression statement being checked (its value unused)
	valueTail NodeId?   # the last statement of a lambda's block, which may be its result
	implType TypeId?   # the struct whose impl block is being checked (bare method calls)
	curMod i64   # module whose code is being checked (index into modules, -1 = none)
	curFile str
	atDefinition bool   # the definition check of the generics (bounds.zap)
	failedGenerics NodeId[]   # the generic functions and impls whose definition check failed
	boundFns {str: NodeId}   # "type.name" -> the function taking the type first that met a bound's name
	boundCalls {str: NodeId} = {}   # "call type" -> the call of boundFns' function a bound's call made in an instance of that type
	aliasTy TypeId[]   # the stand-ins of type parameters in the definition check ...
	aliasBounds str[]   # ... their bounds ...
	aliasFn str[]   # ... and the generic each belongs to
	deriveTypes TypeId[]   # the types printed or encoded, $Ty0, $Ty1... (derive.zap)
	deriveKinds i64[]   # the functions wanted for each (deriveFmt | deriveJson ...)
	deriveDone i64[]   # the functions written for each
	fieldwise FieldwiseAsk[] = []
	fieldwiseDone i64 = 0
	gradAsks GradAsk[] = []   # the derivatives grad asked (grad.zap)
	gradDone i64 = 0
	gradHelpers i64[] = []   # the structs of gradients whose $gzeroN and $gaddN are asked
	gradHelpersDone i64 = 0
	gpuCode bool = false   # checking a GPU function (gpucheck.zap)
	subst Subst   # the type parameters in force and their types
	inferringRet bool   # block lambda without an expected type: the first `return` fixes the type
	inferRet TypeId?
	lamStack NodeId[]   # lambdas being checked, outermost first
	lamBounds i64[]   # the parameter scope (depth) of each lambda in lamStack
	gridLoops GridLoop[] = []   # the loops open over a grid's width or height (grid.zap)
	lambdaCount i64
	safeCallCount i64
	viewDepth i64   # nesting of isViewType (recursive types resolve their own fields)
	plainOpen NodeId[] = []   # the declarations of the types isPlainType is inside of
	lentChecks LentCheck[]   # places lent to calls that also change their owner (effects.zap)
	effects {str: str[]}   # what each function changes through its mut parameters
	reads {str: str[]} = {}   # what each function reads of a read parameter, as asked (reads.zap)
	fnEffects {NodeId: i64} = {}   # what each function does besides its result (purity.zap)
	valueEffects {str: str[]} = {}   # what a call through a function value may change in each module variable
	facts FnFacts[] = []   # what each function's body does and calls (bodyfacts.zap)
	factsMade bool = false
	keptFacts {NodeId: FnFacts} = {}   # the records the kept stages kept, taken by takeFacts
	lentDone bool   # judged: later analyses (instances the backend checks) note none
	arenaCalls ArenaCall[] = []   # the calls in arena blocks (pauseArenaGlobalCalls)
	retypes NodeId[]   # mut lets of number literals that met another type: checked again as it (retypeFlex) ...
	retypeTo TypeId[] = []   # ... that type
	relend bool = false   # a get whose value the program changes became getMut: the body is checked again
	round i64   # the round of the body being checked (checkFnBody): 0 the first
	pending PendingError[]   # the errors of the round, reported when it is not checked again
	rows TableRow[] = []   # the rows of tables the variables name (table.zap)
	liveHandles LiveHandle[] = []   # the handles known to name a value of their pool (poolwalk.zap)
	lenFacts LenFact[] = []   # the indexes known inside a list's length (lengths.zap)
	lengthNames i64 = 0   # the names bound to a length in the body being checked (lengths.zap)
	walkLets NodeId[] = []   # the lets of walks over a pool's places that bind a live handle (poolwalk.zap)
	rowParams RowParam[] = []   # (table.zap)
	rowFunctions RowFunction[] = []   # (table.zap)
	rangeTypes {str: TypeId} = {}   # the ranges arithmetic carried, by bounds (spanType)
	openBlocks NodeId[] = []   # the blocks being checked, innermost last (mutability.zap) ...
	openAt i64[] = []   # ... and the statement of each being checked
	openMentions Mentions[] = []   # ... and the statements naming each name, once made (mutability.zap) ...
	openIndexed bool[] = []   # ... whether it is made
	mutParams {str: i64} = {}   # each function name's mut parameters, a bit each (mutability.zap) ...
	mutParamsTo i64 = 0   # ... made of the declarations below this place ...
	mutParamsStage i64 = -1   # ... on the first ask of the stage whose first declaration is here
	weakExpected NodeId? = none   # the expression whose expected type only its siblings give (a list's
	# later elements, a match's later arms): no `.Variant` there
	resultState {NodeId: i64} = {}   # a function whose body gives its result -> where its check stands (results.zap)
	methodImpl {NodeId: NodeId} = {}   # such a function that is a method -> its impl
	resultMode i64 = 0   # how the body being checked gives its result (results.zap)
	tailAgain bool = false   # a trailing expression that is no value: the body again, it a statement
	trials Trial[] = []   # zap fmt's (resulttrials.zap)
	trialCopy NodeId? = none   # the copy whose trial is being made
	asideCopy NodeId? = none   # a copy checked aside (lettrials.zap): its errors counted, not said
	letTrials LetTrial[] = []   # zap fmt's (lettrials.zap)
	trialFails bool = false   # it met a form whose result the inference gives otherwise
	trialAlike bool = false   # it gave the written result
	openReturns NodeId[] = []   # the returns of `none` or `[]` before a return gave the result's type
	openTries NodeId[] = []   # the tries of a body whose result is being found, settled by it
	tryForms NodeId[] = []   # its `x ?? return none`, written `try x` when the result is an optional
	resultValue NodeId? = none   # the value of a return whose function's result is being found (its conversions stay)
	variantFns {NodeId: bool} = {}   # with zap fmt's notes on: the functions whose body notes a `.Variant`, which a dropped result would leave no enum
	resultCalls {NodeId: NodeId[]} = {}   # with zap fmt's notes on: the functions whose results a body asked
	valueOnlyErrors i64 = 0   # the errors only a value makes, not a statement (arms of different types)
	errorsKept i64 = 0   # the errors of the bodies checked in the middle of another (checkBodyNow)
	earlyResults NodeId[] = []   # the functions a generic's definition check needed the result of
	deferred bool = false   # the definition check being made needed one: made again after them
	receiverState {NodeId: i64} = {}   # a block's method whose receiver is inferred -> where its check stands (receivers.zap)
	receiverOf {NodeId: NodeId} = {}   # a copy of such a method (a generic impl's instance's) -> it
	receiverReaders {NodeId: NodeId[]} = {}   # such a method -> the bodies that read its mode
	receiverStale NodeId[] = []   # methods found changing after a body that cannot go again read them
	receiverAgain NodeId[] = []   # the bodies being checked that read a mode found otherwise later: again
	receiversOpen bool = false   # bodies may be checked when their mode is read
	receiverChanged bool = false   # the body being checked changes its receiver, read so far
	receiverSeen bool = false   # its receiver, written mut, changed as an inferred one's would be
	receiverUntold bool = false   # and changed where the inference cannot tell it (a lambda)
	changeVia bool = false   # the change being judged is a call of a method whose mode is inferred
	freshDecls i64 = 0   # the first declaration, and ...
	freshInstances i64 = 0   # ... the first instance, and ...
	freshModules i64 = 0   # ... the first module the stage being checked has to check: those before were checked by the stages before it (checkProgram)

# The checker owns the program while it works on it (see giveBack).
fn newChecker(mut prog Program):
	c = Checker(
		fnEffects = move prog.fnEffects,
		effects = move prog.effects,
		nodes = move prog.nodes,
		decls = move prog.decls,
		declsByName = {},
		declsByLocal = {},
		layouts = {},
		views = {},
		modules = move prog.modules,
		instances = move prog.instances,
		boundFns = move prog.boundFns,
		boundCalls = move prog.boundCalls,
		types = move prog.types,
		file = move prog.file,
		errors = 0,
		vars = [],
		scopeStarts = [],
		currentRet = none,
		loopDepth = 0,
		matchStmt = false,
		stmtExpr = none,
		valueTail = none,
		implType = none,
		curMod = -1,
		curFile = "",
		atDefinition = false,
		failedGenerics = [],
		aliasTy = [],
		aliasBounds = [],
		aliasFn = [],
		deriveTypes = prog.derived.copy(),
		deriveKinds = allDerived(prog.derived.len),
		deriveDone = allDerived(prog.derived.len),
		subst = Subst(names = [], types = []),
		inferringRet = false,
		inferRet = none,
		lamStack = [],
		lamBounds = [],
		lambdaCount = 0, safeCallCount = 0, viewDepth = 0, lentChecks = [], lentDone = false, retypes = [], round = 0, pending = [])
	for pos in 0..c.decls.len:
		c.indexDecl(pos)
	for i in 0..c.instances.len:
		c.indexInstance(i)
	c

# the key of a generic and the type arguments of one of its instances, by their ids: a type
# made once has one id (types.zap), so the same arguments give the same key
fn instanceKey(generic NodeId, args TypeId[]):
	h = mixIn(i64(generic), args.len)
	for t in args:
		h = mixIn(h, i64(t))
	h

fn indexInstance(mut c Checker, i i64):
	gi = c.instances[i]
	addUnder(c.instancesByMangle, gi.mangle.copy(), i)
	if not gi.asked.isEmpty:
		addUnder(c.instancesAsked, instanceKey(gi.fnDecl, gi.asked), i, once = true)

# the instance of the generic function fnd named by mangle, or none
fn findInstance(c Checker, fnd NodeId, mangle str) i64?:
	for i in c.instancesByMangle.get(mangle) ?? return none:
		if c.instances[i].fnDecl == fnd and c.instances[i].mangle == mangle: return i
	none

# ---------- the declarations by name ----------
# Every lookup by name goes through two maps kept with c.decls: addDecl and truncateDecls are
# the only changes to the list once the checker has it. A map is keyed by the name alone, the
# name the node holds (no key is made for a lookup); the few declarations of one name are told
# apart by their kind and module where they are read (firstIndexed).

fn indexDecl(mut c Checker, pos i64):
	d = c.decls[pos]
	addUnder(c.declsByName, nodes[d].text.copy(), pos)
	addUnder(c.declsByLocal, nodes[d].text2.copy(), pos)

# v pushed in place onto the list under key (made when the key is new); once: unless it is there
pub fn addUnder<K Hash>(mut index {K: i64[]}, move key K, v i64, once bool = false):
	if index.get(key) is mut at:
		if not once or v not in at:
			at.push(v)
	else:
		index[key] = [v]

fn dropPosition(mut index {str: i64[]}, key str, pos i64):
	if index.get(key) is old:
		kept = old.filter(it != pos)
		index[key.copy()] = kept

pub fn addDecl(mut c Checker, d NodeId):
	c.decls.push(d)
	c.indexDecl(c.decls.len - 1)

pub fn truncateDecls(mut c Checker, n i64):
	for pos in n..c.decls.len:
		d = c.decls[pos]
		dropPosition(c.declsByName, nodes[d].text, pos)
		dropPosition(c.declsByLocal, nodes[d].text2, pos)
	c.decls.truncate(n)
	c.madeAsked.clear()   # their instances may be among those gone

# the instances from n on dropped, with their entries in the indexes
fn truncateInstances(mut c Checker, n i64):
	c.instances.truncate(n)
	c.instancesAsked.clear()
	c.instancesByMangle.clear()
	for i in 0..n:
		c.indexInstance(i)

# the first declaration among the positions under the name that is of the kind (and, local, of
# the module)
fn firstIndexed(
	c Checker,
	index {str: i64[]},
	kind i64,
	moduleId str,
	name str,
	local bool
) NodeId?:
	match index.get(name):
		at:
			for pos in at:
				d = c.decls[pos]
				if kindMatches(nodes[d].kind, kind) and
					(
						nodes[d].mod() == moduleId and nodes[d].text2 == name if local
						else nodes[d].text == name
					):
					return d
			return none
		none: return none

# for a checker made again over a checked program: every noted type has all its functions
fn allDerived(n i64):
	fill(n, 127)

# Returns the (possibly extended) program to its owner.
fn giveBack(mut c Checker, mut prog Program):
	prog.nodes = move nodes
	prog.decls = move c.decls
	prog.modules = move c.modules
	prog.instances = move c.instances
	prog.boundFns = move c.boundFns
	prog.boundCalls = move c.boundCalls
	prog.types = move tys
	prog.derived = move c.deriveTypes
	prog.file = move c.file
	prog.fnEffects = move c.fnEffects
	prog.effects = move c.effects

fn substLookup(c Checker, name str) TypeId?:
	if c.subst.names.indexOf(name) is i: return c.subst.types[i]
	none

M 100644 inline compiler/check/checkarg.zap
data 1850
# arg(i, default): the i-th command-line argument parsed as the default's type (a number's or
# text), the default when it is missing. One given that does not parse stops the program (the
# runtime's argParsed), so a typo never runs with the default. The default is evaluated first.

alias nodes = c.nodes
alias tys = c.types

# arg(i, d) written as the runtime's functions over the text of argument i: argParsed(i,
# T.parse(argOrEmpty(i)), d) for a number T, argTextOr(i, d) for text. The type is the default's;
# a number literal there takes the type its place expects.
fn checkArg(mut c Checker, e NodeId, expected TypeId?) TypeId:
	line = nodes[e].line
	col = nodes[e].col
	if not c.expectArgs(e, "arg", 2): return tyError
	index = c.argAt(e, 0)
	if c.tKind(c.checkExpr(index, tyInt(64, true))) != tInt:
		c.errorAt(line, col, compileError("ArgIndexNotInteger", []))
		return tyError
	d = c.argAt(e, 1)
	want TypeId? = expected if c.tKind(expected) == tInt or c.tKind(expected) == tFloat else none
	t = c.heldType(c.derefIfRef(d, c.checkExpr(d, want)))
	k = c.tKind(t)
	if k == tError: return tyError
	isText = k == tStr
	if not isText and k != tInt and k != tFloat or isDefined(tys, t) or tys[t].ranged:
		c.errorAt(line, col, compileError("ArgDefaultType", ["{c.showTy(t)}"]))
		return tyError
	if isText:
		nodes[e].kids = [c.internalName("argTextOr", line, col), index, d]
		return c.checkExpr(e, expected)
	text = newNode(
		nodes,
		nCall,
		line,
		col,
		kids = [c.internalName("argOrEmpty", line, col), cloneTree(nodes, index)]
	)
	parse = newNode(
		nodes,
		nField,
		line,
		col,
		text = "parse",
		kids = [newNode(nodes, nIdent, line, col, text = c.showTy(t))]
	)
	parsed = newNode(nodes, nCall, line, col, kids = [parse, text])
	nodes[e].kids = [c.internalName("argParsed", line, col), index, parsed, d]
	c.checkExpr(e, expected)

M 100644 inline compiler/check/checkbindings.zap
data 12533
# The checker's errors, empty-list inference, scopes and variables (check.zap).

alias nodes = c.nodes
alias tys = c.types

# an error, held until the body's round ends (a round checked again reports none of its own)
fn errorAt(mut c Checker, line i64, col i64, msg str):
	c.errorsMet += 1
	if c.pending.any(p:
		p.line == line and p.col == col and p.message == msg and
			p.file == (c.file if c.curFile == "" else c.curFile)
	):
		return   # the same place twice (an arm of several patterns)
	c.pending.push(
		PendingError(
			file = (c.file if c.curFile == "" else c.curFile).copy(),
			line,
			col,
			message = msg.copy()
		)
	)
	c.errors += 1

# the inner type of t (an option's, a list's element, a map's key...), or the error type when
# it is not known yet
fn innerOrError(c Checker, t TypeId):
	inner = tys[t].inner ?? return tyError
	inner

# the variable an expression names, or -1
fn varOfExpr(mut c Checker, e NodeId) i64:
	c.lookupVar(nodes[e].text) if nodes[e].kind == nIdent else -1

# whether a type is known to its leaves (no list or optional still waiting for its inner type)
fn typeTold(c Checker, maybeT TypeId?) bool:
	t = maybeT ?? return false
	if c.tKind(t) == tList: return c.typeTold(tys[t].inner)
	if c.tKind(t) == tOption: return tys[t].inner != none and c.typeTold(tys[t].inner)
	true

# A use of a binding made from `[]` that tells its element type (a push, a place of a list type):
# told fixes the binding's type in place, every expression typed with it included. For a binding
# written with its type, inferred (what the use would tell had the type not been written, -1 for
# nothing sure) fixes the shadow zap fmt compares with the written one; -1 gives the shadow up.
fn tellEmptyList(mut c Checker, v i64, told TypeId?, inferred TypeId?):
	if v < 0: return
	t = c.vars[v].emptyInfer ?? return
	if tys[t].inner != none: return
	shadow = t != c.vars[v].ty
	known = inferred if shadow else told
	if known is elem and c.tKind(elem) != tError and c.typeTold(elem):
		tys[t].inner = c.heldType(elem)
	elif shadow:
		c.vars[v].emptyInfer = none   # the written type stays

# whether the list obj names is a `[]` binding whose written type zap fmt may drop because this use
# tells it: the use keeps its conversions (`xs.push(i64(n))`), which would otherwise tell u8 alone
fn tellsEmptyListType(mut c Checker, obj NodeId):
	v = c.varOfExpr(obj)
	v >= 0 and c.vars[v].emptyInfer != none and c.vars[v].emptyInit != none

# a use of the list e names that tells nothing of its element type, where zap fmt would have
# needed one told: the binding's written type stays
fn giveUpEmptyList(mut c Checker, e NodeId):
	c.tellEmptyList(c.varOfExpr(e), none, none)

# the error of the list e read before its element type is told, naming the local
fn untoldList(mut c Checker, e NodeId, line i64, col i64) TypeId:
	v = c.varOfExpr(e)
	named = c.vars[v].name.copy() if v >= 0 else "list"
	c.errorTyped(line, col, compileError("UntoldList", [named]))

# the type a value of type t tells on its own: t, unless the value is a number literal (an i64, a
# u8 for a byte, an f64 then), a list literal (of its first element's) or takes its type from its
# place (none); a value its place widened tells its own type
fn inferredValueType(mut c Checker, e NodeId, t TypeId) TypeId?:
	plain = c.unwidened(e)
	if plain != e: return c.inferredValueType(plain, typeOf(nodes, plain))
	k = nodes[e].kind
	if k == nIdent:
		v = c.varOfExpr(e)
		if v >= 0 and (c.vars[v].flexLet != none or c.vars[v].fromUses): return none   # its type its uses
	if c.tKind(t) == tRef or c.isOptionOfRef(t): return none   # a borrow: the place may have asked for it
	if k == nInt and nodes[e].hasFlag(flagByte): return tyInt(8, false)
	if k == nInt or k == nFloat and not floatLiteralText(nodes[e].text): return tyInt(64, true)
	if k == nFloat: return tyFloat(64)
	if k == nArray:
		if nodes[e].kids.isEmpty or c.tKind(t) != tList: return none
		first = c.inferredValueType(nodes[e].kids[0], innerOf(tys, t))
		return none if first == none else tyList(tys, first)
	if c.typeStandsAlone(e): return t
	none

# what a value of type t is as a list's element when pushed: a borrow of plain data is copied in
fn plainElement(mut c Checker, t TypeId):
	innerOf(tys, t) if c.tKind(t) == tRef and c.copiesFreely(innerOf(tys, t)) else t

# the element type a list value of type t tells on its own (inferredValueType), or none
fn inferredElemType(mut c Checker, e NodeId, t TypeId) TypeId?:
	inf = c.inferredValueType(e, t)
	innerOf(tys, inf) if c.tKind(inf) == tList else none

# `mut xs T[] = []` whose first use tells T: noted for zap fmt as `mut xs = []`
fn noteEmptyListType(mut c Checker, v Var):
	if not noting: return
	at = v.emptyLet ?? return
	line = nodes[at].line
	src = c.file if c.curFile == "" else c.curFile
	text = sourceLineOf(src, line)
	code = codeOf(text)
	eq = code.indexOf(" = []") ?? -1
	if eq < 0 or code[eq..].trimmed() != "= []": return
	before = code[..eq]
	p = before.len - before.trimmedStart().len
	if before.trimmedStart().startsWith("mut "):
		p += 4
	start = p + v.name.len
	if start >= eq or text[p..start] != v.name or text[start] != ' ' or
		not text[start..eq].trimmed().endsWith("]"):
		return
	c.canonNote(noteReplace, line, start + 1, eq - start, "")

# whether e builds a struct by its name (`Pokemon("Zapdos", 50)`), or a list whose first element
# does: a value that tells its own type
fn namesItsType(c Checker, e NodeId) bool:
	k = nodes[e].kind
	if k == nArray: return not nodes[e].kids.isEmpty and c.namesItsType(nodes[e].kids[0])
	k == nStructLit and not nodes[e].hasFlag(flagFromTuple) and
		not nodes[e].hasFlag(flagInternal) and
		nodes[e].text2 != "$rt" and nodes[e].text2 != "$named" and not c.isTupleLiteral(e)

# `mut team Pokemon[] = [Pokemon("Zapdos", 50)]`: the type written is the one the value tells,
# noted for zap fmt as `mut team = [...]`
fn noteToldType(mut c Checker, s NodeId, value NodeId, maybeT TypeId?):
	declT = maybeT ?? return
	if not noting or not c.namesItsType(value): return
	vt = typeOf(nodes, value)
	if c.tKind(declT) not in [tStruct, tList] or not isSameType(tys, vt, declT): return
	line = nodes[s].line
	src = c.file if c.curFile == "" else c.curFile
	text = sourceLineOf(src, line)
	code = codeOf(text)
	name = nodes[s].text
	p = code.len - code.trimmedStart().len
	if code[p..].startsWith("mut "):
		p += 4
	start = p + name.len
	eq = code.indexOf(" = ") ?? -1
	if eq < start or text[p..start] != name or text[start] != ' ' or eq == start: return
	# a generic's arguments may come from the annotation; the value is written, not made by the checker
	if "<" in code[start..eq]: return
	rest = code[eq + 3..].trimmedStart()
	written = rest[1..] if rest.startsWith("[") else rest
	if written.isEmpty or not (written[0] >= 'A' and written[0] <= 'Z'): return
	c.canonNote(noteReplace, line, start + 1, eq - start, "")

# t stamped on the expression e, and returned
fn typed(mut c Checker, e NodeId, t TypeId):
	nodes[e].ty = t
	t

fn showTy(c Checker, t TypeId?):
	typeStr(tys, t)

fn tKind(c Checker, maybeT TypeId?):
	t = maybeT ?? return -1
	tys[t].kind

# ---------- scopes ----------

fn enterScope(mut c Checker):
	c.scopeStarts.push(c.vars.len)

fn exitScope(mut c Checker):
	start = c.scopeStarts[len - 1]
	for i in start..c.vars.len:
		v = c.vars[i]
		if not v.used and not v.isParam and v.name != "_" and "[" not in v.name and
			"#" not in v.name:
			# (an element of a register array is not a binding of its own, and a local of a
			# loop unrolled for one may be read in some copies only)
			name = "UnreadTest" if v.isTest else "UnusedVariable"
			if c.reportsUnused(name):
				c.errorAt(v.line, v.col, compileError(name, [v.name.copy()]))
		elif tys[v.ty].kind == tOption and tys[v.ty].inner == none and v.noneInit != none:
			c.errorAt(v.line, v.col, compileError("UntypedNone", ["{v.name}"]))
		elif v.emptyInit != none and v.emptyInfer is inf and inf == v.ty and
			tys[v.ty].inner == none:
			c.errorAt(v.line, v.col, compileError("UntypedEmptyList", ["{v.name}"]))
		elif v.emptyInit != none and v.emptyInfer is inf and inf != v.ty and c.typeTold(inf) and
			isSameType(tys, tys[inf].inner, tys[v.ty].inner):
			c.noteEmptyListType(v)
	c.truncateVars(start)
	c.forgetScope()
	c.forgetLengths()
	c.scopeStarts.pop()

# the variables from start on gone, with their places in varIndex
fn truncateVars(mut c Checker, start i64):
	i = c.vars.len - 1
	while i >= start:
		c.varIndex.forgetName(c.vars[i].name)
		i -= 1
	c.vars.truncate(start)

fn recordCapture(mut c Checker, lam NodeId, vi i64):
	name = c.vars[vi].name
	if nodes[lam].names2().indexOf(name) is at:
		nodes[lam].declPart().ints[at] = c.vars[vi].ty   # checked again: this round's type
		return
	# the lambda records the captured name apart from the variable
	nodes[lam].declPart().names2.push(name.copy())
	nodes[lam].declPart().ints.push(c.vars[vi].ty)

# Finds a variable by name (innermost scope first, the first of that scope). A variable found
# beyond a lambda's parameter scope is captured by that lambda (by value).
fn lookupVar(mut c Checker, name str):
	last = c.varIndex.lastOf(name)
	if last < 0: return -1
	# the scope holding it: the last that starts at or before it
	lo = 0
	hi = c.scopeStarts.len - 1
	while lo < hi:
		mid = (lo + hi + 1) / 2
		if c.scopeStarts[mid] <= last:
			lo = mid
		else:
			hi = mid - 1
	i = c.varIndex.firstFrom(name, c.scopeStarts[lo])
	# the lambdas whose parameters' scope lies inside it capture it
	crossed = c.lamStack.len
	while crossed > 0 and c.lamBounds[crossed - 1] > lo:
		crossed -= 1
	for k in crossed..c.lamStack.len:
		c.recordCapture(c.lamStack[k], i)
	i

# True when the variable lives outside the innermost lambda being checked (so the lambda holds a copy).
fn isCapturedVar(c Checker, vi i64):
	if c.lamStack.isEmpty: return false
	bound = c.lamBounds[len - 1]
	vi < c.scopeStarts[bound]

# a captured variable the innermost lambda changes, recorded on it: a lambda that borrows what
# it captures changes the caller's variable, and the ownership pass reports one that keeps
# copies; a variable from outside two lambdas cannot change
pub fn noteCapturedChange(mut c Checker, vi i64, line i64, col i64):
	n = c.lamStack.len
	name = c.vars[vi].name.copy()
	if n > 1 and vi < c.scopeStarts[c.lamBounds[n - 2]]:
		errorAt(
			c,
			line,
			col,
			compileError("NestedLambdaChange", ["{name}"])
		)
		return
	lam = c.lamStack[n - 1]
	if name not in nodes[lam].bounds():
		nodes[lam].declPart().bounds.push(name)

fn lookupVarCurrent(c Checker, name str):
	i = c.varIndex.firstFrom(name, c.scopeStarts[len - 1])
	while i >= 0 and c.vars[i].narrowed:
		i = c.varIndex.firstFrom(name, i + 1)
	i

fn addVar(mut c Checker, name str, ty TypeId, isMut bool, isParam bool, line i64, col i64) i64:
	if name in circleWords:
		c.errorAt(line, col, compileError("LanguageConstant", [name.copy()]))
	if c.implType != none and name != "_" and c.vars.any(.isField and .name == name):
		# in a method a bare name is the field: a local or a parameter cannot take one's name
		c.errorAt(line, col, compileError("FieldNameTaken", ["{name}", "{c.showTy(c.implType)}"]))
	c.varIndex.noteName(name, c.vars.len)
	c.vars.push(
		Var(
			name = name.copy(),
			ty,
			isMut,
			used = false,
			isParam,
			noneInit = none,
			literal = none,
			flexLet = none,
			line,
			col
		)
	)
	v = c.vars.len - 1
	if name.startsWith("$ix"):
		c.addRowParam(name, line, col)
	v

# The variable e names, when it is a mut binding of float literals alone that met an f32 here
# (`mut m = 0.5` then `m * x` with x an f32): its let is noted to be checked again as an f32,
# and the mismatch is not an error. Whether it was.
fn retypeFlex(mut c Checker, e NodeId, other TypeId):
	if nodes[e].kind != nIdent: return false
	v = c.lookupVar(nodes[e].text)
	if v < 0: return false
	flex = c.vars[v].flexLet ?? return false
	to = c.flexTarget(c.vars[v].ty, other) ?? return false
	if flex not in c.retypes:
		c.retypes.push(flex)
		c.retypeTo.push(to)
	true

# the type a mutable binding of number literals alone, of type t, takes where it meets a value or
# a place of type other (spec 2.4): an f64's an f32, an i64's any other integer type
fn flexTarget(c Checker, t TypeId, other TypeId) TypeId?:
	if c.tKind(t) == tFloat and c.tKind(other) == tFloat and tys[other].bits == 32: return other
	if c.tKind(t) == tInt and c.tKind(other) == tInt and not isSameType(tys, t, other) and
		not isDefined(tys, other) and not tys[other].ranged and tys[other].param == "":
		return other
	none

M 100644 inline compiler/check/checkdecls.zap
data 15962
# The checker's lookup of declarations, runtime methods and impls (check.zap).

alias nodes = c.nodes
alias tys = c.types

# an error found in a round of a body, not reported yet
type PendingError:
	file str
	line i64
	col i64
	message str

# the round's errors reported
# whether an error was found in the file: reported, or still held
fn hasErrorsIn(c Checker, file str):
	file in filesWithErrors or c.pending.any(.file == file)

pub fn reportPending(mut c Checker):
	for e in c.pending:
		errorAtFile(e.file, e.line, e.col, e.message)
	c.pending.clear()

# ---------- declarations ----------

fn isTypeDeclKind(k i64):
	k == nStructDecl or k == nEnumDecl

fn declIsPub(c Checker, d NodeId):
	k = nodes[d].kind
	if k in [nFnDecl, nStructDecl, nEnumDecl, nConstDecl]: return nodes[d].hasFlag(flagPub)
	true

fn kindMatches(dk i64, kind i64):
	if kind == nStructDecl or kind == nEnumDecl: return isTypeDeclKind(dk)
	dk == kind

# The module alias of a name the compiler wrote: a global name, found as such from any module
# (the main module's names carry no prefix, so `Point` there is not another module's `Point`),
# and a name of the runtime (a tuple is the runtime's Tuple2 whatever the program declares).
globalAlias = "$global"
runtimeAlias = "$rt"

# FIXME: revisit this once the other half lands (6)
# global lookups (by globally unique name, as the backend sees them)
fn findTypeDecl(c Checker, name str):
	c.findDeclByGlobalName(nStructDecl, name)

fn findFunc(c Checker, name str):
	c.findDeclByGlobalName(nFnDecl, name)

# every function's and method's declaration
fn functionDecls(c Checker):
	out = []
	for d in c.decls:
		k = nodes[d].kind
		if k == nFnDecl:
			out.push(d)
		elif k == nImplDecl:
			out.extend(nodes[d].kids)
	out

# the methods of str with a rule of their own, and their runtime functions
strMethodRuntime = [
	("len", "strLen"),
	("isEmpty", "strIsEmpty"),
	("trimmed", "strTrimmed"),
	("slice", "strWindow")]

fn strMethodRt(m str):
	pairedName(strMethodRuntime, m)

# the receivers of the runtime's methods, by the prefix of their functions (listPush is xs.push)
runtimeReceivers = [
	("list", "T[]"),
	("str", "str"),
	("map", r"{K: V}"),
	("f64", "f64"),
	("f32", "f32")
]

fn capital(m str):
	m[..1].upper() + m[1..]

# the names the runtime's function of method m may have, one per receiver (listM, strM...; a str
# method of strMethodRuntime's its own)
fn rtMethodNames(m str):
	renamed = strMethodRt(m)
	names = []
	for (prefix, _) in runtimeReceivers:
		names.push(renamed.copy() if prefix == "str" and renamed != "" else prefix + capital(m))
	names

# the runtime's functions of the method m of a list, a map, a str or a float, those that exist
fn rtMethodDecls(c Checker, m str):
	out = []
	for name in rtMethodNames(m):
		if c.findDeclInModule("rt", nFnDecl, name) is d: out.push(d)
	out

# whether the method m of a list, a map or a str changes its receiver: its runtime function takes the
# receiver mut (take and intoStr move the value out of it). The one list of such methods, read
# from the runtime's declarations.
fn methodIsMutating(c Checker, m str):
	if m == "take" or m == "intoStr" or m.startsWith("store") and i64.parse(m[5..]) != none:
		return true   # (xs.store4(i, v): an intrinsic of lists)
	c.rtMethodDecls(m).any(c.takesMutFirst(it))

# whether the function fd takes its first parameter mut
fn takesMutFirst(c Checker, fd NodeId):
	not nodes[fd].kids.isEmpty and nodes[nodes[fd].kids[0]].ival == modeMut

# the runtime's function of method m of a list, a map or a str (the receiver's kind otk), or none
fn rtMethodDecl(c Checker, otk i64, m str) NodeId?:
	name = ""
	if otk == tList:
		name = "list{capital(m)}"
	elif otk == tMap:
		name = "map{capital(m)}"
	elif otk == tStr:
		name = strMethodRt(m) if strMethodRt(m) != "" else "str{capital(m)}"
	none if name == "" else c.findDeclInModule("rt", nFnDecl, name)

# whether the runtime's function of method m of a list or a map (otk) takes its parameter k `move`
fn rtTakesMove(c Checker, otk i64, m str, k i64):
	if otk != tList and otk != tMap: return false
	fd = c.rtMethodDecl(otk, m) ?? return false
	k < nodes[fd].kids.len and nodes[nodes[fd].kids[k]].ival == modeMove

# whether the method m of a List, Map or str only makes a value: a step of a pipeline but each
# and sortBy, one of the checker's own (slice, window, bytes, copy, length, lines), or the
# runtime's function that reads its receiver and gives a result
fn methodMakesValue(c Checker, m str):
	if m in pipelineSteps: return m != "sortBy"
	if m in ["slice", "window", "bytes", "copy", "len", "lines"]: return true
	c.rtMethodDecls(m).any(fd:
		not nodes[fd].kids.isEmpty and nodes[nodes[fd].kids[0]].ival != modeMut and
			not nodes[fd].types.isEmpty
	)

# whether the method m of a List, Map or str lends into its receiver: its runtime function
# returns a reference (first, get, trim...), or it is one of the checker's own forms that do
# (slice, window, bytes)
fn methodLends(c Checker, m str):
	if m in ["slice", "window", "bytes"]: return true
	# the result as written (ref T, ref T?): resolving it would need the call's T
	c
		.rtMethodDecls(m)
		.any(fd: not nodes[fd].types.isEmpty and (nodes[nodes[fd].types[0]].kind == nTyRef or
				nodes[nodes[fd].types[0]].kind == nTyOpt and
				nodes[nodes[nodes[fd].types[0]].types[0]].kind == nTyRef))

fn findDeclInModule(c Checker, moduleId str, kind i64, localName str):
	c.firstIndexed(c.declsByLocal, kind, moduleId, localName, true)

fn findDeclByGlobalName(c Checker, kind i64, name str):
	c.firstIndexed(c.declsByName, kind, "", name, false)

# The `import a.b` (qualified) declaration of module m whose alias is `alias` (a together
# check's source's, else its program's: ownModules).
fn findImportByAlias(c Checker, m i64, alias str) NodeId?:
	if m < 0: return none
	if c.modules[m].imports.find(nodes[it].text2 == alias) is imp:
		c.noteImportUse(alias)   # the file reads the module: zap fmt keeps or writes its line
		return imp
	if c.modules[m].unit: return c.findImportByAlias(moduleIndex(c.modules, ""), alias)
	none

# The modules whose declarations the module being checked sees as its own, private ones too:
# itself, and for a together check's source (loadUnits) then the test file's, whose
# declarations go before it (spec 13.1)
fn ownModules(c Checker):
	if c.curMod < 0: return [""]
	m = c.modules[c.curMod]
	[m.id.copy(), ""] if m.unit else [m.id.copy()]

# whether the error of that name is said where it is found: an unused value or binding is no
# error in a together check's source, unless its test expects that very error
fn reportsUnused(c Checker, name str):
	c.curMod < 0 or not c.modules[c.curMod].unit or c.modules[c.curMod].expects == kebabCase(name)

# (a, b) as written: the checker's struct literal of fields _0, _1... in order
fn isTupleLiteral(c Checker, maybeE NodeId?):
	e = maybeE ?? return false
	nodes[e].kind == nStructLit and not nodes[e].names.isEmpty and nodes[e].names[0] == "_0"

fn kindWord(kind i64):
	if kind == nFnDecl: return "function"
	if kind == nConstDecl: return "constant"
	if kind == nBoundDecl: return "bound"
	"type"

# Resolves a name written in the source: qualified (alias.Name, alias != "") or bare (this
# module, then the file's from-imports). A hit in another module must be `pub`. Also accepts an
# already-resolved global name, so re-checking a generic instance works. Reports nothing when not found.
fn lookupDecl(mut c Checker, kind i64, alias str, name str, line i64, col i64):
	c.declOfAlias(c.lookupDeclAsWritten(kind, alias, name, line, col))

# the declaration d, or for `type Name = T` of a struct or an enum that of T (a literal's)
fn declOfAlias(c Checker, maybeD NodeId?) NodeId?:
	d = try maybeD
	if not nodes[d].hasFlag(flagTypeAlias): return d
	# resolveTypeAliases resolved every one before
	t = nodes[d].ty
	k = kindOf(tys, t)
	declOf(tys, t) if k == tStruct or k == tEnum else d

fn lookupDeclAsWritten(mut c Checker, kind i64, alias str, name str, line i64, col i64) NodeId?:
	if alias == globalAlias: return c.findDeclByGlobalName(kind, name)
	if alias == runtimeAlias: return c.findDeclInModule("rt", kind, name)
	if kind == nStructDecl and name.startsWith("$Ty"):
		t = c.derivedTypeNamed(name)
		if t is mut t and tys[t].kind == tBox:
			t = innerOf(tys, t)
		if t is t and (tys[t].kind == tStruct or tys[t].kind == tEnum): return declOf(tys, t)
		if t is t and tys[t].kind == tInt and tys[t].defined is d: return d   # $Ty3(n)
	if alias != "":
		imp = c.findImportByAlias(c.curMod, alias) ??
			return c.noneReported(line, col, unknownModule(alias))
		d = c.findDeclInModule(nodes[imp].text, kind, name) ??
			return c.noneReported(
				line,
				col,
				compileError("NotInModule", ["{alias}", "{kindWord(kind)}", "{name}"])
			)
		if not c.declIsPub(d):
			c.errorAt(line, col, compileError("PrivateName", ["{name}", "{alias}"]))
		return d
	for own in c.ownModules():
		if c.findDeclInModule(own, kind, name) is d: return d
	if c.importedBare(kind, name) is imported: return imported
	d2 = c.findDeclByGlobalName(kind, name)
	if d2 is d2 and c.seesByGlobalName(kind, d2): return d2
	# public declarations of the runtime (types such as TcpConn) are visible everywhere; the
	# builtins keep their own typing
	if kind == nFnDecl and builtinAt(name) >= 0: return none
	r = c.findDeclInModule("rt", kind, name)
	# the code the compiler derives (printing, encoding) calls the runtime's private helpers
	if r is r and (c.declIsPub(r) or c.curMod >= 0 and c.modules[c.curMod].id == "derive"): return r
	none

# Whether a bare name that matched declaration d only by its global name means d: a name
# already resolved (a generic instance checked again). A declaration of the main module, whose
# global names carry no prefix, is not seen from another module: the runtime's `total = n` binds
# a local of its own even when the program has a module variable `total`, and the derived code's
# Cursor is the runtime's even when the program declares one (a type the compiler names for
# another module carries globalAlias).
fn seesByGlobalName(c Checker, kind i64, d NodeId):
	if c.curMod < 0 or nodes[d].text != nodes[d].text2: return true
	nodes[d].mod() in c.ownModules()

fn lookupTypeDecl(mut c Checker, alias str, name str, line i64, col i64) NodeId?:
	c.lookupDecl(nStructDecl, alias, name, line, col)

# `alias.Name` where alias is an imported module: rewrites the node into an identifier
# carrying the global name. Returns 1 when rewritten, 0 when not a module reference,
# -1 when it was a module reference that failed to resolve (already reported).
fn normalizeQualified(mut c Checker, e NodeId):
	if nodes[e].kind != nField or nodes[e].hasFlag(flagSafe): return 0
	obj = nodes[e].kids[0]
	if nodes[obj].kind != nIdent or c.lookupVar(nodes[obj].text) >= 0: return 0
	alias = nodes[obj].text
	if alias == globalAlias:
		# the code the compiler writes names any module's function by its global name
		gd = c.findDeclByGlobalName(nFnDecl, nodes[e].text) ?? return 0
		nodes[e].kind = nIdent
		nodes[e].text = nodes[gd].text.copy()
		nodes[e].text2 = globalAlias
		nodes[e].kids = []
		nodes[e].flags = 0
		return 1
	imp = c.findImportByAlias(c.curMod, alias)
	# `rt.name` is the runtime's, which a declaration of the module named the same may hide;
	# `$rt.name`, which only the compiler writes, reaches its private ones too
	compilers = alias == runtimeAlias
	if imp == none and alias != "rt" and not compilers: return 0
	name = nodes[e].text
	path = "rt"
	if imp is imp:
		path = nodes[imp].text.copy()
	found = c.findDeclInModule(path, nFnDecl, name) ??
		c.findDeclInModule(path, nStructDecl, name) ??
		c.findDeclInModule(path, nConstDecl, name)
	# both messages first: alias and name borrow the nodes changed below
	d = found ?? return c.notInModuleBare(e, alias, name, path)
	if not c.declIsPub(d) and not compilers and
		not (path == "rt" and c.curMod >= 0 and c.modules[c.curMod].std):
		errorAt(
			c,
			nodes[e].line,
			nodes[e].col,
			compileError("PrivateName", ["{name}", "{alias}"])
		)
	nodes[e].kind = nIdent
	nodes[e].text = nodes[d].text.copy()
	nodes[e].kids = []
	nodes[e].flags = 0
	1

# `alias.name` that names nothing of the module: reported, the node of the error type; -1
fn notInModuleBare(mut c Checker, e NodeId, alias str, name str, path str):
	c.errorAt(
		nodes[e].line,
		nodes[e].col,
		compileError("NotInModuleBare", ["{alias}", "{name}"])
	)
	nodes[e].ty = tyError
	-1

# the error reported at line:col, and the error type (`t = find() ?? return c.errorTyped(...)`)
fn errorTyped(mut c Checker, line i64, col i64, message str):
	c.errorAt(line, col, message)
	tyError

# the error reported at line:col, and none (`x = find() ?? return c.noneReported(...)`)
fn noneReported(mut c Checker, line i64, col i64, message str) NodeId?:
	c.errorAt(line, col, message)
	none

# The (non-template) impl of a type that holds its method m, if any: a type's methods may sit in
# several, each with its own type parameters.
# whether the impl block holding method m of typeName takes type parameters of its own
fn implIsGeneric(c Checker, typeName str, m NodeId):
	c.implIsGenericOf(c.findImplDecl(typeName, m))

# whether the impl block d, if any, takes type parameters of its own
fn implIsGenericOf(c Checker, maybeD NodeId?):
	d = maybeD ?? return false
	not nodes[d].names2().isEmpty

# the impl holding method m of typeName, when there is m
fn findImplDeclOf(c Checker, typeName str, maybeM NodeId?):
	c.findImplDecl(typeName, try maybeM)

fn findImplDecl(c Checker, typeName str, m NodeId) NodeId?:
	if typeName == "": return none
	for d in c.implsOf(typeName):
		if nodes[d].names.isEmpty and m in nodes[d].kids: return d
	none

fn findMethod(c Checker, typeName str, methodName str) NodeId?:
	for d in c.implsOf(typeName):
		for m in nodes[d].kids:
			if nodes[m].text == methodName: return m
	none

# the impls of the type named typeName, in the order of decls (found by the index by name)
fn implsOf(c Checker, typeName str) Seq<NodeId>:
	at = c.declsByName.get(typeName) ?? return
	for pos in at:
		d = c.decls[pos]
		if nodes[d].kind == nImplDecl and nodes[d].text == typeName: yield d

# the child of a declaration with that name: a variant of an enum, a field of a struct
fn kidNamed(c Checker, d NodeId, name str) NodeId?:
	nodes[d].kids.find(nodes[it].text == name)

# whether the enum d gives its variants integers (`Add = 1`: all of them or none, see the parser)
fn enumHasValues(c Checker, d NodeId):
	not nodes[d].kids.isEmpty and nodes[nodes[d].kids[0]].text2 != ""

fn fieldIndexOf(c Checker, structd NodeId, name str):
	fields = nodes[structd].kids
	fields.findIndex(nodes[it].text == name) ?? -1

# A `mut` parameter is passed by reference: a struct, a fixed array, a list or a map.
fn isMutPassable(c Checker, t TypeId):
	k = c.tKind(t)
	si = c.standInIndex(t)
	if si >= 0: return not c.declaredBounds(si).isEmpty   # a type with methods
	k in [tStruct, tArray, tList, tMap, tError]

# Switches the resolution context to the module (and file) that owns a declaration.
fn enterModuleOf(mut c Checker, d NodeId):
	c.curMod = moduleIndex(c.modules, nodes[d].mod())
	c.curFile = nodes[d].file().copy()

# The result type of a function node: as written, or as its body gives it (results.zap), else
# unit.
fn fnRetType(mut c Checker, fnd NodeId) TypeId:
	if noting: c.noteResultCall(fnd)
	if c.resultState.get(fnd) is state and not c.askResult(fnd, state): return tyError
	c.writtenResult(fnd)

fn writtenResult(mut c Checker, fnd NodeId):
	if not nodes[fnd].types.isEmpty: return c.resolveType(nodes[fnd].types[0])
	tyUnit

# ---------- type resolution ----------

fn primType(n str) TypeId?:
	if n.len < 2 or n.len > 4:
		return none   # every built-in name has 2 to 4 bytes
	c0 = n[0]
	if c0 != 'i' and c0 != 'u' and c0 != 'f' and c0 != 'b' and c0 != 's' and c0 != '(' and
		c0 != 'n':
		return none   # nor starts otherwise
	if primTypes.find(.name == n) is p: return p.id
	none

