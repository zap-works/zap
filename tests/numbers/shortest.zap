test "a double prints its shortest digits" for (bits, text) in shortest:
	expect str(f64.fromBits(bits)) == text
	expect f64.parse(text) == f64.fromBits(bits)

type Bits:
	state u64

	fn next():
		state = state * 6_364_136_223_846_793_005 + 1_442_695_040_888_963_407
		state

# whether text, a double's, has a digit too many: one fewer, rounded either way, reads back the same
fn longer(text str, x f64):
	mant, exp = splitExponent(text.replace("-", ""))
	decimals = match mant.indexOf("."):
		at: mant.len - at - 1
		none: 0
	digits = mant.replace(".", "")
	while digits.startsWith("0"):
		digits = digits[1..].copy()
	scale = exp - decimals
	while digits.endsWith("0"):
		digits = digits[..len - 1].copy()
		scale += 1
	if digits.len <= 1: return false
	head = i64.parse(digits[..len - 1]) ?? 0
	for cut in [head, head + 1]:
		if (f64.parse("{cut}e{scale + 1}") ?? 0.0) == x.abs(): return true
	false

# a float's text cut at its exponent: the digits and the exponent (0 without one)
fn splitExponent(text str):
	match text.indexOf("e"):
		at: (text[..at].copy(), i64.parse(text[at + 1..].replace("+", "")) ?? 0)
		none: (text.copy(), 0)

# of count random doubles from seed, how many do not read back or print more digits than needed
fn badDoubles(count i64, seed u64):
	bits = Bits(state = seed)
	bad = 0
	loop count:
		x = f64.fromBits(bits.next())
		if x != x or x.abs() > 1.7976931348623157e308: continue
		text = str(x)
		if f64.parse(text) != x or longer(text, x): bad += 1
	bad

a = args
count = i64.parse(a.first ?? "100000") ?? 100_000
print("{badDoubles(count, (u64.parse(a[1]) ?? 5) if a.len > 1 else 5)} of {count} doubles wrong")

test "random doubles read back, and no fewer digits do":
	expect badDoubles(1000, 5) == 0
