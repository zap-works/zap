# Huge generated functions, the shape a recompiler writes: a toy CPU's program turned into one
# function of thousands of blocks over module variables (the CPU's registers and flags), a
# dispatcher `match` over every block's address, u32 arithmetic, reads and writes of its memory,
# a trap table of 500 arms and a sparse match. The generated file also holds an interpreter of
# the same program, read from a table, and prints whether the two end in the same state. The
# suite builds a small one; a large one measures the backend (compile time, peak memory, speed):
#
#   zap run tests/ir/huge.zap [blocks] [seed]   writes build/huge/huge.zap and build/huge/huge.code
#   ZAP_RUN=memstats zap build build/huge/huge.zap
#   build/huge.exe [steps]

import fs

mut rng = Random(0)

registers = 8
traps = 500
sparseArms = 40
base = 4096

# an operation of the toy CPU: kind, register a, register b, operands x and y
type Op:
	kind i64
	a i64
	b i64
	x i64 = 0
	y i64 = 0

# the kinds of operations: 0 add, 1 sub, 2 mul, 3 xor, 4 shl, 5 shr, 6 rotl, 7 load, 8 store,
# 9 trap, 10 flags, 11 an add if zero, 12 sparse; then the terminators
opKinds = 13
endJump = 100
endLess = 101
endZero = 102

fn pick(n i64) i64:
	rng.next(0..=n - 1)

fn reg(i i64):
	"r{i}"

# the statements an operation is recompiled to, each a line at depth tabs; sums and addresses go
# through temporaries named by n, unique in the function as a recompiler names them
fn opLines(op Op, tabs str, n i64):
	ra = reg(op.a)
	rb = reg(op.b)
	match op.kind:
		0: ["{tabs}t{n} = {ra} + {rb}", "{tabs}{ra} = t{n}"]
		1: ["{tabs}{ra} = {ra} - {rb}"]
		2: ["{tabs}{ra} = {ra} * {op.x}"]
		3: ["{tabs}{ra} = {ra} ^ {op.x}"]
		4: ["{tabs}{ra} = {ra} << {op.x}"]
		5: ["{tabs}{ra} = {ra} >> {op.x}"]
		6: ["{tabs}{ra} = {ra}.rotateLeft({op.x})"]
		7: ["{tabs}a{n} = i64({rb} & 65532)", "{tabs}{ra} = mem.u32le(a{n})"]
		8: ["{tabs}store({rb}, {ra})"]
		9: ["{tabs}trap({op.x})"]
		10: ["{tabs}zero = {ra} == 0", "{tabs}carry = {ra} < {rb}"]
		11: ["{tabs}if zero:", "{tabs}\t{ra} = {ra} + 1"]
		_: ["{tabs}{ra} = sparse({rb})"]

fn randomOp():
	kind = pick(opKinds)
	a = pick(registers)
	b = pick(registers)
	x = match kind:
		2: rng.next(3..=2_000_000_001) | 1
		3: rng.next(1..=4_000_000_000)
		4, 5, 6: rng.next(1..=31)
		9: pick(traps)
		_: 0
	Op(kind, a, b, x)

# a block's terminator, to blocks of the program
fn randomEnd(n i64):
	roll = pick(100)
	if roll < 30: return Op(kind = endJump, a = 0, b = 0, x = pick(n))
	kind = endLess if roll < 65 else endZero
	Op(kind, a = pick(registers), b = pick(registers), x = pick(n), y = pick(n))

type Program:
	blocks Op[,]   # each block's operations, its terminator last
	addrs i64[]   # each block's address: rising by 4 or 8, so the dispatcher is dense but holed
	trapArms Op[]   # each trap's register (a), kind (b: 0 xor, 1 add) and constant (x)
	sparseKeys i64[]

fn newProgram(n i64):
	blocks = []
	addrs = []
	at = base
	loop n:
		ops = []
		loop rng.next(3..=9):
			ops.push(randomOp())
		ops.push(randomEnd(n))
		blocks.push(ops)
		addrs.push(at)
		at += 4 * rng.next(1..=2)
	trapArms = (0..traps).map(_:
		Op(kind = 0, a = pick(registers), b = pick(2), x = rng.next(1..=60_000))
	)
	sparseKeys = []
	key = 0
	loop sparseArms:
		key += rng.next(1..=100_000_000)
		sparseKeys.push(key)
	Program(blocks, addrs, trapArms, sparseKeys)

fn endLines(p Program, op Op):
	t = "\t\t\t\t"
	match op.kind:
		100: ["{t}pc = {p.addrs[op.x]}"]
		101: [
			"{t}if {reg(op.a)} < {reg(op.b)}:",
			"{t}\tpc = {p.addrs[op.x]}",
			"{t}else:",
			"{t}\tpc = {p.addrs[op.y]}"
		]
		_: ["{t}pc = {p.addrs[op.x]} if zero else {p.addrs[op.y]}"]

# the program's operations as numbers, a block a line: its address, then 5 numbers an operation
# (a terminator's targets as addresses)
fn codeText(p Program):
	lines = []
	for i in 0..p.blocks.len:
		parts = ["{p.addrs[i]}"]
		for op in p.blocks[i]:
			isEnd = op.kind >= endJump
			x = p.addrs[op.x] if isEnd else op.x
			y = p.addrs[op.y] if isEnd and op.kind != endJump else op.y
			parts.push("{op.kind} {op.a} {op.b} {x} {y}")
		lines.push(parts.join(" "))
	traps = p.trapArms.map("{.a} {.b} {.x}")
	lines.push("traps {traps.join(" ")}")
	lines.push("sparse {p.sparseKeys.map(str(it)).join(" ")}")
	"{lines.join("\n")}\n"

fn sourceText(p Program):
	out = ["# generated by tests/ir/huge.zap, {p.blocks.len} blocks", ""]
	for i in 0..registers:
		out.push("mut {reg(i)} u32 = 0")
	out.extend(["mut zero = false", "mut carry = false", "mut mem u8[] = []", ""])
	# registers by number, for the interpreter
	out.push("fn getR(i i64) u32:")
	out.push("\tmatch i:")
	for i in 0..registers - 1:
		out.push("\t\t{i}: {reg(i)}")
	out.extend(["\t\t_: {reg(registers - 1)}", "", "fn setR(i i64, v u32):", "\tmatch i:"])
	for i in 0..registers - 1:
		out.push("\t\t{i}: {reg(i)} = v")
	out.extend(["\t\t_: {reg(registers - 1)} = v", ""])
	out.extend(["fn trap(n i64):", "\tmatch n:"])
	for i in 0..traps:
		t = p.trapArms[i]
		r = reg(t.a)
		out.push("\t\t{i}: {r} = {r} ^ {t.x}" if t.b == 0 else "\t\t{i}: {r} = {r} + {t.x}")
	out.extend(["\t\t_: pass", ""])
	out.extend(["fn sparse(v u32) u32:", "\tmatch v:"])
	for i in 0..sparseArms:
		out.push("\t\t{p.sparseKeys[i]}: {i * 7 + 1}")
	out.extend(["\t\t_: v >> 1", ""])
	out.extend(
		[
			"fn store(a u32, v u32):",
			"	mem.setU32le(i64(a & 65532), v)",
			""
		]
	)
	# the recompiled program
	out.extend(
		[
			"fn run(start i64, limit i64) i64:",
			"\tpc = start",
			"\tsteps = 0",
			"\twhile steps < limit:",
			"\t\tsteps += 1",
			"\t\tmatch pc:"
		]
	)
	for i in 0..p.blocks.len:
		out.push("\t\t\t{p.addrs[i]}:")
		ops = p.blocks[i]
		for k in 0..ops.len - 1:
			out.extend(ops[k].opLines("\t\t\t\t", 16 * i + k))
		out.extend(p.endLines(ops[len - 1]))
	out.extend(["\t\t\t_: return -2", "\tpc", ""])
	out.push(interpreterText)
	"{out.join("\n")}\n"

# the interpreter, the reset and the comparison: the same in every generated program
interpreterText = r"""
type Code:
	ops i64[]   # 5 numbers an operation
	starts {i64: i64}   # a block's address to its first operation's index in ops
	traps i64[]   # 3 numbers a trap
	sparse i64[]

fn readCode(text str) Code:
	code = Code(ops = [], starts = {}, traps = [], sparse = [])
	for line in text.split("\n"):
		words = line.split(" ").filter(not it.isEmpty)
		if words.isEmpty: continue
		nums = []
		for w in words[1..words.len]:
			nums.push(i64.parse(w) ?? 0)
		if words[0] == "traps":
			code.traps = nums
		elif words[0] == "sparse":
			code.sparse = nums
		else:
			code.starts[i64.parse(words[0]) ?? 0] = code.ops.len
			code.ops.extend(nums)
	code

fn interpret(code Code, start i64, limit i64) i64:
	pc = start
	steps = 0
	while steps < limit:
		steps += 1
		at = code.starts.get(pc) ?? return -2
		going = true
		while going:
			kind = code.ops[at]
			a = code.ops[at + 1]
			b = code.ops[at + 2]
			x = code.ops[at + 3]
			y = code.ops[at + 4]
			at += 5
			ra = getR(a)
			rb = getR(b)
			match kind:
				0: setR(a, ra + rb)
				1: setR(a, ra - rb)
				2: setR(a, ra * u32(x))
				3: setR(a, ra ^ u32(x))
				4: setR(a, ra << u32(x))
				5: setR(a, ra >> u32(x))
				6: setR(a, ra.rotateLeft(x))
				7: setR(a, mem.u32le(i64(rb & 65532)))
				8: store(rb, ra)
				9:
					r = code.traps[3 * x]
					v = getR(r)
					k = u32(code.traps[3 * x + 2])
					setR(r, v ^ k if code.traps[3 * x + 1] == 0 else v + k)
				10:
					zero = ra == 0
					carry = ra < rb
				11:
					if zero: setR(a, ra + 1)
				12:
					s = rb >> 1
					for i in 0..code.sparse.len:
						if i64(rb) == code.sparse[i]: s = u32(i * 7 + 1)
					setR(a, s)
				100:
					pc = x
					going = false
				101:
					pc = x if ra < rb else y
					going = false
				102:
					pc = x if zero else y
					going = false
				_: return -1
	pc

fn reset():
	for i in 0..8:
		setR(i, u32(i * 2_654_435_761 % 4_294_967_291))
	zero = false
	carry = false
	mem = []
	s u32 = 12345
	loop 65536:
		s = s * 1_103_515_245 + 12345
		mem.push(u8.wrap(s >> 16))

fn state() str:
	h u64 = 14_695_981_039_346_656_037
	for i in 0..8:
		h = (h ^ u64(getR(i))) * 1_099_511_628_211
	for byte in mem:
		h = (h ^ u64(byte)) * 1_099_511_628_211
	"{h} {zero} {carry}"

limit = i64.parse(args.first ?? "20000") ?? 20000
reset()
startMs = clockMs()
ranTo = run(4096, limit)
ranMs = clockMs() - startMs
ran = state()
reset()
code = readCode(embed("huge.code"))
interpretedTo = interpret(code, 4096, limit)
interpreted = state()
if ranTo == interpretedTo and ran == interpreted:
	print("agree")
else:
	print("differ: {ranTo} {ran} against {interpretedTo} {interpreted}")
eprint("run: {ranMs} ms")
"""

# writes the program of n blocks from seed into dir
fn writeProgram(dir str, n i64, seed i64):
	rng = Random(seed)
	p = newProgram(n)
	_ = fs.createDir(dir)
	_ = fs.writeFile("{dir}/huge.code", p.codeText())
	_ = fs.writeFile("{dir}/huge.zap", p.sourceText())

a = args
blocks = i64.parse(a.first ?? "5000") ?? 5000
seed = (i64.parse(a[1]) ?? 1) if a.len > 1 else 1
writeProgram("build/huge", blocks, seed)
print("wrote build/huge/huge.zap: {blocks} blocks")

test "a recompiled program of a few hundred blocks agrees with its interpreter":
	writeProgram("{testDir()}hugetest", 300, 7)
	ran = Process.output("{zapPath()} run {testDir()}hugetest/huge.zap 30000")
	print("{ran.code} {(ran.out.lines().first ?? "").trimmed()}")   # (its timing is on stderr)
	prints "0 agree"
