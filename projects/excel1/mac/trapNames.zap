# the trap's name, or its number when it has none here
pub fn trapName(word i64) str:
	if word & 0x800 == 0:
		n = word & 0xFF
		return osNames[n].copy() if n < osNames.len else "OS trap {n:x}"
	match toolNames.get(word & 0x3FF):
		name: name.copy()
		none: "Toolbox trap {word & 0x3FF:x}"
