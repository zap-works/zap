	MenuSetting(4, "tbl_level_color", 1, 0, 4, 0, "use_custom_options", "Level color palette", "0: colors from VDUNGEON.DAT/VPALACE.DAT\n>0: colors from PRINCE.DAT.\nYou need a PRINCE.DAT from PoP 1.3 or 1.4 for this."),
	MenuSetting(4, "tbl_guard_type", 1, -1, 4, 6, "use_custom_options", "Guard type", "Guard type used in this level (normal, fat, skeleton, vizier, or shadow)."),
