	MenuSetting(4, "tbl_cutscenes_by_index", 1, 0, 15, 0, "use_custom_options", "Cutscene before level", "Cutscene that plays between the previous level and this level.\n0: none, 2 or 6: standing, 4: lying down, 8: mouse leaves,\n9: mouse returns, 12: standing or turn around"),
