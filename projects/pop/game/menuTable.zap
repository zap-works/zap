# The pause menu's settings that the options have (SDLPoP's menu.c general_settings, gameplay_settings and
# mods_settings): the section, the option, the kind (0 on/off, 1 number, 2 an action), the range, the
# names of the values, the option that must be on, the text and the explanation. Generated from
# menu.c, not edited.

pub type MenuSetting:
	section i64
	option str
	kind i64
	lo i64
	hi i64
	names i64
	required str
	text str
	explanation str

# long: a table, a setting a line
settingsTable = [
	MenuSetting(0, "enable_pause_menu", 0, 0, 0, 0, "", "Enable pause menu", "Show the in-game menu when you pause the game.\nIf disabled, you can still bring up the menu by pressing Backspace."),
	MenuSetting(0, "enable_info_screen", 0, 0, 0, 0, "", "Display info screen on launch", "Display the SDLPoP information screen when the game starts."),
	MenuSetting(0, "sound", 0, 0, 0, 0, "", "Enable sound", "Turn sound on or off."),
	MenuSetting(0, "enable_music", 0, 0, 0, 0, "", "Enable music", "Turn music on or off."),
	MenuSetting(0, "enable_controller_rumble", 0, 0, 0, 0, "", "Enable controller rumble", "If using a controller with a rumble motor, provide haptic feedback when the kid is hurt."),
	MenuSetting(0, "joystick_threshold", 1, 0, 32_767, 0, "", "Joystick threshold", "Joystick 'dead zone' sensitivity threshold."),
	MenuSetting(0, "joystick_only_horizontal", 0, 0, 0, 0, "", "Horizontal joystick movement only", "Use joysticks for horizontal movement only, not all-directional. This may make the game easier to control for some controllers."),
	MenuSetting(0, "reset", 2, 0, 0, 0, "", "Restore defaults...", "Revert all settings to the default state."),
	MenuSetting(1, "start_fullscreen", 0, 0, 0, 0, "", "Start fullscreen", "Start the game in fullscreen mode.\nYou can also toggle fullscreen by pressing Alt+Enter."),
	MenuSetting(1, "use_hardware_acceleration", 1, 0, 2, 9, "", "Use hardware acceleration", "Auto - Use hardware acceleration, if available.\nOn - Force hardware acceleration.\nOff - Disable hardware acceleration.\nNote: This requires a restart."),
	MenuSetting(1, "use_correct_aspect_ratio", 0, 0, 0, 0, "", "Use 4:3 aspect ratio", "Render the game in the originally intended 4:3 aspect ratio.\nNB. Works best using a high resolution."),
	MenuSetting(1, "use_integer_scaling", 0, 0, 0, 0, "", "Use integer scaling", "Enable pixel perfect scaling. That is, make all pixels the same size by forcing integer scale factors.\nCombining with 4:3 aspect ratio requires at least 1600x1200.\nYou need to compile with SDL 2.0.5 or newer to enable this."),
	MenuSetting(1, "scaling_type", 1, 0, 2, 10, "", "Scaling method", "Sharp - Use nearest neighbour resampling.\nFuzzy - First upscale to double size, then use smooth scaling.\nBlurry - Use smooth scaling."),
	MenuSetting(1, "enable_fade", 0, 0, 0, 0, "", "Fading enabled", "Turn fading on or off."),
	MenuSetting(1, "enable_flash", 0, 0, 0, 0, "", "Flashing enabled", "Turn flashing on or off."),
	MenuSetting(1, "enable_lighting", 0, 0, 0, 0, "", "Torch shadows enabled", "Darken those parts of the screen which are not near a torch."),
	MenuSetting(2, "cheats", 0, 0, 0, 0, "", "Enable cheats", "Turn cheats on or off."),
	MenuSetting(2, "enable_copyprot", 0, 0, 0, 0, "", "Enable copy protection level", "Enable or disable the potions (copy protection) level."),
	MenuSetting(2, "enable_quicksave", 0, 0, 0, 0, "", "Enable quicksave", "Enable quicksave/load feature.\nPress F6 to quicksave, F9 to quickload."),
	MenuSetting(2, "enable_quicksave_penalty", 0, 0, 0, 0, "", "Quicksave time penalty", "Try to let time run out when quickloading (similar to dying).\nActually, the 'remaining time' will still be restored, but a penalty (up to one minute) will be applied."),
	MenuSetting(2, "enable_replay", 0, 0, 0, 0, "", "Enable replays", "Enable recording/replay feature.\nPress Ctrl+Tab in-game to start recording.\nTo stop, press Ctrl+Tab again."),
	MenuSetting(2, "use_fixes_and_enhancements", 0, 0, 0, 0, "", "Enhanced mode (allow bug fixes)", "Turn on game fixes and enhancements.\nBelow, you can turn individual fixes/enhancements on or off.\nNOTE: Some fixes disable 'tricks' that depend on game quirks."),
	MenuSetting(2, "enable_crouch_after_climbing", 0, 0, 0, 0, "use_fixes_and_enhancements", "Enable crouching after climbing", "Adds a way to crouch immediately after climbing up: press down and forward simultaneously. In the original game, this could not be done (pressing down always causes the kid to climb down)."),
	MenuSetting(2, "enable_freeze_time_during_end_music", 0, 0, 0, 0, "use_fixes_and_enhancements", "Freeze time during level end music", "Time runs out while the level ending music plays; however, the music can be skipped by disabling sound. This option stops time while the ending music is playing (so there is no need to disable sound)."),
	MenuSetting(2, "enable_remember_guard_hp", 0, 0, 0, 0, "use_fixes_and_enhancements", "Remember guard hitpoints", "Enable guard hitpoints not resetting to their default (maximum) value when re-entering the room."),
	MenuSetting(2, "enable_super_high_jump", 0, 0, 0, 0, "use_fixes_and_enhancements", "Enable super high jump", "Prince in feather mode (after drinking a green potion) can jump 2 stories high."),
	MenuSetting(2, "enable_jump_grab", 0, 0, 0, 0, "use_fixes_and_enhancements", "Enable jump grab", "Prince can grab tiles on the floor above while jumping. Hold Shift and up arrow, but not the forward arrow key."),
	MenuSetting(2, "fix_gate_sounds", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix gate sounds bug", "If a room is linked to itself on the left, the closing sounds of the gates in that room can't be heard."),
	MenuSetting(2, "fix_two_coll_bug", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix two collisions bug", "An open gate or chomper may enable the Kid to go through walls. (Trick 7, 37, 62)"),
	MenuSetting(2, "fix_infinite_down_bug", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix infinite down bug", "If a room is linked to itself at the bottom, and the Kid's column has no floors, the game hangs."),
	MenuSetting(2, "fix_gate_drawing_bug", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix gate drawing bug", "When a gate is under another gate, the top of the bottom gate is not visible."),
	MenuSetting(2, "fix_bigpillar_climb", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix big pillar climbing bug", "When climbing up to a floor with a big pillar top behind, turned right, Kid sees through floor."),
	MenuSetting(2, "fix_jump_distance_at_edge", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix jump distance at edge", "When climbing up two floors, turning around and jumping upward, the kid falls down. This fix makes the workaround of Trick 25 unnecessary."),
	MenuSetting(2, "fix_edge_distance_check_when_climbing", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix edge distance check when climbing", "When climbing to a higher floor, the game unnecessarily checks how far away the edge below is. Sometimes you will \"teleport\" some distance when climbing from firm ground."),
	MenuSetting(2, "fix_painless_fall_on_guard", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix painless fall on guard", "Falling from a great height directly on top of guards does not hurt."),
	MenuSetting(2, "fix_wall_bump_triggers_tile_below", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix wall bump triggering tile below", "Bumping against a wall may cause a loose floor below to drop, even though it has not been touched. (Trick 18, 34)"),
	MenuSetting(2, "fix_stand_on_thin_air", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix standing on thin air", "When pressing a loose tile, you can temporarily stand on thin air by standing up from crouching."),
	MenuSetting(2, "fix_press_through_closed_gates", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix pressing through closed gates", "Buttons directly to the right of gates can be pressed even though the gate is closed (Trick 1)"),
	MenuSetting(2, "fix_grab_falling_speed", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix grab falling speed", "By jumping and bumping into a wall, you can sometimes grab a ledge two stories down (which should not be possible)."),
	MenuSetting(2, "fix_skeleton_chomper_blood", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix skeleton chomper blood", "When chomped, skeletons cause the chomper to become bloody even though skeletons do not have blood."),
	MenuSetting(2, "fix_move_after_drink", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix movement after drinking", "Controls do not get released properly when drinking a potion, sometimes causing unintended movements."),
	MenuSetting(2, "fix_loose_left_of_potion", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix loose floor left of potion", "A drawing bug occurs when a loose tile is placed to the left of a potion (or sword)."),
	MenuSetting(2, "fix_guard_following_through_closed_gates", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix guards passing closed gates", "Guards may \"follow\" the kid to the room on the left or right, even though there is a closed gate in between."),
	MenuSetting(2, "fix_safe_landing_on_spikes", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix safe landing on spikes", "When landing on the edge of a spikes tile, it is considered safe. (Trick 65)"),
	MenuSetting(2, "fix_glide_through_wall", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix gliding through walls", "The kid may glide through walls after turning around while running (especially when weightless)."),
	MenuSetting(2, "fix_drop_through_tapestry", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix dropping through tapestries", "The kid can drop down through a closed gate, when there is a tapestry (doortop) above the gate."),
	MenuSetting(2, "fix_land_against_gate_or_tapestry", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix land against gate or tapestry", "When dropping down and landing right in front of a wall, the entire landing animation should normally play. However, when falling against a closed gate or a tapestry(+floor) tile, the animation aborts."),
	MenuSetting(2, "fix_unintended_sword_strike", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix unintended sword strike", "Sometimes, the kid may automatically strike immediately after drawing the sword. This especially happens when dropping down from a higher floor and then turning towards the opponent."),
	MenuSetting(2, "fix_retreat_without_leaving_room", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix retreat without leaving room", "By repeatedly pressing 'back' in a swordfight, you can retreat out of a room without the room changing. (Trick 35)"),
	MenuSetting(2, "fix_running_jump_through_tapestry", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix running jumps through tapestries", "The kid can jump through a tapestry with a running jump to the left, if there is a floor above it."),
	MenuSetting(2, "fix_push_guard_into_wall", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix pushing guards into walls", "Guards can be pushed into walls, because the game does not correctly check for walls located behind a guard."),
	MenuSetting(2, "fix_jump_through_wall_above_gate", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix jump through wall above gate", "By doing a running jump into a wall, you can fall behind a closed gate two floors down. (e.g. skip in Level 7)"),
	MenuSetting(2, "fix_chompers_not_starting", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix chompers not starting", "If you grab a ledge that is one or more floors down, the chompers on that row will not start."),
	MenuSetting(2, "fix_feather_interrupted_by_leveldoor", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix leveldoor interrupting feather fall", "As soon as a level door has completely opened, the feather fall effect is interrupted because the sound stops."),
	MenuSetting(2, "fix_offscreen_guards_disappearing", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix offscreen guards disappearing", "Guards will often not reappear in another room if they have been pushed (partly or entirely) offscreen."),
	MenuSetting(2, "fix_move_after_sheathe", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix movement after sheathing", "While putting the sword away, if you press forward and down, and then release down, the kid will still duck."),
	MenuSetting(2, "fix_hidden_floors_during_flashing", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix hidden floors during flashing", "After uniting with the shadow in level 12, the hidden floors will not appear until after the flashing stops."),
	MenuSetting(2, "fix_hang_on_teleport", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix hang on teleport bug", "By jumping towards one of the bottom corners of the room and grabbing a ledge, you can teleport to the room above."),
	MenuSetting(2, "fix_exit_door", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix exit doors", "You can enter closed exit doors after you met the shadow or Jaffar died, or after you opened one of multiple exits."),
	MenuSetting(2, "fix_quicksave_during_feather", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix quicksave in feather mode", "You cannot save game while floating in feather mode."),
	MenuSetting(2, "fix_caped_prince_sliding_through_gate", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix sliding through closed gate", "If you are using the caped prince graphics, and crouch with your back towards a closed gate on the left edge on the room, then the prince will slide through the gate."),
	MenuSetting(2, "fix_doortop_disabling_guard", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix door top disabling guard", "Guards become inactive if they are standing on a door top (with floor), or if the prince is standing on a door top."),
	MenuSetting(2, "fix_jumping_over_guard", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix jumping over guard", "Prince can jump over guards with a properly timed running jump."),
	MenuSetting(2, "fix_drop_2_rooms_climbing_loose_tile", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix dropping 2 rooms with loose tile", "Prince can fall 2 rooms down while climbing a loose tile in a room above. (Trick 153)"),
	MenuSetting(2, "fix_falling_through_floor_during_sword_strike", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix dropping through floor striking", "Prince or guard can fall through the floor during a sword strike sequence."),
	MenuSetting(2, "fix_register_quick_input", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix fast inputs", "Input is ignored if a button or key is pressed and released between game ticks."),
	MenuSetting(2, "fix_turn_running_near_wall", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix run turning near wall", "Ensures Prince safe steps near a wall/gate when facing in an opposite direction."),
	MenuSetting(2, "fix_feather_fall_affects_guards", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix feather fall affecting guards", "Feather fall should not affect guards, because only the prince can drink the feather fall potion."),
	MenuSetting(2, "fix_one_hp_stops_blinking", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix one hit point stops blinking", "If the prince has only one hit point when he defeats Jaffar, it stops blinking."),
	MenuSetting(2, "fix_dead_floating_in_air", 0, 0, 0, 0, "use_fixes_and_enhancements", "Fix dead bodies floating in the air", "If the prince or a guard falls to his death onto a loose floor, the floor drops, but the body stays there in the air."),
	MenuSetting(3, "use_custom_options", 0, 0, 0, 0, "", "Use customization options", "Turn customization options on or off.\n(default = OFF)"),
	MenuSetting(3, "customize", 2, 0, 0, 0, "use_custom_options", "Customize level...", "Change level-specific options (such as level type, guard type, number of guard hitpoints)."),
	MenuSetting(3, "start_minutes_left", 1, -1, 32_767, 0, "use_custom_options", "Starting minutes left", "Starting minutes left. (default = 60)\nTo disable the time limit completely, set this to -1."),
	MenuSetting(3, "start_ticks_left", 1, 0, 65_535, 0, "use_custom_options", "Starting seconds left", "Starting number of seconds left in the first minute.\n(default = 59.92)"),
	MenuSetting(3, "start_hitp", 1, 0, 65_535, 0, "use_custom_options", "Starting hitpoints", "Starting hitpoints. (default = 3)"),
	MenuSetting(3, "max_hitp_allowed", 1, 0, 65_535, 0, "use_custom_options", "Max hitpoints allowed", "Maximum number of hitpoints you can get. (default = 10)"),
	MenuSetting(3, "saving_allowed_first_level", 1, 0, 16, 4, "use_custom_options", "Saving allowed: first level", "First level where you can save the game. (default = 3)"),
	MenuSetting(3, "saving_allowed_last_level", 1, 0, 16, 4, "use_custom_options", "Saving allowed: last level", "Last level where you can save the game. (default = 13)"),
	MenuSetting(3, "start_upside_down", 0, 0, 0, 0, "use_custom_options", "Start with the screen flipped", "Start the game with the screen flipped upside down, similar to Shift+I (default = OFF)"),
	MenuSetting(3, "start_in_blind_mode", 0, 0, 0, 0, "use_custom_options", "Start in blind mode", "Start in blind mode, similar to Shift+B (default = OFF)"),
	MenuSetting(3, "copyprot_level", 1, 0, 16, 4, "use_custom_options", "Copy protection before level", "The potions level will appear before this level. (default = 2)"),
	MenuSetting(3, "drawn_tile_top_level_edge", 1, 0, 31, 1, "use_custom_options", "Drawn tile: top level edge", "Tile drawn at the top of the room if there is no room that way. (default = floor)"),
	MenuSetting(3, "drawn_tile_left_level_edge", 1, 0, 31, 1, "use_custom_options", "Drawn tile: left level edge", "Tile drawn at the left of the room if there is no room that way. (default = wall)"),
	MenuSetting(3, "level_edge_hit_tile", 1, 0, 31, 1, "use_custom_options", "Level edge hit tile", "Tile behavior at the top or left of the room if there is no room that way (default = wall)"),
	MenuSetting(3, "allow_triggering_any_tile", 0, 0, 0, 0, "use_custom_options", "Allow triggering any tile", "Enable triggering any tile. For example a button could make loose floors fall, or start a stuck chomper. (default = OFF)"),
	MenuSetting(3, "enable_wda_in_palace", 0, 0, 0, 0, "use_custom_options", "Enable WDA in palace", "Enable the dungeon wall drawing algorithm in the palace.\nN.B. Use with a modified VPALACE.DAT that provides dungeon-like wall graphics! (default = OFF)"),
	MenuSetting(3, "first_level", 1, 0, 15, 0, "use_custom_options", "First level", "Level that will be loaded when starting a new game.\n(default = 1)"),
	MenuSetting(3, "skip_title", 0, 0, 0, 0, "use_custom_options", "Skip title sequence", "Always skip the title sequence: the first level will be loaded immediately.\n(default = OFF)"),
	MenuSetting(3, "shift_L_allowed_until_level", 1, 0, 16, 4, "use_custom_options", "Shift+L allowed until level", "First level where level skipping with Shift+L is denied in non-cheat mode.\n(default = 4)"),
	MenuSetting(3, "shift_L_reduced_minutes", 1, 0, 65_535, 0, "use_custom_options", "Minutes left after Shift+L used", "Number of minutes left after Shift+L is used in non-cheat mode.\n(default = 15)"),
	MenuSetting(3, "shift_L_reduced_ticks", 1, 0, 65_535, 0, "use_custom_options", "Seconds left after Shift+L used", "Number of seconds left after Shift+L is used in non-cheat mode.\n(default = 59.92)"),
	MenuSetting(3, "demo_hitp", 1, 0, 65_535, 0, "use_custom_options", "Demo level hitpoints", "Hitpoints the kid has on the demo level.\n(default = 4)"),
	MenuSetting(3, "demo_end_room", 1, 1, 24, 0, "use_custom_options", "Demo level ending room", "Demo level ending room.\n(default = 24)"),
	MenuSetting(3, "intro_music_level", 1, 0, 16, 4, "use_custom_options", "Level with intro music", "Level where the presentation music is played when the kid crouches down. (default = 1)\nNote: only works if this level is the starting level."),
	MenuSetting(3, "have_sword_from_level", 1, 1, 16, 4, "use_custom_options", "Have sword from level", "First level (except the demo level) where kid has the sword.\n(default = 2)\n"),
	MenuSetting(3, "checkpoint_level", 1, 0, 16, 4, "use_custom_options", "Checkpoint level", "Level where there is a checkpoint. (default = 3)\nThe checkpoint is triggered when leaving room 7 to the left."),
	MenuSetting(3, "checkpoint_respawn_dir", 1, -1, 0, 3, "use_custom_options", "Checkpoint respawn direction", "Respawn direction after triggering the checkpoint.\n(default = left)"),
	MenuSetting(3, "checkpoint_respawn_room", 1, 1, 24, 0, "use_custom_options", "Checkpoint respawn room", "Room where you respawn after triggering the checkpoint.\n(default = 2)"),
	MenuSetting(3, "checkpoint_respawn_tilepos", 1, 0, 29, 0, "use_custom_options", "Checkpoint respawn tile position", "Tile position (0 to 29) where you respawn after triggering the checkpoint.\n(default = 6)"),
	MenuSetting(3, "checkpoint_clear_tile_room", 1, 1, 24, 0, "use_custom_options", "Checkpoint clear tile room", "Room where a tile is cleared after respawning at the checkpoint location.\n(default = 7)"),
	MenuSetting(3, "checkpoint_clear_tile_col", 1, 0, 9, 0, "use_custom_options", "Checkpoint clear tile column", "Location (column/row) of the cleared tile after respawning at the checkpoint location.\n(default: column = 4, row = top)"),
	MenuSetting(3, "checkpoint_clear_tile_row", 1, 0, 2, 2, "use_custom_options", "Checkpoint clear tile row", "Location (column/row) of the cleared tile after respawning at the checkpoint location.\n(default: column = 4, row = top)"),
	MenuSetting(3, "skeleton_level", 1, 0, 16, 4, "use_custom_options", "Skeleton awakes level", "Level and room where a skeleton can come alive.\n(default: level = 3, room = 1)"),
	MenuSetting(3, "skeleton_room", 1, 1, 24, 0, "use_custom_options", "Skeleton awakes room", "Level and room where a skeleton can come alive.\n(default: level = 3, room = 1)"),
	MenuSetting(3, "skeleton_trigger_column_1", 1, 0, 9, 0, "use_custom_options", "Skeleton trigger column (1)", "The skeleton will wake up if the kid is on one of these two columns.\n(defaults = 2,3)"),
	MenuSetting(3, "skeleton_trigger_column_2", 1, 0, 9, 0, "use_custom_options", "Skeleton trigger column (2)", "The skeleton will wake up if the kid is on one of these two columns.\n(defaults = 2,3)"),
	MenuSetting(3, "skeleton_column", 1, 0, 9, 0, "use_custom_options", "Skeleton tile column", "Location (column/row) of the skeleton tile that will awaken.\n(default: column = 5, row = middle)"),
	MenuSetting(3, "skeleton_row", 1, 0, 2, 2, "use_custom_options", "Skeleton tile row", "Location (column/row) of the skeleton tile that will awaken.\n(default: column = 5, row = middle)"),
	MenuSetting(3, "skeleton_require_open_level_door", 0, 0, 0, 0, "use_custom_options", "Skeleton requires level door", "Whether the level door must first be opened before the skeleton awakes.\n(default = true)"),
	MenuSetting(3, "skeleton_skill", 1, 0, 15, 0, "use_custom_options", "Skeleton skill", "Skill of the awoken skeleton.\n(default = 2)"),
	MenuSetting(3, "skeleton_reappear_room", 1, 1, 24, 0, "use_custom_options", "Skeleton reappear room", "If the skeleton falls into this room, it will reappear there.\n(default = 3)"),
	MenuSetting(3, "skeleton_reappear_x", 1, 0, 255, 0, "use_custom_options", "Skeleton reappear X coordinate", "Horizontal coordinate where the skeleton reappears.\n(default = 133)\n(58 = left edge of the room, 198 = right edge)"),
	MenuSetting(3, "skeleton_reappear_row", 1, 0, 2, 2, "use_custom_options", "Skeleton reappear row", "Row on which the skeleton reappears.\n(default = middle)"),
	MenuSetting(3, "skeleton_reappear_dir", 1, -1, 0, 3, "use_custom_options", "Skeleton reappear direction", "Direction the skeleton is facing when it reappears.\n(default = right)"),
	MenuSetting(3, "mirror_level", 1, 0, 16, 4, "use_custom_options", "Mirror level", "Level and room where the mirror appears.\n(default: level = 4, room = 4)"),
	MenuSetting(3, "mirror_room", 1, 1, 24, 0, "use_custom_options", "Mirror room", "Level and room where the mirror appears.\n(default: level = 4, room = 4)"),
	MenuSetting(3, "mirror_column", 1, 0, 9, 0, "use_custom_options", "Mirror column", "Location (column/row) of the tile where the mirror appears.\n(default: column = 4, row = top)"),
	MenuSetting(3, "mirror_row", 1, 0, 2, 2, "use_custom_options", "Mirror row", "Location (column/row) of the tile where the mirror appears.\n(default: column = 4, row = top)"),
	MenuSetting(3, "mirror_tile", 1, 0, 31, 1, "use_custom_options", "Mirror tile", "Tile type that appears when the mirror should appear.\n(default = mirror)"),
	MenuSetting(3, "show_mirror_image", 0, 0, 0, 0, "use_custom_options", "Show mirror image", "Show the kid's mirror image in the mirror.\n(default = true)"),
	MenuSetting(3, "shadow_steal_level", 1, 0, 16, 4, "use_custom_options", "Shadow steal level", "Level where the shadow steals a potion.\n(default = 5)"),
	MenuSetting(3, "shadow_steal_room", 1, 1, 24, 0, "use_custom_options", "Shadow steal room", "Room where the shadow steals a potion.\n(default = 24)"),
	MenuSetting(3, "shadow_step_level", 1, 0, 16, 4, "use_custom_options", "Shadow step level", "Level where the shadow steps on a button.\n(default = 6)"),
	MenuSetting(3, "shadow_step_room", 1, 1, 24, 0, "use_custom_options", "Shadow step room", "Room where the shadow steps on a button.\n(default = 1)"),
	MenuSetting(3, "falling_exit_level", 1, 0, 16, 4, "use_custom_options", "Falling exit level", "Level where the kid can progress to the next level by falling off a specific room.\n(default = 6)"),
	MenuSetting(3, "falling_exit_room", 1, 1, 24, 0, "use_custom_options", "Falling exit room", "Room where the kid can progress to the next level by falling down.\n(default = 1)"),
	MenuSetting(3, "falling_entry_level", 1, 0, 16, 4, "use_custom_options", "Falling entry level", "If the kid starts in this level in this room, the starting room will not be shown,\nbut the room below instead, to allow for a falling entry. (default: level = 7, room = 17)"),
	MenuSetting(3, "falling_entry_room", 1, 1, 24, 0, "use_custom_options", "Falling entry room", "If the kid starts in this level in this room, the starting room will not be shown,\nbut the room below instead, to allow for a falling entry. (default: level = 7, room = 17)"),
	MenuSetting(3, "mouse_level", 1, 0, 16, 4, "use_custom_options", "Mouse level", "Level where the mouse appears.\n(default = 8)"),
	MenuSetting(3, "mouse_room", 1, 1, 24, 0, "use_custom_options", "Mouse room", "Room where the mouse appears.\n(default = 16)"),
	MenuSetting(3, "mouse_delay", 1, 0, 65_535, 0, "use_custom_options", "Mouse delay", "Number of seconds to wait before the mouse appears.\n(default = 12.5)"),
	MenuSetting(3, "mouse_object", 1, 0, 255, 0, "use_custom_options", "Mouse object", "Mouse object type. (default = 24)\nBe careful: a value not 24 will change the mouse for the kid."),
	MenuSetting(3, "mouse_start_x", 1, 0, 255, 0, "use_custom_options", "Mouse start X coordinate", "Horizontal starting coordinate of the mouse.\n(default = 200)"),
	MenuSetting(3, "loose_tiles_level", 1, 0, 16, 4, "use_custom_options", "Loose tiles level", "Level where loose floor tiles will fall down.\n(default = 13)"),
	MenuSetting(3, "loose_tiles_room_1", 1, 1, 24, 0, "use_custom_options", "Loose tiles room (1)", "Rooms where visible loose floor tiles will fall down.\n(default = 23, 16)"),
	MenuSetting(3, "loose_tiles_room_2", 1, 1, 24, 0, "use_custom_options", "Loose tiles room (2)", "Rooms where visible loose floor tiles will fall down.\n(default = 23, 16)"),
	MenuSetting(3, "loose_tiles_first_tile", 1, 0, 29, 0, "use_custom_options", "Loose tiles first tile", "Range of loose floor tile positions that will be pressed.\n(default = 22 to 27)"),
	MenuSetting(3, "loose_tiles_last_tile", 1, 0, 29, 0, "use_custom_options", "Loose tiles last tile", "Range of loose floor tile positions that will be pressed.\n(default = 22 to 27)"),
	MenuSetting(3, "jaffar_victory_level", 1, 0, 16, 4, "use_custom_options", "Jaffar victory level", "Killing the guard in this level causes the screen to flash, and event 0 to be triggered upon leaving the room.\n(default = 13)"),
	MenuSetting(3, "jaffar_victory_flash_time", 1, 0, 65_535, 0, "use_custom_options", "Jaffar victory flash time", "How long the screen will flash after killing Jaffar.\n(default = 18)"),
	MenuSetting(3, "hide_level_number_from_level", 1, 0, 16, 4, "use_custom_options", "Hide level number from level", "First level where the level number will not be displayed.\n(default = 14)"),
	MenuSetting(3, "level_13_level_number", 1, 0, 65_535, 0, "use_custom_options", "Level 13 displayed level number", "Level number displayed on level 13.\n(default = 12)"),
	MenuSetting(3, "victory_stops_time_level", 1, 0, 16, 4, "use_custom_options", "Victory stops time level", "Level where Jaffar's death stops time.\n(default = 13)"),
	MenuSetting(3, "win_level", 1, 0, 16, 4, "use_custom_options", "Level where you can win", "Level and room where you can win the game.\n(default: level = 14, room = 5)"),
	MenuSetting(3, "win_room", 1, 1, 24, 0, "use_custom_options", "Room where you can win", "Level and room where you can win the game.\n(default: level = 14, room = 5)"),
	MenuSetting(3, "loose_floor_delay", 1, 0, 127, 0, "use_custom_options", "Loose floor delay", "Number of seconds to wait before a loose floor falls.\n(default = 0.92)"),
	MenuSetting(3, "base_speed", 1, 1, 127, 0, "use_custom_options", "Base speed", "Game speed when not fighting (delay between frames in 1/60 seconds). Smaller is faster.\n(default = 5)"),
	MenuSetting(3, "fight_speed", 1, 1, 127, 0, "use_custom_options", "Fight speed", "Game speed when fighting (delay between frames in 1/60 seconds). Smaller is faster.\n(default = 6)"),
	MenuSetting(3, "chomper_speed", 1, 0, 127, 0, "use_custom_options", "Chomper speed", "Chomper speed (length of the animation cycle in frames). Smaller is faster.\n(default = 15)"),
	MenuSetting(3, "no_mouse_in_ending", 0, 0, 0, 0, "use_custom_options", "No mouse in ending", "Skip the mouse in the ending scene.\n(default = false)"),
	MenuSetting(4, "customize", 2, 0, 0, 0, "use_custom_options", "Customize another level...", "Select another level to customize."),
