# What each benchmark program does, in everyday words, one line each, in the order of the README's
# tables: shown on a problem's name in the charts.

pub type Program:
	name str
	text str

fn program(name str, text str):
	Program(name = name.copy(), text = text.copy())

pub fn programsEnglish() Program[]:
	[
		program("nbody", "Moves the planets around the Sun, step by step."),
		program("spectralNorm", "Multiplies a huge grid of numbers over and over."),
		program("fannkuchRedux", "Shuffles a deck of cards every possible way and flips them."),
		program("binaryTrees", "Builds and throws away millions of little trees of data."),
		program("fasta", "Writes millions of random DNA letters."),
		program("mandelbrot", "Draws a famous fractal picture, pixel by pixel."),
		program("kNucleotide", "Counts the short pieces that repeat in a long DNA text."),
		program("revComp", "Reads DNA backwards and swaps each letter for its pair."),
		program("nsieve", "Finds every prime number up to a few million."),
		program("matMul", "Multiplies two big tables of numbers."),
		program("base64", "Turns data into plain text and back, as email attachments do."),
		program("wordFreq", "Counts how often each word appears in a big text."),
		program("jsonRecords", "Saves a list of records as JSON text and reads it back."),
		program("dijkstra", "Finds the shortest way across a big map, as a GPS does."),
		program("raytrace", "Draws a 3D scene of balls with light and shadows."),
		program("exprTree", "Reads math expressions and works out their results."),
		program("strSort", "Puts millions of words in alphabetical order."),
		program("pidigits", "Works out the digits of pi, one by one, with huge numbers."),
		program("brainfudge", "Runs a program of a tiny eight-letter language that draws a fractal."),
		program("havlak", "Finds every loop in a huge maze of jumps, as a compiler does."),
		program("sudoku", "Solves a thousand of the hardest sudoku puzzles."),
		program("lru", "Keeps the most recently used items, dropping the oldest, millions of times."),
		program("regexRedux", "Finds and replaces patterns in a long DNA text."),
		program("coroPrimeSieve", "Finds primes with a chain of tasks passing numbers to each other."),
		program("httpJson", "A web server answering many requests with JSON and text.")
	]

pub fn programsPortuguese() Program[]:
	[
		program("nbody", "Move os planetas em volta do Sol, passo a passo."),
		program("spectralNorm", "Multiplica uma grade enorme de números, de novo e de novo."),
		program("fannkuchRedux", "Embaralha um baralho de todos os jeitos possíveis e vira as cartas."),
		program("binaryTrees", "Monta e joga fora milhões de pequenas árvores de dados."),
		program("fasta", "Escreve milhões de letras de DNA aleatórias."),
		program("mandelbrot", "Desenha um fractal famoso, pixel por pixel."),
		program("kNucleotide", "Conta os pedacinhos que se repetem num texto longo de DNA."),
		program("revComp", "Lê o DNA de trás para frente e troca cada letra pelo seu par."),
		program("nsieve", "Acha todos os números primos até alguns milhões."),
		program("matMul", "Multiplica duas tabelas grandes de números."),
		program("base64", "Transforma dados em texto e volta, como nos anexos de e-mail."),
		program("wordFreq", "Conta quantas vezes cada palavra aparece num texto grande."),
		program("jsonRecords", "Salva uma lista de registros como texto JSON e lê de volta."),
		program("dijkstra", "Acha o caminho mais curto num mapa grande, como um GPS."),
		program("raytrace", "Desenha uma cena 3D de bolas com luz e sombra."),
		program("exprTree", "Lê contas de matemática e calcula o resultado."),
		program("strSort", "Põe milhões de palavras em ordem alfabética."),
		program("pidigits", "Calcula os dígitos de pi, um por um, com números enormes."),
		program("brainfudge", "Roda um programa de uma linguagem minúscula de oito letras que desenha um fractal."),
		program("havlak", "Acha todos os laços num labirinto enorme de saltos, como um compilador faz."),
		program("sudoku", "Resolve mil dos sudokus mais difíceis."),
		program("lru", "Guarda os itens usados mais recentemente, jogando fora os mais velhos, milhões de vezes."),
		program("regexRedux", "Acha e troca padrões num texto longo de DNA."),
		program("coroPrimeSieve", "Acha primos com uma corrente de tarefas que passam números entre si."),
		program("httpJson", "Um servidor web respondendo muitos pedidos com JSON e texto.")
	]
