# The language's site: `zap run projects/site/main.zapx`, from the repository's root, writes
# projects/site/out/ (a page that sends the browser to its language, the English and Portuguese
# pages, one style.css, the logo, the projects' pictures and the charts as SVG for the README) from
# the components of
# projects/site/components. The numbers come from baselines/numbers.json every time, never copied.
# With `--publish <clone dir>`, out/ is then mirrored into that clone of the site's repository and
# committed there; the push stays by hand.

import components
import content
import readme
import webgen

source = readme.read(".") ?? exit(1, error)
mut files = [
	webgen.copy("projects/site/style.css", "style.css"),
	webgen.copy("logo.svg", "logo.svg")
]
files.extend(
	content.thumbs.values().map(webgen.copy("projects/site/thumbs/{it}.jpg", "thumbs/{it}.jpg"))
)
site = webgen.Site(
	out = "projects/site/out",
	pages = [
		webgen.page("index.html", <components.Redirect script={content.redirectScript} />.render()),
		webgen.page("en/index.html", <components.Page data={content.english().pageData(source)} />.render()),
		webgen.page("pt/index.html", <components.Page data={content.portuguese().pageData(source)} />.render())
	],
	files
)
for (path, svg) in content.english().pictures(source):
	site.pages.push(webgen.page(path, svg))
site.build() ?? exit(1, error)
print("wrote {site.out}")

match args.option("--publish"):
	clone:
		head = Process.output("git log -1 --format=%h").out.trimmedEnd()
		committed = site.publish(clone, "site from main {head}") ?? exit(1, error)
		print(
			"committed in {clone}; push it by hand" if committed
			else "{clone} holds the site already"
		)
	none: print("not published: --publish names no clone of the site's repository")
