# the byte swaps of the shuffle's last byte, in pairs
desSwaps = [0x00, 0x2b, 0x6c, 0x80, 0x01, 0x68, 0x48, 0x77, 0x60, 0xff, 0xb9, 0xc0, 0xfe, 0xeb]

# the 64 bits of block b permuted by table: bit i of the result is bit table[i] - 1 of b
fn permute64(b i64[8], table i64[]):
	out i64[8]
	for i in 0..64:
		j = table[i] - 1
		if (b[j.bits(3, 3)] & desMask[j & 7]) != 0:
			out[i.bits(3, 3)] |= desMask[i & 7]
	out

# the round function on the right half (bytes 4..8) of b: expansion, S-boxes, transposition
fn desRoundKey(b i64[8]):
	e i64[8]
	e[0] = ((b[7] << 5) | (b[4] >> 3)) & 0x3f
	e[1] = ((b[4] << 1) | (b[5] >> 7)) & 0x3f
	e[2] = ((b[4] << 5) | (b[5] >> 3)) & 0x3f
	e[3] = ((b[5] << 1) | (b[6] >> 7)) & 0x3f
	e[4] = ((b[5] << 5) | (b[6] >> 3)) & 0x3f
	e[5] = ((b[6] << 1) | (b[7] >> 7)) & 0x3f
	e[6] = ((b[6] << 5) | (b[7] >> 3)) & 0x3f
	e[7] = ((b[7] << 1) | (b[4] >> 7)) & 0x3f
	s i64[4]
	for i in 0..4:
		s[i] = (desSbox[i * 64 + e[i * 2]] & 0xf0) | (desSbox[i * 64 + e[i * 2 + 1]] & 0x0f)
	t i64[4]
	for i in 0..32:
		j = desTp[i] - 1
		if (s[j >> 3] & desMask[j & 7]) != 0:
			t[i >> 3] |= desMask[i & 7]
	t

# the block of eight bytes at `at` unscrambled
fn desDecryptBlock(mut d u8[], at i64):
	b i64[8]
	for i in 0..8:
		b[i] = d[at + i]
	x = permute64(b, desIp)
	k = desRoundKey(x)
	for i in 0..4:
		x[i] ^= k[i]
	y = permute64(x, desFp)
	for i in 0..8:
		d[at + i] = u8(y[i])

fn swappedByte(v i64):
	i = 0
	while i < desSwaps.len:
		if desSwaps[i] == v: return desSwaps[i + 1]
		if desSwaps[i + 1] == v: return desSwaps[i]
		i += 2
	v

# the block at `at` unshuffled: its bytes reordered and the last one swapped
fn desShuffleBlock(mut d u8[], at i64):
	b0 = d[at]
	b1 = d[at + 1]
	b2 = d[at + 2]
	b3 = d[at + 3]
	b4 = d[at + 4]
	b5 = d[at + 5]
	b6 = d[at + 6]
	b7 = d[at + 7]
	d[at] = b3
	d[at + 1] = b4
	d[at + 2] = b6
	d[at + 3] = b0
	d[at + 4] = b1
	d[at + 5] = b2
	d[at + 6] = b5
	d[at + 7] = u8(swappedByte(b7))

# an entry flagged "header": its first 20 blocks
pub fn decodeHeader(mut d u8[]):
	blocks = d.len >> 3
	for i in 0..20.min(blocks):
		desDecryptBlock(d, i * 8)

# an entry flagged "mixed", whose packed size is `packed`
pub fn decodeMixed(mut d u8[], packed i64):
	digits = "{packed}".len
	cycle = 1 if digits < 3
		else digits + 1 if digits < 5
		else digits + 9 if digits < 7
		else digits + 15
	blocks = d.len >> 3
	for i in 0..20.min(blocks):
		desDecryptBlock(d, i * 8)
	j = -1
	for i in 20..blocks:
		if i % cycle == 0:
			desDecryptBlock(d, i * 8)
		else:
			j += 1
			if j != 0 and j % 7 == 0:
				desShuffleBlock(d, i * 8)
