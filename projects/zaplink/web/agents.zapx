# The agents on the page: the form that asks for one, each agent's row (its state, model, turns,
# cost and last step), and an agent's steps, which the page adds to its dialog as they come.

import agents
import cards
import zapx.ui
from agents import Agent, Fleet, Step

fn stateText(a Agent):
	match a.state:
		Queued: "queued"
		Working: "working"
		Idle: "idle"
		Stopped: "stopped"

fn lastStep(fleet Fleet, a Agent):
	all = fleet.steps.get(a.id) ?? return ""
	for k in 0..all.len:
		step = all[len - 1 - k]
		if step.kind == "text" or step.kind == "tool":
			line = "{step.title} {step.text}".trimmed().lines()
			return line[0][..120.min(line[0].len)].copy() if not line.isEmpty else ""
	""

# an agent's name by its session, an open window's name, else the id's start
fn nameOf(fleet Fleet, session str):
	if fleet.find(session) is k: return fleet.agents[k].name.copy()
	if cards.sessionsRunning().find(.sessionId == session) is s: return s.name.copy()
	session[..8.min(session.len)].copy()

fn agentNode(fleet Fleet, a Agent, usage {str: (f64, i64)}):
	cpu, memory = usage.get(a.id) ?? (0.0, 0)
	used = " · {cpu:.0} cpu s · {memory / 1_048_576.0:.0} MB" if a.isRunning() else ""
	<article class="agent {a.stateText()}" tabindex="0" data-id="{a.id}" data-name="{a.name}">
		<span class="dot"></span>
		<div class="title">
			{a.name}
			<ui.Badge variant={a.stateVariant()}>{a.stateText()}</ui.Badge>
			{if a.parent != "": <ui.Badge variant="outline" classes="parent">{"started by {fleet.nameOf(a.parent)}"}</ui.Badge>}
		</div>
		<div class="size">{"{a.turns} turns · ${a.cost:.2}{used}"}</div>
		<span></span>
		<div class="sub">{[a.workOf().trimmed().copy(), fleet.lastStep(a)].filter(it != "").join(" · ")}</div>
		<div class="pulse">
			{if a.state == .Working:
				<>
					<span class="spin">✻</span>
					{" Working… "}
					<span data-t="{a.turnStart}"></span>
					{" · ↓ {tokensText(a.turnTokens)} tokens"}
				</>
			}
		</div>
		<div class="brief">
			<b>{a.name}</b>
			<span>{"{a.stateText()}{a.workOf()} · {a.turns} turns · ${a.cost:.2}"}</span>
		</div>
	</article>

# the badge of a state: a working agent's filled, a queued one's plain, the others' outlined
fn stateVariant(a Agent):
	match a.state:
		Working: "default"
		Queued: "secondary"
		_: "outline"

# what the agent works on: its card, its loop or goal
fn workOf(a Agent):
	if a.card != "": return " on {a.card}"
	if a.role != "": return " for {a.role}"
	""

# tokens as Claude Code shows them: 840, 1.2k
fn tokensText(n i64):
	"{n / 1_000.0:.1}k" if n >= 1_000 else "{n}"

fn gb(bytes i64):
	f64(bytes) / 1_073_741_824.0

# seconds as hours or minutes: 2.5 h, 40 min
fn span(seconds i64):
	"{seconds / 3_600.0:.1} h" if seconds >= 5_400 else "{seconds / 60} min"

# each window of the plan: its use, what the pace allows now, and when it runs out at the rate
# seen (before or after it resets)
fn planLines(fleet Fleet):
	now = unixSeconds()
	out = []
	for name in fleet.windows.keys():
		w = fleet.windows[name]
		allowed = w.allowed(name, fleet.settings.pace, now).min(fleet.settings.planCeiling)
		resets = (w.resetsAt - now).max(0)
		ends = match w.runsOutIn():
			secs:
				"runs out in {span(secs)} at this rate" if secs < resets
					else "lasts to the reset at this rate"
			none: "no rate yet"
		label = "5 h" if name == "five_hour" else ("7 d" if name == "seven_day" else name)
		out.push("{label} {w.use * 100.0:.0}% of {allowed * 100.0:.0}% allowed, {ends}, resets in {span(resets)}")
	if out.isEmpty: out.push("plan use not known until an agent runs")
	out

# the machine and the plan in one line, and why the queue waits when it does
fn statusNode(fleet Fleet):
	m = fleet.machine
	parts = [
		"{fleet.working()} of {fleet.settings.limit} agents",
		"CPU {m.cpu * 100.0:.0}%",
		"memory {m.memory.total.gb() - m.memory.free.gb():.1}/{m.memory.total.gb():.0} GB"
	]
	if m.gpu != "": parts.push(m.gpu.copy())
	wait = fleet.whyWait()
	queued = fleet.agents.filter(.state == .Queued).len
	<div class="status">
		{for part in parts: <ui.Badge variant="outline">{part}</ui.Badge>}
		{if queued > 0 and wait != "": <span class="wait">{"{queued} queued: {wait}"}</span>}
		<span class="planline">{"plan {fleet.planLines().join("; ")}"}</span>
	</div>

fn number(name str, label str, value f64, step str):
	<ui.Label label={label}>
		<ui.TextField name={name} kind="number" value="{value}" attrs={[attr("step", step)]} />
	</ui.Label>

fn choice(name str, label str, values str[], chosen str):
	<ui.Label label={label}><ui.Select name={name} values={values} chosen={chosen} /></ui.Label>

# the knobs, sent to the daemon when applied
fn controlsNode(s agents.Settings):
	<ui.Card classes="controls">
		<ui.CardHeader title="Settings" description="When agents start, and what they run on." />
		<ui.CardContent>
			<form id="settings">
				{number("limit", "Agents at once", s.limit, "1")}
				{number("pace", "Pace (1 = even to the reset)", s.pace, "0.25")}
				{number("planCeiling", "Plan ceiling (0-1)", s.planCeiling, "0.01")}
				{choice("model", "Model", models, s.model)}
				{choice("effort", "Effort", efforts, s.effort)}
				{number("cpuCeiling", "CPU ceiling (0-1)", s.cpuCeiling, "0.05")}
				{number("memoryFloor", "GB kept free", s.memoryFloor, "0.5")}
				{number("agentMemory", "GB per agent (0 none)", s.agentMemory, "0.5")}
				{number("agentCpu", "CPU per agent (0-1, 0 none)", s.agentCpu, "0.05")}
				<ui.Label label="Start the board's cards on their own" inline classes="wide">
					<ui.Switch name="autoQueue" checked={s.autoQueue} />
				</ui.Label>
				<div class="wide"><ui.Button submit>Apply</ui.Button></div>
			</form>
		</ui.CardContent>
	</ui.Card>

models = ["haiku", "sonnet", "opus"]
efforts = ["low", "medium", "high", "xhigh", "max"]

fn planRow(kind str, name str, text str, state str):
	<tr class="plan">
		<td><ui.Badge variant="secondary">{kind}</ui.Badge></td>
		<td class="name">{name}</td>
		<td class="what">{text}</td>
		<td class="state">{state}</td>
		<td class="acts">
			{for pair in [("pause", "Pause"), ("resume", "Resume"), ("delete", "Delete")]:
				verb, label = pair.copy()
				<ui.Button
					variant={"destructive" if verb == "delete" else "ghost"}
					size="xs"
					attrs={[attr("data-plan", "{kind}s/{name}/{verb}")]}
				>
					{label}
				</ui.Button>
			}
		</td>
	</tr>

# the loops and the goals, and the forms that add them
fn plansNode(fleet Fleet):
	<div class="plans">
		<ui.Card>
			<ui.CardHeader title="Running" description="Loops run a prompt again and again; goals until their check passes." />
			<ui.CardContent>
				{if fleet.loops.isEmpty and fleet.goals.isEmpty:
					<p class="none">No loops or goals yet.</p>
				else:
					<ui.Table>
						<thead><tr><th>Kind</th><th>Name</th><th>What</th><th>State</th><th></th></tr></thead>
						<tbody>
							{for l in fleet.loops:
								every = "every {l.every} min" if l.every > 0 else "always on"
								planRow("loop", l.name, l.prompt, "paused" if l.paused else every)
							}
							{for g in fleet.goals:
								state = "met" if g.met else ("paused" if g.paused else "{g.checks} checks, ${g.budget:.2} budget")
								planRow("goal", g.name, g.aim, state)
							}
						</tbody>
					</ui.Table>
				}
			</ui.CardContent>
		</ui.Card>
		<ui.Card>
			<ui.CardHeader title="Add a loop" description="Minutes between runs; 0 keeps it always on." />
			<ui.CardContent>
				<form id="loop" class="spawn">
					<ui.TextField name="name" placeholder="loop name" />
					<ui.TextField name="every" kind="number" value="0" attrs={[attr("title", "minutes between runs, 0 always on")]} />
					<ui.TextField name="prompt" placeholder="what each run does" classes="grow" />
					<ui.Button submit>Add loop</ui.Button>
				</form>
			</ui.CardContent>
		</ui.Card>
		<ui.Card>
			<ui.CardHeader title="Add a goal" description="Worked on until its check exits 0, within the budget in dollars." />
			<ui.CardContent>
				<form id="goal" class="spawn">
					<ui.TextField name="name" placeholder="goal name" />
					<ui.TextField name="check" placeholder="check command (exit 0 = met)" />
					<ui.TextField name="budget" kind="number" value="5" attrs={[attr("step", "1"), attr("title", "dollars")]} />
					<ui.TextField name="aim" placeholder="the aim" classes="grow" />
					<ui.Button submit>Add goal</ui.Button>
				</form>
			</ui.CardContent>
		</ui.Card>
	</div>

fn heading(title str, lead str):
	<header class="screenhead"><h2>{title}</h2><p>{lead}</p></header>

# the agents' parts of the page, each placed by the page in its screen: the list, the loops and
# goals, the controls
fn agentsNode(fleet Fleet):
	usage = fleet.usage()
	stopped = fleet.agents.filter(.state == .Stopped)
	<>
		<div data-part="topbar">{fleet.statusNode()}</div>
		<div data-part="agentlist">
			{for a in fleet.agents.filter(.state != .Stopped): fleet.agentNode(a, usage)}
			{if fleet.agents.isEmpty: <p class="none">No agents yet: start one above.</p>}
			{if not stopped.isEmpty:
				<details>
					<summary>{"Stopped {stopped.len}"}</summary>
					{for a in stopped: fleet.agentNode(a, usage)}
				</details>
			}
		</div>
		<div data-part="plans">
			{heading("Loops and goals", "Work that comes back by itself.")}
			{fleet.plansNode()}
		</div>
		<div data-part="planbar">
			<b>Plan</b>
			{for line in fleet.planLines(): <div>{line}</div>}
		</div>
		<div data-part="controls">
			{heading("Controls", "The machine, the plan and the knobs.")}
			{fleet.settings.controlsNode()}
		</div>
	</>

# the agents' part of the page, as HTML
pub fn agentsText(fleet Fleet) str:
	fleet.agentsNode().render()

# a step of an agent, as HTML the page appends to the agent's dialog
pub fn stepText(step Step) str:
	step.stepNode().render()

# a step laid out as Claude Code's terminal shows it: a dot before what the agent says and each
# tool it calls (the tool's name, then what it asked in parentheses), the tool's output below a
# corner with its first lines and the rest folded, the user's orders after a `>`
fn stepNode(step Step):
	lines = step.text.lines()
	if step.kind == "text": return <div class="step text"><span class="mark">●</span><div>{step.text}</div></div>
	if step.kind == "you": return <div class="step you"><span class="mark">{">"}</span><div>{step.text}</div></div>
	if step.kind == "tool":
		head = lines[0][..160.min(lines[0].len)].copy() if not lines.isEmpty else ""
		return <div class="step tool"><span class="mark">●</span><div><b>{step.title}</b>{"({head})"}</div></div>
	if step.kind == "output":
		shown = lines[..3.min(len)].join("\n")
		<div class="step output">
			<span class="mark">└</span>
			{if lines.len <= 3:
				<div>{shown}</div>
			else:
				<details><summary>{"{shown}\n... +{lines.len - 3} lines"}</summary><div>{lines[3..].join("\n")}</div></details>
			}
		</div>
	else:
		<div class="step {step.kind}"><span class="mark">·</span><div>{"{step.title} {step.text}".trimmed()}</div></div>
