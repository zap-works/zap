# long: the dispatch, a line an operation
# An instruction that is no jump written as Zap: each operation's function, or a note that the
# translation (or Zap) lacks it.

pub fn emitInstr(mut e Emitter, i Instr):
	if i.op in [.Ssy, .Pbk, .Pcnt]: return   # flow.zap reads their targets
	e.openGuard(i)
	match i.op:
		Fadd: e.emitFadd(i)
		Fmul: e.emitFmul(i)
		Ffma: e.emitFfma(i)
		Fmnmx: e.emitMinMax(i, false)
		Mufu: e.emitMufu(i)
		Rro: e.emitRro(i)
		Fsetp: e.emitSetp(i, false)
		Fset: e.emitSet(i, false)
		Fcmp: e.emitFcmp(i)
		F2i: e.emitF2i(i)
		I2f: e.emitI2f(i)
		F2f: e.emitF2f(i)
		Iadd: e.emitIadd(i)
		Iadd3: e.emitIadd3(i)
		Iscadd: e.emitIscadd(i)
		Xmad: e.emitXmad(i)
		Imad: e.emitImad(i)
		Imul: e.emitImul(i)
		LeaLo, LeaHi: e.emitLea(i)
		Prmt: e.emitPrmt(i)
		Shl: e.emitShl(i)
		Shr: e.emitShr(i)
		ShfL, ShfR: e.emitShf(i)
		Lop: e.emitLop(i)
		Lop3: e.emitLop3(i)
		Bfe: e.emitBfe(i)
		Bfi: e.emitBfi(i)
		Popc: e.emitPopc(i)
		Flo: e.emitFlo(i)
		I2i: e.emitI2i(i)
		Isetp: e.emitIsetp(i)
		Iset: e.emitIset(i)
		Icmp: e.emitIcmp(i)
		Imnmx: e.emitImnmx(i)
		Sel: e.emitSel(i)
		Mov: e.emitMov(i)
		Psetp: e.emitPsetp(i)
		Pset: e.emitPset(i)
		P2r: e.emitP2r(i)
		R2p: e.emitR2p(i)
		Ald: e.emitAld(i)
		Ast: e.emitAst(i)
		Ipa: e.emitIpa(i)
		Ldc: e.emitLdc(i)
		Ldl, Stl, Lds, Sts: e.emitLoadStore(i)
		S2r: e.emitS2r(i)
		Shfl: e.emitShfl(i)
		Vote: e.emitVote(i)
		Bar: e.emitBar(i)
		Texs: e.emitTexs(i)
		Tlds: e.emitTlds(i)
		Tex: e.emitTex(i)
		Tld: e.emitTld(i)
		Txq: e.emitTxq(i)
		Nop, Membar, Depbar: pass
		Hadd2: e.emitHadd2(i)
		Hmul2: e.emitHmul2(i)
		Hfma2: e.emitHfma2(i)
		Hset2: e.emitHset2(i)
		Hsetp2: e.emitHsetp2(i)
		Dadd: e.emitDadd(i)
		Dmul: e.emitDmul(i)
		Dfma: e.emitDfma(i)
		Dmnmx: e.emitMinMax(i, true)
		Dsetp: e.emitSetp(i, true)
		Dset: e.emitSet(i, true)
		Ldg, Stg, Ld, St, Atom, AtomCas, Red: e.lack(
			i,
			"global memory (Zap has bound storage buffers, no addresses)",
			[i.rd]
		)
		Tld4: e.emitTld4(i)
		Tld4s: e.emitTld4s(i)
		Suld: e.emitSuld(i)
		Sust: e.emitSust(i)
		Suatom: e.emitSuatom(i)
		Sured: e.emitSured(i)
		SuatomCas: e.lack(i, "SUATOM.CAS (yuzu has none either)", [i.rd])
		Tmml: e.emitTmml(i)
		Txd: e.emitTxd(i)
		_: e.lack(i, "not translated", [])
	e.closeGuard(i)
