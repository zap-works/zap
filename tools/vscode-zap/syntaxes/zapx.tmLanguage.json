{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ZapX",
  "scopeName": "source.zapx",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#fragment"
    },
    {
      "include": "#closing-tag"
    },
    {
      "include": "#opening-tag"
    },
    {
      "include": "source.zap"
    }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.zapx"
    },
    "closing-tag": {
      "match": "(</)([A-Za-z][\\w.]*)(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.begin.zapx"
        },
        "2": {
          "patterns": [
            {
              "include": "#tag-name"
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.tag.end.zapx"
        }
      }
    },
    "opening-tag": {
      "begin": "(<)([A-Za-z][\\w.]*)(?=[\\s/>])",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.zapx"
        },
        "2": {
          "patterns": [
            {
              "include": "#tag-name"
            }
          ]
        }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.zapx"
        }
      },
      "patterns": [
        {
          "match": "[A-Za-z_:][\\w:.-]*",
          "name": "entity.other.attribute-name.zapx"
        },
        {
          "match": "=",
          "name": "punctuation.separator.key-value.zapx"
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.zapx"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "tag-name": {
      "patterns": [
        {
          "match": "^[A-Z][\\w.]*$",
          "name": "support.class.component.zapx"
        },
        {
          "match": "^[a-z][\\w.-]*$",
          "name": "entity.name.tag.zapx"
        }
      ]
    },
    "expression": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.zapx"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.zapx"
        }
      },
      "contentName": "meta.embedded.zap",
      "patterns": [
        {
          "include": "#expression"
        },
        {
          "include": "#fragment"
        },
        {
          "include": "#closing-tag"
        },
        {
          "include": "#opening-tag"
        },
        {
          "include": "source.zap"
        }
      ]
    },
    "fragment": {
      "match": "</?>",
      "name": "punctuation.definition.tag.fragment.zapx"
    }
  }
}
