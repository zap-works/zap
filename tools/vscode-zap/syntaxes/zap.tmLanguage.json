{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zap",
  "scopeName": "source.zap",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "expression": {
      "patterns": [
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "include": "#declaration"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#operator"
        },
        {
          "include": "#type"
        },
        {
          "include": "#call"
        },
        {
          "include": "#field"
        }
      ]
    },
    "comment": {
      "name": "comment.line.number-sign.zap",
      "match": "#.*$"
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.triple.raw.zap",
          "begin": "r\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.double.raw.zap",
          "begin": "r\"",
          "end": "\"|$"
        },
        {
          "name": "string.quoted.triple.zap",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#stringEscape"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.zap",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "#stringEscape"
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.character.zap",
          "match": "'(\\\\(?:[nrt0'\"\\\\]|x[0-9A-Fa-f]{2})|[^'\\\\])'"
        },
        {
          "name": "constant.numeric.hex.zap",
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b|\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.zap",
          "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?[eE][+-]?[0-9]+\\b|\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.zap",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "stringEscape": {
      "name": "constant.character.escape.zap",
      "match": "\\\\[nrt0\\\\\"{}]|\\\\x[0-9A-Fa-f]{2}"
    },
    "interpolation": {
      "name": "meta.interpolation.zap",
      "contentName": "meta.embedded.line.zap",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.zap"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.zap"
        }
      },
      "patterns": [
        {
          "include": "#format"
        },
        {
          "include": "#braces"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "format": {
      "name": "constant.other.format.zap",
      "match": "(?<=[\\w)\\]])[:][<>^]?[-+ ]?#?0?[0-9]*(?:\\.[0-9]+)?[A-Za-z%]?(?=\\})"
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#braces"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "parens": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#parens"
        },
        {
          "include": "$self"
        }
      ]
    },
    "declaration": {
      "patterns": [
        {
          "begin": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(<[^>()]*>)?\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "storage.type.function.zap"
            },
            "2": {
              "name": "entity.name.function.zap"
            },
            "3": {
              "patterns": [
                {
                  "include": "#type"
                }
              ]
            },
            "4": {
              "name": "punctuation.definition.parameters.begin.zap"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.parameters.end.zap"
            }
          },
          "name": "meta.function.parameters.zap",
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#parameter"
            },
            {
              "include": "#parens"
            },
            {
              "include": "$self"
            }
          ]
        },
        {
          "match": "\\b(type|bound)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.zap"
            },
            "2": {
              "name": "entity.name.type.zap"
            }
          }
        },
        {
          "match": "^\\s*(?:(pub)\\s+)?(alias)\\s+([a-z_][A-Za-z0-9_]*)(?=\\s*=)",
          "captures": {
            "1": {
              "name": "storage.modifier.zap"
            },
            "2": {
              "name": "storage.type.alias.zap"
            },
            "3": {
              "name": "entity.name.variable.zap"
            }
          }
        },
        {
          "match": "^(parts)\\s+([^#]*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.zap"
            },
            "2": {
              "patterns": [
                {
                  "match": "[a-z_][A-Za-z0-9_]*",
                  "name": "entity.name.namespace.zap"
                }
              ]
            }
          }
        },
        {
          "match": "\\b(import)\\s+([a-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)(?:\\s+(as)\\s+([a-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": {
              "name": "keyword.control.import.zap"
            },
            "2": {
              "name": "entity.name.namespace.zap"
            },
            "3": {
              "name": "keyword.control.import.zap"
            },
            "4": {
              "name": "entity.name.namespace.zap"
            }
          }
        },
        {
          "match": "^\\s*(from)\\s+([a-z_][A-Za-z0-9_]*)\\s+(import)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.import.zap"
            },
            "2": {
              "name": "entity.name.namespace.zap"
            },
            "3": {
              "name": "keyword.control.import.zap"
            }
          }
        }
      ]
    },
    "parameter": {
      "match": "(?:^|(?<=[(,]))\\s*(?:(mut|move)\\s+)?([a-z_][A-Za-z0-9_]*)(?=\\s+[^\\s=,)]|\\s*[,)])",
      "captures": {
        "1": {
          "name": "storage.modifier.zap"
        },
        "2": {
          "name": "variable.parameter.zap"
        }
      }
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.zap",
          "match": "\\b(if|else|elif|match|while|for|in|loop|break|continue|return|try|yield|is)\\b"
        },
        {
          "name": "keyword.operator.logical.zap",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "storage.type.zap",
          "match": "\\b(fn|type|extern)\\b"
        },
        {
          "name": "storage.modifier.zap",
          "match": "\\b(mut|move|ref|pub|shared)\\b|(?<=[(,]\\s|[(,])out\\b(?=\\s+[a-z_])"
        },
        {
          "name": "constant.language.zap",
          "match": "\\b(true|false|none|pi|tau)\\b"
        },
        {
          "name": "variable.language.zap",
          "match": "\\b(self|it)\\b|(?<=\\[|\\.\\.)len\\b"
        },
        {
          "name": "keyword.other.zap",
          "match": "^\\s*(test)(?=\\s+\")|^\\s*(expect|prints|use|arena|bound)\\b|\\b(pass)\\b(?=\\s*(#.*)?$)|^\\s*(refuses|stops)\\b(?=\\s+[A-Z])|(?<=\")\\s+(refuses|stops)\\b|\\b(step)\\b(?=\\s*[A-Za-z0-9_(])|\\b(loaded)\\b(?=\\s+fn)"
        }
      ]
    },
    "operator": {
      "name": "keyword.operator.zap",
      "match": "\\?\\?|\\?\\.|\\.\\.=?|\\*\\*|==|!=|<=|>=|[-+*/%]=?|&|\\|"
    },
    "type": {
      "patterns": [
        {
          "name": "support.type.primitive.zap",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|n32|n64|bool|str)\\b"
        },
        {
          "name": "entity.name.type.zap",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "call": {
      "patterns": [
        {
          "name": "entity.name.function.member.zap",
          "match": "(?<=\\.)[a-z_][A-Za-z0-9_]*(?=(<[^<>()]*>)?\\()|(?<=\\.)[a-z_][A-Za-z0-9_]*(?=\\s+\\()"
        },
        {
          "name": "entity.name.function.zap",
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=(<[^<>()]*>)?\\()|\\b[a-z_][A-Za-z0-9_]*(?=\\s+\\()"
        }
      ]
    },
    "field": {
      "name": "variable.other.property.zap",
      "match": "(?<=[A-Za-z0-9_)\\]?]\\.)[a-z_][A-Za-z0-9_]*|(?<=[\\s(\\[,{:]\\.)[a-z_][A-Za-z0-9_]*"
    }
  }
}
