# The CPU's side of the shader tests' textures, as the engine has them: their ids.

pub type Texture:
	id i64

pub type TextureArray:
	id i64

pub type ShadowMap:
	id i64

pub type ShadowMapArray:
	id i64

pub type IntTexture:
	id i64

pub type UintTexture:
	id i64

pub type Texture3D:
	id i64

pub type TextureCube:
	id i64

pub type TextureCubeArray:
	id i64
